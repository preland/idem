# The FPS's art. Enemies are billboards -- a sprite that always faces the
# camera, depth-tested against the world so it is correctly hidden behind a wall
# -- which is how a software renderer with no textures still gets a convincing
# opponent.

palette foe {
  . clear
  k 0x1B1B1F
  r 0x7A2222
  g 0x3C8C46
  w 0xD8E0D0
  b 0x2E3A46
}

palette fire {
  . clear
  k 0x2A2A2A
  y 0xFFE066
  o 0xFF9A2E
  W 0xFFFFFF
  g 0x3C8C46
}

palette ink {
  . clear
  w 0xFFFFFF
}

