// The ball: it moves, it bounces, and it scores.
//
// Nothing moves until the first press, which is what `wait` is for -- a game that
// starts the instant it is opened has already scored a point before anybody has
// looked at it.

g_ball(int dt) {
  if ((import g_st)[10] = 0) {
    g_fly(dt);
  }
  g_serve();
} return void;
given g_init (16):() then calls g_fly:[0] then calls g_serve:[1]
given g_init given g_press (40):() then calls g_fly:(40) then calls g_serve:[1]

g_fly(int dt) {
  lset((import g_st), 4, (import g_st)[4] + (import g_st)[6] * dt / 1000);
  lset((import g_st), 5, (import g_st)[5] + (import g_st)[7] * dt / 1000);
  g_bounce();
} return void;
given g_init (16):() then g_t_st:([100000, 0, 100000, 0, 162400, 101520, 150000, 95000, 0, 0, 1]) then calls g_bounce:[1]
given g_init (500):() then g_t_st:([100000, 0, 100000, 0, 235000, 147500, 150000, 95000, 0, 0, 1]) then calls g_bounce:[1]

// The top and bottom walls, then the paddles. The vertical test checks the
// *direction* as well as the position: a ball resting against the ceiling for
// three frames would otherwise reverse three times and shiver there.
g_bounce() {
  g_wall();
  g_hit(14000, 0);
  g_hit(306000, 2);
} return void;
given g_init ():() then calls g_wall:() then calls g_hit:(14000, 0) then calls g_hit:(306000, 2)
given g_t_topwall ():() then g_t_st:([100000, 0, 100000, 0, 160000, 2000, 150000, 50000, 0, 0, 1])
