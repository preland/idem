// The two seams idml reaches the game through.
//
// `@name` in the layout reads g_ref(name); a bare identifier as an item's
// argument calls g_act(name). Both are string compares against names the game
// itself chose -- there is no dynamic dispatch in `id`, and none is wanted.

g_ref(string name) {
  int v = 0;
  if (name = "lscore") { v = (import g_st)[8]; }
  else { v = g_ref2(name); }
} return int v;
given g_init ("lscore"):(0) then calls g_ref2:[0]
given g_init ("rscore"):(0) then calls g_ref2:("rscore")

g_ref2(string name) {
  int v = 0;
  if (name = "rscore") { v = (import g_st)[9]; }
  else if (name = "waiting") { v = (import g_st)[10]; }
} return int v;
given g_init ("rscore"):(0)
given g_init ("waiting"):(1)

// One action, one meaning. A game with more would chain these the way g_ref
// does; a game with none would still define it, because the engine calls it.
g_act(string name) {
  if (name = "press") {
    g_press();
  }
} return void;
given g_init ("press"):() then calls g_press:[1] then g_t_st:([100000, 0, 100000, 0, 160000, 100000, 150000, 95000, 0, 0, 0])
given g_init ("other"):() then calls g_press:[0] then g_t_st:([100000, 0, 100000, 0, 160000, 100000, 150000, 95000, 0, 0, 1])
