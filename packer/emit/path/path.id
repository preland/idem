// path -- the header every generated file carries, and the directory it lives in.

// Said in every generated file, because someone will eventually open one looking
// for a bug and the worst thing they could do is fix it there.
pack_head() {
  print("// GENERATED by packer/ from this game's .idml sources -- do not edit.");
  print("// Every change here is lost on the next `tools/idem pack <gamedir>`.");
} return void;

// The `n/n/n/` prefix of the file holding chunk group `k` -- k levels deep, so
// each directory on the chain holds one .id file and one subdirectory.
//
// This is two characters per level and could obviously be a `+` in a loop. It is
// not, for the same reason nothing else in this program is: concatenation in this
// language allocates and never frees, and a habit that is harmless at ten levels
// is the habit that costs 1.8 GB at two hundred thousand characters. One alloc,
// one str_of_mem, no exceptions.
pack_path(int k) {
  word ad = alloc(2 * k + 1);
  pack_ns(ad, 2 * k);
  string ret_s = str_of_mem(ad, 2 * k);
} return string ret_s;

pack_ns(word ad, int n) {
  int i = 0;
  while (i < n) {
    poke8(ad + i, 110);
    poke8(ad + i + 1, 47);
    i = i + 2;
  }
} return void;
