t_lst_show(int[] xs) {
  lst_set_all(xs, 3, 1);
  print("fill 11199 = " + xs[0] + xs[1] + xs[2] + xs[3] + xs[4]);
  t_err_show(xs);
} return void;

t_err_show(int[] xs) {
  int lget_v = lget(xs, 4);
  int len_v = len(xs);
  print("lget 9 = " + lget_v + " len 5 = " + len_v);
  err_report("fake.idml", 7, "a reported error is counted");
  int err_count_v = err_count();
  print("errs 1 = " + err_count_v);
} return void;
