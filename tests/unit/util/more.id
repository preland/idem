t_lst_show(int[] xs) {
  lst_set_all(xs, 3, 1);
  print("fill 11199 = " + xs[0] + xs[1] + xs[2] + xs[3] + xs[4]);
  t_err_show(xs);
} return void;

t_err_show(int[] xs) {
  string line = "lget 9 = " + lget(xs, 4) + " len 5 = " + len(xs);
  print(line);
  t_err_report();
} return void;

t_err_report() {
  err_report("fake.idml", 7, "a reported error is counted");
  string line = "errs 1 = " + err_count();
  print(line);
} return void;
