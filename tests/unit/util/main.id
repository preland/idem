// Unit tests for engine/core/util. Each check prints an expected/actual line;
// tools/test.sh diffs the whole output against a golden file, so a regression is
// a one-line diff rather than a judgement call.

main(int argc, string[] argv) {
  err_init();
  t_str();
  t_lst();
  int ret_i = err_count();
} return int ret_i;

t_str() {
  string s = "sprite bird-up(17, 12)";
  string str_slice_v = str_slice(s, 7, 7);
  print("slice bird-up = " + str_slice_v);
  int str_eqat_v = str_eqat(s, 0, "sprite");
  int str_eqat_v2 = str_eqat(s, 0, "model");
  int str_eqat_v3 = str_eqat(s, 7, "bird");
  print("eqat 1,0,1 = " + str_eqat_v + str_eqat_v2 + str_eqat_v3);
} return void;

t_lst() {
  int[] xs = [];
  lst_fill(xs, 5, 9);
  t_lst_show(xs);
} return void;
