// Unit tests for engine/core/rt. Each check prints an expected/actual line;
// tools/test.sh diffs the whole output against a golden file, so a regression is
// a one-line diff rather than a judgement call.

main(int argc, string[] argv) {
  t_run();
  int ret_i = err_count();
} return int ret_i;

t_str() {
  string s = "sprite bird-up(17, 12)";
  t_str_slice(s);
  t_str_eqat(s);
} return void;

t_lst() {
  int[] xs = [];
  lst_fill(xs, 5, 9);
  t_lst_show(xs);
} return void;
