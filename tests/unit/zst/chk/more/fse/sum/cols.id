// Column sums over a whole table.

t_fsum(int base, int n) {
  int a = t_fcol((import fse_sy), base, n);
  t_fsum2(a, base, n);
} return void;
given zst_fse_ready (0, 64):() then calls t_fcol:[3]
given zst_fse_ready (0, 64):() then calls t_fsum2:[1]

t_fshow(int a, int b, int c) {
  print("    sums sym " + a + " nb " + b + " base " + c);
} return void;
(965, 324, 864):() then prints:("    sums sym 965 nb 324 base 864\n")
(1, 2, 3):() then prints:("    sums sym 1 nb 2 base 3\n")

t_fcol(int[] xs, int base, int n) {
  int v = 0;
  int i = 0;
  while (i < n) {
    v = v + xs[base + i];
    i = i + 1;
  }
} return int v;
([1, 2, 3, 4], 0, 2):(3)
([1, 2, 3, 4], 1, 2):(5)
