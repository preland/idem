// A 4-byte buffer holding 0x8C (1000 1100) -- the known byte chk/bits/reader.id
// reasons about -- so a case can drive the bit reader without alloc()'s
// address (unknown ahead of time) as a case literal.
zst_buf_ready() {
  zst_ready();
  export word zst_buf = alloc(4);
  poke8(zst_buf, 140);
} return void;
():() then calls zst_ready:[1]
given zst_surf_ready ():() then calls zst_ready:[1]
