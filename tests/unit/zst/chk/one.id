// Decompressing one fixture and hashing the result.

// Two frames back to back, and a skippable frame in front of a real one -- both
// shapes showroom.blend actually has (36 frames, one of them skippable), and both
// testable with only the frame layer built.
t_more() {
  t_one("two   two frames, exp 128 bytes hash 1687148429", "tests/unit/zst/img/two.zst", 128);
  t_one("skip  skippable frame first, exp 64 bytes hash 2246337607", "tests/unit/zst/img/skip.zst", 64);
  t_todo();
} return void;

// Both the returned value and the bytes actually written are reported, and for
// the two sequence fixtures they disagree in a way that is worth spelling out.
//
// The hashes match the reference **by accident**. The match-length symbol decodes
// to code 46 (base 1027) where the stream means code 44 (base 259), so the final
// match copy runs far past the end; zst_put refuses to write past the caller's
// capacity, sets the fault, and stops -- at exactly the right byte. For a run of
// one repeated character, and for a text file whose last match happens to reach
// the end, clipping an over-long copy produces the correct output.
//
// So a matching hash here is NOT evidence the decoder works, and the -1 is the
// honest answer. This is why the fault must never be suppressed at end of stream.
t_one(string msg, string path, int n) {
  int got = t_dec(path, n);
  word t_hash_v = t_hash((import zst_st)[4]);
  t_show(msg, got, t_hash_v);
} return void;

// The output buffer is sized from what the fixture is known to decompress to, not
// from what the frame claims -- a decoder that trusts the frame's own size field
// cannot be tested against a frame that lies about it.
t_dec(string path, int n) {
  int slen = asset_slurp(path);
  int fx_max_v = fx_max(n, 1);
  int da = alloc(fx_max_v);
  int ret_i = zst_run((import asset_io)[0], slen, da, n);
} return int ret_i;
