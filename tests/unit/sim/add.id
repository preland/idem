// Test-only fixtures: main.id's own init order (fx_trig_init, ent_init,
// scn_init -- sim_grav reads the scene's gravity, an export that does not
// exist until scn_init has run), then the first entity, at its defaults.
sim_ready() {
  fx_trig_init();
  ent_init();
  scn_init();
} return void;
