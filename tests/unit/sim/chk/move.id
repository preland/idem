// Integration, at sixty frames a second.
//
// A dt of 16 ms is 1000/60 floored, which is what the engine uses: a fixed step
// from the declared frame rate rather than a measured one, so a run is
// reproducible and a `--shot 30` is comparable between builds.
//
// -120 stage units per second is -120000 millunits per second, and one 16 ms step
// of it is -1920 millunits -- a little under two whole units. Two whole units per
// frame is what an integer store would have given, and 24 units per second would
// have given zero forever; that is the entire argument for millunits.

t_move() {
  ent_put(0, 2, 0 - 120000);
  sim_move(0, 16);
  t_move2();
} return void;
given sim_e1_ready ():() then calls sim_move:(0, 16)
given sim_e1_ready ():() then calls t_move2:[1]

t_move2() {
  int ent_at_v = ent_at(0, 0);
  print("x after one 16ms step at -120/s exp -1920 = " + ent_at_v);
  t_grav();
} return void;
given sim_move_ready ():() then calls ent_at:(0, 0)
given sim_move_ready ():() then prints:("x after one 16ms step at -120/s exp -1920 = -1920\ndynamic body: vy after 16ms of 1500/s^2 exp 24000 = 24000\nsolid body: vy unchanged exp 24000 = 24000\npast the left bound: x exp 432000 = 432000\ninside it: x unchanged exp -143000 = -143000\nframes at 0, 120, 240, 360 ms exp 0 1 2 0 = 0 1 2 0\nno anim: frame held exp 5 = 5\n")

// Entity 1, at its defaults, alongside entity 0 -- the state the real chain
// is in by the time anything past t_two runs: sim_move and friends read the
// whole store, not just entity 0, and trap on a one-entity store.
sim_e1_ready() {
  sim_e0_ready();
  ent_add();
} return void;
():() then calls sim_e0_ready:[1]
():() then calls ent_add:[2]
