// A solid body does not fall, and one with no body never started.

t_grav4() {
  int ent_at_v = ent_at(1, 3);
  print("solid body: vy unchanged exp 24000 = " + ent_at_v);
  t_wrap();
} return void;
given sim_solid_ready ():() then calls ent_at:(1, 3)
given sim_solid_ready ():() then prints:("solid body: vy unchanged exp 24000 = 24000\npast the left bound: x exp 432000 = 432000\ninside it: x unchanged exp -143000 = -143000\nframes at 0, 120, 240, 360 ms exp 0 1 2 0 = 0 1 2 0\nno anim: frame held exp 5 = 5\n")

// Entity 0, wrapped once from past the left bound (see t_wrap2 in ../w/wrap.id).
sim_wrap_past_ready() {
  sim_wrap_ready();
  ent_put(0, 0, 0 - 145000);
  sim_wrap(0);
} return void;
():() then calls sim_wrap_ready:[1]
():() then calls sim_wrap:(0)

// Entity 0, inside the wrap bound (see t_wrap3 in ../w/in.id).
sim_wrap_in_ready() {
  sim_wrap_ready();
  ent_put(0, 0, 0 - 143000);
  sim_wrap(0);
} return void;
():() then calls sim_wrap_ready:[1]
():() then calls sim_wrap:(0)
