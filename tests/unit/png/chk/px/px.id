// A scatter of pixels, and a checksum of all of them.
//
// (0,0) is the case worth naming: it is fully transparent, and its colour is
// 250 249 252 rather than black. A decoder that zeroed the colour of transparent
// pixels, or that skipped filtering where alpha is 0, would pass a "looks right"
// inspection and fail here.

t_px() {
  t_one("(0,0) transparent but not black, exp 250 249 252 0", 0, 0);
  t_one("(1280,1280) centre of the sheet, exp 238 233 205 255", 1280, 1280);
  t_sum();
} return void;

t_one(string msg, int x, int y) {
  int p = asset_row(y) + 1 + x * 4;
  word peek8_v = peek8(p);
  t_one2(msg, p, peek8_v);
} return void;

// FNV-1a over every decoded byte, in a word because the offset basis does not fit
// an int and the product needs 56 bits before it is masked back to 32. One number
// that changes if any pixel does.
t_sum() {
  word wp = t_hash(0, 2166136261);
  print("FNV-1a of all 26214400 pixel bytes, exp 1931241712 = " + wp);
  t_lace();
} return void;
