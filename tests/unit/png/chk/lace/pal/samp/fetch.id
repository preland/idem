// The rest of t_pal and t_pal2, split to stay under the per-block action
// limit: the header line, the shared row/sample fetch, and the first pair of
// the five spot-checked samples.

t_pal_h() {
  print("  w/h/depth/colour/channels exp 17 36 4 3 1 = " + (import png_st)[0] + " " + (import png_st)[1] + " " + (import png_st)[2] + " " + (import png_st)[3] + " " + (import png_st)[4]);
  t_pal2();
} return void;
given png_bird_ready ():() then prints:("  w/h/depth/colour/channels exp 17 36 4 3 1 = 17 36 4 3 1\n  bpp/stride/palette/trns exp 1 10 5 1 = 1 10 5 1\n  samples at (0,0)(8,6)(3,12)(10,20)(16,35) exp 0 2 0 3 0 = 0 2 0 3 0\n  those colours exp 0 16245020 0 16777215 0 (0xf7e11c, 0xffffff) = 0 16245020 0 16777215 0\n  those alphas exp 0 255 0 255 0 = 0 255 0 255 0\ndigits.png exp 1 = 1\n  w/h/depth/colour/stride exp 4 60 1 0 2 = 4 60 1 0 2\n  rows 0..2 exp 1111 1001 1001 = 1111 1001 1001\n  every sample, hash exp 680646057 = 680646057\n  bird.png every sample, hash exp 880280616 = 880280616\n")
given png_bird_ready ():() then calls t_pal2:[1]

t_pal_s(int row, int col) {
  int asset_row_v = asset_row(row);
  int png_samp_v = png_samp(asset_row_v, col);
} return int png_samp_v;
given png_bird_ready (0, 0):(0)
given png_bird_ready (6, 8):(2)

t_pal2b(int png_samp_v) {
  int png_samp_v2 = t_pal_s(6, 8);
  int png_samp_v3 = t_pal_s(12, 3);
  t_pal2c(png_samp_v, png_samp_v2, png_samp_v3);
} return void;
given png_bird_ready (1):() then calls t_pal_s:(6, 8)
given png_bird_ready (1):() then calls t_pal2c:(1, 2, 0)
