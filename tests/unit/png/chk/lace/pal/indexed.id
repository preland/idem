// Indexed and sub-byte PNGs -- the forms every pixel-art tool writes.
//
// Both fixtures are the game's own art rather than something built for the test:
// bird.png is 4-bit indexed with a tRNS chunk, digits.png is 1-bit grey. Refusing
// these is what made flappy render an empty sky, and a 16-colour sprite carrying
// three bytes a pixel is not what any artist exports.
//
// Every expected value came out of python3 -- zlib for the stream, a hand-written
// unfilter and bit unpack for the samples -- and not out of this decoder. The
// hash is over every sample of the image, so it fails on a wrong stride, a wrong
// bit order, a wrong filter stride or a single misplaced pixel; the spot checks
// are there to say *which* when it does.

t_pal() {
  int png_load_v = png_load("games/flappy/art/bird.png");
  print("bird.png exp 1 = " + png_load_v);
  t_pal_h();
} return void;

// Filter stride 1 because a 4-bit pixel is smaller than a byte; row stride 10
// because 17 four-bit samples are 8.5 bytes rounded up, plus the filter byte.
// Five palette entries and one tRNS alpha -- the chunk stops after its last
// non-opaque entry, so index 0 is the transparent one and 1..4 are opaque.
t_pal2() {
  print("  bpp/stride/palette/trns exp 1 10 5 1 = " + (import png_st)[11] + " " + (import png_st)[8] + " " + (import png_st)[13] + " " + (import png_st)[15]);
  int png_samp_v = t_pal_s(0, 0);
  t_pal2b(png_samp_v);
} return void;

t_pal3() {
  int png_pcol_v = png_pcol(0);
  int png_pcol_v2 = png_pcol(2);
  t_pal3b(png_pcol_v, png_pcol_v2);
} return void;
