// The rest of t_pal3's palette colour checks, split to stay under the
// per-block action limit.

t_pal3b(int png_pcol_v, int png_pcol_v2) {
  int png_pcol_v3 = png_pcol(0);
  int png_pcol_v4 = png_pcol(3);
  t_pal3c(png_pcol_v, png_pcol_v2, png_pcol_v3, png_pcol_v4);
} return void;
given png_bird_ready (1, 2):() then calls png_pcol:(0)
given png_bird_ready (1, 2):() then calls t_pal3c:(1, 2, 0, 16777215)

t_pal3c(int png_pcol_v, int png_pcol_v2, int png_pcol_v3, int png_pcol_v4) {
  int png_pcol_v5 = png_pcol(0);
  print("  those colours exp 0 16245020 0 16777215 0 (0xf7e11c, 0xffffff) = " + png_pcol_v + " " + png_pcol_v2 + " " + png_pcol_v3 + " " + png_pcol_v4 + " " + png_pcol_v5);
  t_pal3d();
} return void;
