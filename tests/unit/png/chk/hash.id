given png_rgba_ready (0, 2166136261):(2863480400) then calls t_row:[2]

t_row(int r, int i, word wp) {
  while (i < (import png_st)[0] * 4) {
    wp = ((wp ^ peek8(r + i)) * 16777619) & 4294967295;
    i = i + 1;
  }
} return word wp;
