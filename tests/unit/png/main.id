// Unit tests for engine/game/load/asset/png -- the engine reading a PNG itself.
//
// The expected values were produced independently, by python3's zlib and a
// hand-written PNG walk, and are printed in each label. A decoder that agrees
// with another implementation on the dimensions, on a scatter of pixels and on a
// checksum of every byte is a decoder that works; agreeing on the header alone
// would prove only that the header was read.
//
// The file is the real 2560x2560 RGBA sheet in test_assets, not a fixture: 3.1 MB
// of dynamic-Huffman DEFLATE with every filter type in it is a far better test
// than anything worth hand-building, and it is the asset that has to work.

main(int argc, string[] argv) {
  fx_trig_init();
  png_init();
  t_load();
} return int 0;

t_load() {
  inf_init();
  print("load spryte-run.png exp 1 = " + png_load("test_assets/spryte-run.png"));
  t_head();
} return void;

t_head() {
  print("size exp 2560 2560 = " + (import png_st)[0] + " " + (import png_st)[1]);
  print("depth/colour/channels exp 8 6 4 = " + (import png_st)[2] + " " + (import png_st)[3] + " " + (import png_st)[4]);
  t_px();
} return void;
