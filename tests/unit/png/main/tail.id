// The rest of t_load, split to stay under the per-block action limit.

t_load_p(int png_load_v) {
  print("load spryte-run.png exp 1 = " + png_load_v);
  t_head();
} return void;

// Test-only fixture: main.id's own init order, minus the load itself --
// every case below t_pal in this project uses a small asset it loads on its
// own, and deliberately does not touch the 2560x2560 sheet main.id loads: a
// case is capped at 1 GiB (idc/README.md, "Memory ceiling"), and even a
// single decode of that file segfaults a case, confirmed by probing it
// directly. main/t_load/t_load_p/t_head/t_px/t_one/t_one2/t_one3/t_sum and
// t_lace/t_lace_p/t_again (which reloads the same file after the interlace
// refusal) are skipped for that reason.
png_ready() {
  fx_trig_init();
  png_init();
} return void;
():() then calls fx_trig_init:[1]
():() then calls png_init:[1]
