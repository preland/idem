// One row of the checksum, and one pixel.

t_row(int ra, int i, word wp) {
  while (i < (import png_st)[0] * 3) {
    wp = ((wp ^ peek8(ra + i)) * 16777619) & 4294967295;
    i = i + 1;
  }
} return word wp;
