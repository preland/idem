// The last pixel and the checksum.
//
// FNV-1a over every decoded byte, in a word because the offset basis does not fit
// an int and the product needs 56 bits before it is masked back to 32. One number
// that changes if any pixel does.

t_tail(int w, int h) {
  t_at("  (last)", w - 1, h - 1);
  t_sum();
} return void;
given jpg_grad_ready (24, 16):() then calls t_at:("  (last)", 23, 15)
given jpg_grad_ready (24, 16):() then calls t_sum:[1]

t_sum() {
  word wp = t_hash(0, 2166136261);
  print("  FNV-1a of all pixels = " + wp);
} return void;
