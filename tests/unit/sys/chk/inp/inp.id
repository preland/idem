// The key-state machine, driven by the codes the backend really sends.
//
// 87 is 'W'. 258 is the up arrow -- a key that produces no character and was
// therefore invisible to `id` entirely until the seam grew a second code range.
// 83 is 'S', never pressed, and is here so that "everything reads as down" would
// be caught.
//
// A press sets the held flag and stamps the frame ordinal; the ordinal is what
// makes "pressed this frame" exact, where comparing timestamps could not tell two
// frames inside one millisecond apart.

t_keys() {
  inp_init();
  inp_stamp(87);
  t_keys2();
} return void;

t_keys2() {
  inp_stamp(258);
  int inp_down_v = inp_down(87);
  int inp_hit_v = inp_hit(87);
  int inp_down_v2 = inp_down(258);
  int inp_hit_v2 = inp_hit(258);
  int inp_down_v3 = inp_down(83);
  int inp_hit_v3 = inp_hit(83);
  print("frame 0, W and UP pressed: exp W 1 1, UP 1 1, S 0 0 = " + inp_down_v + " " + inp_hit_v + " " + inp_down_v2 + " " + inp_hit_v2 + " " + inp_down_v3 + " " + inp_hit_v3);
  t_frame();
} return void;

// The frame boundary, spelled out: inp_drain bumps this ordinal before it stamps
// anything, so a press belongs to the frame that is about to run. Auto-repeat is
// filtered by the backend, so a key held across the boundary sends nothing and
// must still read as down -- which is the whole point of tracking releases.
t_frame() {
  lset((import inp_st), 0, (import inp_st)[0] + 1);
  int inp_down_v = inp_down(87);
  int inp_hit_v = inp_hit(87);
  print("frame 1, nothing sent, W still held: exp down 1 hit 0 = " + inp_down_v + " " + inp_hit_v);
  t_rel();
} return void;
