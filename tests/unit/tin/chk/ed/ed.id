// Typing, and moving the caret into the middle of what was typed.

t_boot() {
  tin_init();
  string tin_text_v = tin_text();
  int tin_caret_v = tin_caret();
  print("empty field exp '' caret 0 = '" + tin_text_v + "' " + tin_caret_v);
  t_type1();
} return void;

t_type1() {
  t_type("abc", 0, 1000);
  string tin_text_v = tin_text();
  int tin_caret_v = tin_caret();
  print("typed abc exp abc caret 3 = " + tin_text_v + " " + tin_caret_v);
  t_move();
} return void;

// 256 is Left. Two of them from the end of a 3-character buffer leave the caret
// between 'a' and 'b', which is where the next character has to land.
t_move() {
  t_tap(256, 2000);
  t_tap(256, 2100);
  t_ins();
} return void;
