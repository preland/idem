t_quiet_show() {
  int tin_act_v = tin_act();
  print("a frame with no keys exp act 0 = " + tin_act_v);
} return void;
given tin_quiet_ready ():() then prints:("a frame with no keys exp act 0 = 0\n")
given tin_quiet_ready ():() then calls tin_act:[1]

t_rep2_show() {
  string tin_text_v = tin_text();
  print("backspace pressed at 5000 exp 12345678 = " + tin_text_v);
} return void;
given tin_rep_ready ():() then prints:("backspace pressed at 5000 exp 12345678 = 12345678\n")
given tin_rep_ready ():() then calls tin_text:[1]

tin_rep7_ready() {
  tin_rep6_ready();
  t_up(8, 5600);
  t_hold(9000);
} return void;
():() then calls tin_rep6_ready:[1]
():() then calls t_hold:(9000)
