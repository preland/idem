t_rep6_show() {
  string tin_text_v = tin_text();
  print("second repeat exp 123456 = " + tin_text_v);
} return void;
given tin_rep6_ready ():() then prints:("second repeat exp 123456 = 123456\n")
given tin_rep6_ready ():() then calls tin_text:[1]

