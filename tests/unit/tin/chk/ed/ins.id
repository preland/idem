// Insert, and the two deletes that differ only in which side of the caret they
// take from.

// 88 is 'X'. Inserting at a caret in the middle is the case that separates a
// real buffer from an append-only one, and the caret has to end up *after* the
// character or the next one lands in front of it.
t_ins() {
  t_tap(88, 2200);
  print("X at caret 1 exp aXbc caret 2 = " + tin_text() + " " + tin_caret());
  t_bs();
} return void;

// 8 is Backspace: it takes the character before the caret and moves the caret
// back with it.
t_bs() {
  t_tap(8, 2300);
  print("backspace exp abc caret 1 = " + tin_text() + " " + tin_caret());
  t_del();
} return void;

// 265 is Delete: it takes the character *at* the caret and leaves the caret
// where it was. Same operation, same guard, one index apart -- which is why
// tin_del takes an index rather than a direction.
t_del() {
  t_tap(265, 2400);
  print("delete exp ac caret 1 = " + tin_text() + " " + tin_caret());
  t_home();
} return void;
