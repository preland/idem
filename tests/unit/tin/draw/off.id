// Scrolling, and the promise that a field never draws outside itself.

// Twenty characters at 8 pixels each is 160, and the field's inside is 56 wide,
// so the text has to be shifted left by exactly enough to leave the caret at the
// right-hand edge: (20 + 1) * 8 - 56 = 112. The +1 is the caret's own cell,
// which is why the last character typed is fully visible rather than half under
// the edge.
//
// Then the field is drawn at (4, 4) into a 160x32 surface and every pixel
// OUTSIDE it is counted. That number is 0 by construction and by construction
// only: nothing in tin_draw computes where the glyphs end, it just narrows the
// clip and lets 160 pixels of text run into a 56-pixel box. This is the check
// that the clip is what stops them.
t_draw4() {
  print("20 characters in a 56-pixel field: tin_off exp 112 = " + tin_off(56));
  sf_clear(0);
  t_draw5();
} return void;

t_draw5() {
  tin_draw(4, 4, 64, 24, 16777215, 5490);
  print("ink outside the field exp 0 = " + (t_ink(0, 0, 160, 4) + t_ink(0, 28, 160, 4) + t_ink(0, 4, 4, 24) + t_ink(68, 4, 92, 24)));
} return void;

// White pixels in a rect. sf_pget answers 0 outside the surface, so a rect that
// runs off the edge counts nothing rather than aborting -- which is what lets
// the four bands above be written as the four bands rather than as four clamped
// ones.
t_ink(int x, int y, int w, int h) {
  int n = 0;
  int i = 0;
  while (i < w * h) {
    n = n + (sf_pget(x + i % w, y + i / w) = 16777215);
    i = i + 1;
  }
} return int n;
