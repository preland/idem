// The two ways a load fails, and the promise that failing changes nothing.
//
// That promise is the point of these two. A font that cannot be read has to
// leave the program with readable text, because the first thing a program does
// when something goes wrong is try to say so on screen -- and a decoder that
// half-adopted a face before noticing it was corrupt would take the diagnostic
// down with it.

// A file that is not there. fs_size answers -1, so nothing is read at all and
// psf_head sees a zero-length file.
t_bad() {
  int psf_load_v = psf_load("test_assets/no-such-font.psf");
  print("psf_load of a missing file exp 0 = " + psf_load_v);
  int txt_facen_v = txt_facen();
  int txt_cellh_v = txt_cellh();
  word t_hash_v = t_hash(0, txt_facen_v * txt_cellh_v, 2166136261);
  print("  face untouched, hash still 485156385 = " + t_hash_v);
  t_bad2();
} return void;

// A file that is there and is not a font. tools/mkfont.sh starts with '#!', so
// it fails both magics -- and it is a file this repository is guaranteed to
// have, which a purpose-built fixture would not be any better at proving.
t_bad2() {
  int psf_load_v = psf_load("tools/mkfont.sh");
  print("psf_load of a non-font file exp 0 = " + psf_load_v);
  int txt_facen_v = txt_facen();
  int txt_cellh_v = txt_cellh();
  word t_hash_v = t_hash(0, txt_facen_v * txt_cellh_v, 2166136261);
  print("  face untouched, hash still 485156385 = " + t_hash_v);
  int txt_cell_v = txt_cell();
  int txt_cellh_v2 = txt_cellh();
  int txt_bit_v = txt_bit();
  int txt_facen_v2 = txt_facen();
  print("  metrics untouched exp 8 16 8 224 = " + txt_cell_v + " " + txt_cellh_v2 + " " + txt_bit_v + " " + txt_facen_v2);
} return void;
