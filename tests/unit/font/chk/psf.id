// Loading both header formats.

// PSF2. The same face the built-in table came from, so the ASCII rows must not
// move -- and 129 more code points arrive with it, which is what the count
// changing from 95 to 224 says.
t_psf2() {
  int psf_load_v = psf_load("test_assets/vga8x16.psf");
  print("psf_load vga8x16.psf (PSF2) exp 1 = " + psf_load_v);
  int txt_cell_v = txt_cell();
  int txt_cellh_v = txt_cellh();
  int txt_bit_v = txt_bit();
  int txt_facen_v = txt_facen();
  int txt_last_v = txt_last();
  print("  metrics exp w 8 h 16 bits 8 glyphs 224, last 255 = " + txt_cell_v + " " + txt_cellh_v + " " + txt_bit_v + " " + txt_facen_v + " " + txt_last_v);
  t_rows();
} return void;

// 219 is the full block: sixteen rows of 255, and the strongest single check
// that the copy did not shift by a byte -- one row out of place and the block
// grows a hole. 176 is the light shade, 00010001 / 01000100 alternating, which
// would survive a byte shift and not a mirror.
t_rows() {
  int txt_glyph_at_v = txt_glyph_at(65);
  int txt_glyphs_v = (import txt_glyphs)[txt_glyph_at_v + 2];
  int txt_glyph_at_v2 = txt_glyph_at(65);
  int txt_glyphs_v2 = (import txt_glyphs)[txt_glyph_at_v2 + 3];
  int txt_glyph_at_v3 = txt_glyph_at(65);
  print("  'A' rows 2,3,7 unchanged, exp 16 56 254 = " + txt_glyphs_v + " " + txt_glyphs_v2 + " " + (import txt_glyphs)[txt_glyph_at_v3 + 7]);
  int txt_glyph_at_v4 = txt_glyph_at(219);
  int txt_glyphs_v3 = (import txt_glyphs)[txt_glyph_at_v4];
  int txt_glyph_at_v5 = txt_glyph_at(219);
  int txt_glyphs_v4 = (import txt_glyphs)[txt_glyph_at_v5 + 15];
  int txt_glyph_at_v6 = txt_glyph_at(176);
  int txt_glyphs_v5 = (import txt_glyphs)[txt_glyph_at_v6];
  int txt_glyph_at_v7 = txt_glyph_at(176);
  print("  block 219 rows 0,15 exp 255 255 | shade 176 rows 0,1 exp 17 68 = " + txt_glyphs_v3 + " " + txt_glyphs_v4 + " " + txt_glyphs_v5 + " " + (import txt_glyphs)[txt_glyph_at_v7 + 1]);
  t_sum();
} return void;

// PSF1, and 512 glyphs of it: the count has to come back capped at 224, because
// a byte is what indexes a glyph here. Its 'A' is a different letter from the
// VGA one -- 24 36 126 where the other is 16 56 254 -- so this is also the check
// that a second load replaces the table rather than leaving the first in place.
t_psf1() {
  int psf_load_v = psf_load("test_assets/latgrkcyr8x16.psf");
  print("psf_load latgrkcyr8x16.psf (PSF1, mode bit 0 set: 512 glyphs) exp 1 = " + psf_load_v);
  int txt_cell_v = txt_cell();
  int txt_cellh_v = txt_cellh();
  int txt_bit_v = txt_bit();
  int txt_facen_v = txt_facen();
  print("  metrics exp w 8 h 16 bits 8 glyphs 224 = " + txt_cell_v + " " + txt_cellh_v + " " + txt_bit_v + " " + txt_facen_v);
  t_psf1r();
} return void;
