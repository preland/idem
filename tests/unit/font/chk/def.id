// The face the engine ships with, before anything is loaded over it.

t_def() {
  print("built-in metrics exp w 8 h 16 bits 8 glyphs 95 = " + txt_cell() + " " + txt_cellh() + " " + txt_bit() + " " + txt_facen());
  print("built-in range exp first 32 last 126 = " + (import txt_first) + " " + txt_last());
  t_at();
} return void;

// The index arithmetic, which moved from *8 to *16 with the face and is the one
// piece of it that would fail silently: a glyph drawn from the wrong offset is
// still a glyph.
//
// Out of range draws a space rather than reading past the table. 9 is Tab and
// 300 is past every code point; both answer the offset of code 32.
t_at() {
  print("txt_glyph_at(32, 65, 126) exp 0 528 1504 = " + txt_glyph_at(32) + " " + txt_glyph_at(65) + " " + txt_glyph_at(126));
  print("txt_glyph_at(9, 300) both draw a space, exp 0 0 = " + txt_glyph_at(9) + " " + txt_glyph_at(300));
  t_defr();
} return void;

// Rows 2, 3 and 7 of 'A': the apex, the row below it, and the crossbar. 254 is
// 11111110 -- seven columns of the eight, which is what makes the VGA face's
// crossbar reach the full width of the letter.
t_defr() {
  print("built-in 'A' rows 2,3,7 exp 16 56 254 = " + (import txt_glyphs)[txt_glyph_at(65) + 2] + " " + (import txt_glyphs)[txt_glyph_at(65) + 3] + " " + (import txt_glyphs)[txt_glyph_at(65) + 7]);
  print("built-in table, FNV-1a of all 1520 rows, exp 1584669841 = " + t_hash(0, txt_facen() * txt_cellh(), 2166136261));
  t_psf2();
} return void;
