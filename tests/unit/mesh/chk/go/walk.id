t_one_off1(string name) {
  int si = bl_sfind(name);
  int bl_soff_v = bl_soff(si);
} return int bl_soff_v;

t_one_le16(string name) {
  int si = bl_sfind(name);
  int bl_soff_v2 = bl_soff(si);
  int bl_le16_v = bl_le16(bl_soff_v2 + 2);
} return int bl_le16_v;

t_one_size(string name) {
  int bl_soff_v = t_one_off1(name);
  int bl_le16_v = t_one_le16(name);
  int bl_fwalk_v = bl_fwalk(bl_soff_v + 4, bl_le16_v, "");
} return int bl_fwalk_v;
