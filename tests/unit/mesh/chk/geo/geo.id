// Mesh extraction: the attribute walk, the axis conversion, the triangulation.
//
// Every expected value comes from a python reader written against the format
// documentation, not from this code's first run.
//
// The cube is a good fixture precisely because its answers are checkable by hand:
// eight corners at +/-1 unit, six quads, and therefore twelve triangles. The sum
// of every coordinate of every triangle is 0 because the cube is symmetric about
// the origin -- a check that catches a sign error in the axis conversion, which
// the checksum alone would only tell you about after the fact.

t_geo() {
  int bl_mesh_v = bl_mesh("tests/unit/mesh/cube.blend");
  print("mesh cube.blend exp 1 = " + bl_mesh_v);
  int len_v = len((import bl_v));
  int bl_ntri_v = bl_ntri();
  print("verts exp 8, triangles exp 12 = " + len_v / 3 + " " + bl_ntri_v);
  t_verts();
} return void;

// Blender (-1,-1,-1) with Z up becomes (-1000,-1000,1000) with Y up and -Z
// forward: x keeps, y takes Blender's z, z takes Blender's negated y.
t_verts() {
  print("v0 exp -1000 -1000 1000 = " + (import bl_v)[0] + " " + (import bl_v)[1] + " " + (import bl_v)[2]);
  print("v7 exp 1000 1000 -1000 = " + (import bl_v)[21] + " " + (import bl_v)[22] + " " + (import bl_v)[23]);
  t_tris();
} return void;

t_tris() {
  print("tri0 exp 0 1 3, tri1 exp 0 3 2 = " + (import bl_ti)[0] + " " + (import bl_ti)[1] + " " + (import bl_ti)[2] + " | " + (import bl_ti)[3] + " " + (import bl_ti)[4] + " " + (import bl_ti)[5]);
  t_sum();
} return void;
