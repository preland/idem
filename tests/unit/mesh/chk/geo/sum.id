// Two whole-mesh checks: a symmetry sum and a checksum.
//
// The sum is 0 for this cube because it is symmetric about the origin, so a
// flipped sign anywhere in the axis conversion moves it off 0. The checksum is
// the exhaustive one: every coordinate of every triangle, in order, so a wrong
// vertex, a wrong winding or a wrong fan changes it.

t_sum() {
  int t_coords_v = t_coords();
  print("sum of all triangle coords exp 0 = " + t_coords_v);
  word t_hash_v = t_hash(0, 2166136261);
  print("FNV-1a of all triangle coords exp 2593114485 = " + t_hash_v);
  t_fill();
} return void;

t_coords() {
  int n = 0;
  int i = 0;
  while (i < len((import bl_ti))) {
    n = n + (import bl_v)[(import bl_ti)[i] * 3] + (import bl_v)[(import bl_ti)[i] * 3 + 1] + (import bl_v)[(import bl_ti)[i] * 3 + 2];
    i = i + 1;
  }
} return int n;

t_hash(int i, word wp) {
  while (i < len((import bl_ti))) {
    wp = t_hv(wp, (import bl_ti)[i] * 3);
    i = i + 1;
  }
} return word wp;
