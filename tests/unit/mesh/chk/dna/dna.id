// The SDNA catalogue, and the field walk.

// "DATA" packed most significant byte first, which is how a block code is stored.
t_count(int kd) {
  int n = 0;
  int i = 0;
  while (i < len((import bl_bc))) {
    n = n + ((import bl_bc)[i] = kd);
    i = i + 1;
  }
} return int n;

