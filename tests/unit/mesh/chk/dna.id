// The SDNA catalogue, and the field walk.

// "DATA" packed most significant byte first, which is how a block code is stored.
t_count(int kd) {
  int n = 0;
  int i = 0;
  while (i < len((import bl_bc))) {
    n = n + ((import bl_bc)[i] = kd);
    i = i + 1;
  }
} return int n;

t_dna() {
  print("SDNA names/types/structs exp 5225 1131 981 = " + (import bl_st)[4] + " " + (import bl_st)[5] + " " + (import bl_st)[6]);
  int bl_sfind_v = bl_sfind("Mesh");
  int bl_sfind_v2 = bl_sfind("Object");
  print("struct index of Mesh exp 322, of Object exp 692 = " + bl_sfind_v + " " + bl_sfind_v2);
  t_fields();
} return void;

t_fields() {
  int bl_sfind_v = bl_sfind("Mesh");
  int bl_foff_v = bl_foff(bl_sfind_v, "totvert");
  int bl_sfind_v2 = bl_sfind("Mesh");
  int bl_foff_v2 = bl_foff(bl_sfind_v2, "totpoly");
  print("Mesh.totvert offset exp 432, Mesh.totpoly exp 440 = " + bl_foff_v + " " + bl_foff_v2);
  int bl_sfind_v3 = bl_sfind("Mesh");
  int bl_foff_v3 = bl_foff(bl_sfind_v3, "*poly_offset_indices");
  print("Mesh.*poly_offset_indices offset exp 448 = " + bl_foff_v3);
  t_size();
} return void;
