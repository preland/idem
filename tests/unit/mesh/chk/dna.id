// The SDNA catalogue, and the field walk.

// "DATA" packed most significant byte first, which is how a block code is stored.
t_count(int kd) {
  int n = 0;
  int i = 0;
  while (i < len((import bl_bc))) {
    n = n + ((import bl_bc)[i] = kd);
    i = i + 1;
  }
} return int n;

t_dna() {
  print("SDNA names/types/structs exp 5225 1131 981 = " + (import bl_st)[4] + " " + (import bl_st)[5] + " " + (import bl_st)[6]);
  print("struct index of Mesh exp 322, of Object exp 692 = " + bl_sfind("Mesh") + " " + bl_sfind("Object"));
  t_fields();
} return void;

t_fields() {
  print("Mesh.totvert offset exp 432, Mesh.totpoly exp 440 = " + bl_foff(bl_sfind("Mesh"), "totvert") + " " + bl_foff(bl_sfind("Mesh"), "totpoly"));
  print("Mesh.*poly_offset_indices offset exp 448 = " + bl_foff(bl_sfind("Mesh"), "*poly_offset_indices"));
  t_size();
} return void;
