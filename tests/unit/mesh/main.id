// Unit tests for engine/game/load/asset/mesh -- the .blend container.
//
// The fixture is `cube.blend`, saved UNCOMPRESSED by Blender 5.1 (a default cube
// in an empty scene). Uncompressed because Blender's default is zstd and this
// engine has no zstd decoder; see the report in the module header.
//
// Every expected value below was computed independently, by a python reader
// written against the format documentation rather than against this code -- the
// same method the PNG decoder was verified with.
//
// The last check is the one that matters most: the field walk's accumulated size
// for a struct must equal the size the file's own TLEN table records for it. That
// is a self-check the format hands you for free, and it is what proves every
// field offset in between is right rather than merely plausible.

main(int argc, string[] argv) {
  export string mesh_path = t_main_path(argc, argv);
  fx_trig_init();
  t_boot();
} chain (int argc, string[] argv) {
  t_open((import mesh_path));
} return int 0;
(2, ["mesh", "../../../test_assets/cube.blend"]):(0) then calls t_open:("../../../test_assets/cube.blend")
(2, ["prog", "../../../test_assets/cube.blend"]):(0) then calls t_boot:[1]

t_open(string path) {
  t_main_open();
  print("header length exp 17 = " + (import bl_st)[0]);
  t_blocks(path);
} return void;
given mesh_ready ("../../../test_assets/cube.blend"):("../../../test_assets/cube.blend") then calls t_main_open:[1]
given mesh_ready ("../../../test_assets/cube.blend"):("../../../test_assets/cube.blend") then calls t_blocks:("../../../test_assets/cube.blend")

t_blocks(string path) {
  print("blocks before the ENDB sentinel exp 1076 = " + (import bl_st)[1]);
  t_main_blocks_count();
  t_dna(path);
} return void;
given mesh_open_ready ("../../../test_assets/cube.blend"):("../../../test_assets/cube.blend") then calls t_main_blocks_count:[1]
given mesh_open_ready ("../../../test_assets/cube.blend"):("../../../test_assets/cube.blend") then calls t_dna:("../../../test_assets/cube.blend")
