// A second entity to collide with, and the scene's own script.
//
// `on enter` is fired by the test rather than by a scene load, which is what
// makes the spawn observable: the statement is in the document, parsed by the
// real parser and run by the real interpreter.

t_src4() {
  string ret_s = "  entity wall {" + chr(10) + "    pos (55, 50)" + chr(10) + "    body (10, 10)" + chr(10) + "    solid" + chr(10) + "    tag deadly" + chr(10) + "  }" + chr(10) + "  script {" + chr(10) + "    on timer 100 { ticks = ticks + 1 }" + chr(10) + "    on enter { spawn Box at (30, 40) }" + chr(10) + "  }" + chr(10) + "}" + chr(10);
} return string ret_s;
():("  entity wall {\n    pos (55, 50)\n    body (10, 10)\n    solid\n    tag deadly\n  }\n  script {\n    on timer 100 { ticks = ticks + 1 }\n    on enter { spawn Box at (30, 40) }\n  }\n}\n")
given fx_trig_init ():("  entity wall {\n    pos (55, 50)\n    body (10, 10)\n    solid\n    tag deadly\n  }\n  script {\n    on timer 100 { ticks = ticks + 1 }\n    on enter { spawn Box at (30, 40) }\n  }\n}\n")

scr_doc_ready() {
  scr_loaded_ready();
  int[] pos = [0];
  export int scr_doc = par_doc(pos);
} return void;
():() then calls scr_loaded_ready:[1]
():() then calls par_doc:[1]

// The document, lexed, parsed and loaded -- the state t_vars starts from.
scr_scene_ready() {
  scr_doc_ready();
  scn_load((import scr_doc));
} return void;
():() then calls scr_doc_ready:[1]
():() then calls scn_load:[1]
