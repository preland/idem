// Test-only fixtures: main.id's own init order, in stages, so a case below
// the top of the chain does not have to replay every earlier init call
// itself (each of main/t_boot/t_boot2/.../t_boot5 is already at the 3-action
// limit with just its own two inits and the call onward).
scr_s1_ready() {
  fx_trig_init();
  rnd_init(7);
} return void;
():() then calls fx_trig_init:[1]
():() then calls rnd_init:(7)

