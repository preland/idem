// What the load put in the tables, before any handler has run.
//
// The game's `persist` block is at the front and the scene's `var`s follow it, so
// the scopes are checked from both ends: a name the scene declared is visible
// from an entity, and a name an entity declared is not visible from the scene.

t_vars() {
  int scr_get_v = scr_get(0 - 1, "best");
  print("game block: best exp 7 = " + scr_get_v);
  int scr_get_v2 = scr_get(0 - 1, "n");
  int scr_get_v3 = scr_get(0 - 1, "ticks");
  int scr_get_v4 = scr_get(0 - 1, "taps");
  int scr_get_v5 = scr_get(0 - 1, "hits");
  print("scene vars n/ticks/taps/hits exp 0 0 0 0 = " + scr_get_v2 + " " + scr_get_v3 + " " + scr_get_v4 + " " + scr_get_v5);
  t_vars2();
} return void;

// Three, not two: the scene declares a bird and a wall, and its `on enter`
// spawned a Box while the document was still loading. That handler firing at load
// is the thing being checked -- a scene has a beginning and something has to
// happen at it.
t_vars2() {
  int ent_n_v = ent_n();
  int ent_at_v = ent_at(0, 20);
  print("entities exp 3, bird tagged exp 1 = " + ent_n_v + " " + (ent_at_v != 0));
  int scr_get_v = scr_get(0, "own");
  int scr_get_v2 = scr_get(0 - 1, "own");
  print("own from the bird exp 5, from the scene exp 0 = " + scr_get_v + " " + scr_get_v2);
  t_upd();
} return void;

// One update. `n = 3 * 4 + 2` is 14 and not 18: `*` binds tighter than `+`,
// which is `id`'s rule and every other language's.
t_upd() {
  scr_upd(0);
  int scr_get_v = scr_get(0 - 1, "n");
  int scr_get_v2 = scr_get(0, "own");
  print("after one update: n exp 14, own exp 6 = " + scr_get_v + " " + scr_get_v2);
  t_hit();
} return void;
