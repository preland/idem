// Timers and the press.
//
// `on timer 100` at 20 ms a frame: four frames are not enough, the fifth is. What
// is being checked is that the accumulator is milliseconds and not frames -- the
// same script at 60 fps must fire after the same 100 ms, not after the same five
// turns.

t_tick() {
  t_ticks(4, 20);
  t_tick_rep();
  t_tick2();
} return void;
given scr_hit2_ready ():() then calls t_ticks:(4, 20)
given scr_hit2_ready ():() then calls t_tick2:[1]

t_ticks(int n, int dt) {
  int i = 0;
  while (i < n) {
    scr_tick(dt);
    i = i + 1;
  }
} return void;
given scr_scene_ready (0, 20):() then calls scr_tick:[0]
given scr_scene_ready (2, 20):() then calls scr_tick:[2]

t_tick2() {
  t_ticks(1, 20);
  t_tick2_rep();
  t_press();
} return void;
given scr_tick_ready ():() then calls t_ticks:(1, 20)
given scr_tick_ready ():() then calls t_press:[1]
