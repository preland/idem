// The four colour types, each loaded whole at its native size.

t_small() {
  t_one("grey", "tests/unit/spr/img/grey.png");
  t_one("ga", "tests/unit/spr/img/ga.png");
  t_small2();
} return void;

t_small2() {
  t_one("rgb", "tests/unit/spr/img/rgb.png");
  t_one("rgba", "tests/unit/spr/img/rgba.png");
  t_big();
} return void;

// cols = rows = 1 is a whole image as one frame; 0, 0 keeps the source's size.
t_one(string name, string path) {
  int p = spr_png(name, path, 1, 1, 0, 0);
  print(name + ": id " + p + " " + d2_spr_w(p) + "x" + d2_spr_h(p) + " frames " + d2_spr_nf(p));
  t_dump(p, d2_spr_w(p) * d2_spr_h(p));
} return void;
