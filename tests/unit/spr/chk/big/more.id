t_big_show(int p) {
  string msg = "sheet: id " + p + " " + d2_spr_w(p) + "x" + d2_spr_h(p) + " frames " + d2_spr_nf(p);
  print(msg);
} return void;

t_probe_show(int p) {
  string msg = "  frame0 (0,0) exp -1 = " + d2_spr_at(p, 0) + " | frame12 (20,20) exp 15657421 = " + d2_spr_at(p, 12 * 1600 + 20 * 40 + 20);
  print(msg);
} return void;
