t_fxdiv2() {
  int fx_div_v = fx_div(1000, 4000, 1000);
  int fx_div_v2 = fx_div(0 - 1000, 4, 1000);
  t_fxdiv3(fx_div_v, fx_div_v2);
} return void;

t_fxdiv3(int fx_div_v, int fx_div_v2) {
  int fx_div_v3 = fx_div(3000000, 7, 1000);
  int fx_div_v4 = fx_div(5, 0, 1000);
  t_fxdiv4(fx_div_v, fx_div_v2, fx_div_v3, fx_div_v4);
} return void;

t_fxdiv4(int fx_div_v, int fx_div_v2, int fx_div_v3, int fx_div_v4) {
  print("fx_div(1000,4000,1000) exp 250 | (-1000,4,1000) exp -250000 | word (3000000,7,1000) exp 428571428 | (5,0,1000) exp 0 = " + fx_div_v + " " + fx_div_v2 + " " + fx_div_v3 + " " + fx_div_v4);
  t_fxlerp();
} return void;
