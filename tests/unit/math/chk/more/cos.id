// fx_cos, the first-quadrant interpolator on its own, and the first two draws of
// the PRNG. The two rnd_next values are the reference Park-Miller sequence from
// seed 12345 (state 12346 after the seed fold), so a broken Schrage split shows
// up immediately rather than as a subtly non-uniform distribution.

t_cos() {
  int fx_cos_v = fx_cos(0);
  int fx_cos_v2 = fx_cos(60000);
  int fx_cos_v3 = fx_cos(90000);
  print("fx_cos(0,60000,90000) exp 1000 500 0 = " + fx_cos_v + " " + fx_cos_v2 + " " + fx_cos_v3);
  int fx_cos_v4 = fx_cos(180000);
  int fx_cos_v5 = fx_cos(270000);
  int fx_cos_v6 = fx_cos(45000);
  int fx_cos_v7 = fx_cos(30500);
  print("fx_cos(180000,270000,45000,30500) exp -1000 0 707 861 = " + fx_cos_v4 + " " + fx_cos_v5 + " " + fx_cos_v6 + " " + fx_cos_v7);
  t_lin();
} return void;

t_lin() {
  int idstd_fx_sin_lin_v = idstd_fx_sin_lin(0);
  int idstd_fx_sin_lin_v2 = idstd_fx_sin_lin(45000);
  int idstd_fx_sin_lin_v3 = idstd_fx_sin_lin(90000);
  print("fx_sin_lin(0,45000,90000) exp 0 707 1000 = " + idstd_fx_sin_lin_v + " " + idstd_fx_sin_lin_v2 + " " + idstd_fx_sin_lin_v3);
  int idstd_fx_tab_v = idstd_fx_tab(0);
  int idstd_fx_tab_v2 = idstd_fx_tab(45);
  int idstd_fx_tab_v3 = idstd_fx_tab(90);
  print("fx_tab(0,45,90) exp 0 707 1000 = " + idstd_fx_tab_v + " " + idstd_fx_tab_v2 + " " + idstd_fx_tab_v3);
  t_rnd();
} return void;

t_rnd() {
  int rnd_next_v = rnd_next();
  print("rnd_next draw 1 exp 207499222 = " + rnd_next_v);
  int rnd_next_v2 = rnd_next();
  print("rnd_next draw 2 exp 2073465073 = " + rnd_next_v2);
  t_rndspan();
} return void;
