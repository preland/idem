// tint -- a sprite frame drawn in one colour, shape only.
//
// The sprite's pixels choose *where* to draw; c chooses *what* colour. That is how
// one font, or one icon, serves every colour a UI asks for without a second copy
// of the art (IDML_GAME.md section 6's `Text("...", font, colour)` over a sprite
// font is exactly this).
//
// Unlike the blit path this goes through sf_pset per pixel and does no clipping of
// its own -- deliberately. sf_pset costs about 2.1 ns and clips itself, a glyph is
// 8x8, and a screen full of tinted text is a few thousand pixels: the clip
// arithmetic would be a larger share of the cost than the stores it saves. Area
// still goes through spans; this is not area.

txt_tint(int p, int x, int y, int f, int c) {
  int w = d2_spr_w(p);
  int h = d2_spr_h(p);
  txt_tint_setup(p, x, y, f, c, w, h);
} return void;
given sf_t_setup given txt_spr_t_setup (0, 0, 0, 0, 7):() then d2_blit_t_px00:(7)
given sf_t_setup given txt_spr_t_setup (0, 0, 0, 0, 3):() then d2_blit_t_px00:(3)

txt_tint_rows(int p, int x, int y, int i, int c, int j) {
  while (j < d2_spr_h(p)) {
    txt_tint_row_at(p, x, y, i, c, j);
    j = j + 1;
  }
} return void;
given sf_t_setup given txt_spr_t_setup (0, 0, 0, 0, 7, 0):() then d2_blit_t_px00:(7)
given sf_t_setup given txt_spr_t_setup (0, 0, 0, 0, 7, 1):() then d2_blit_t_px00:(0)

// Same transparency test as d2_blit_row, different destination: the colour is the
// caller's, not the sprite's.
txt_tint_row(int[] xs, int i, int x, int y, int c, int n) {
  int k = 0;
  while (k < n) {
    if (xs[i + k] != (import d2_clear)) {
      sf_pset(x + k, y, c);
    }
    k = k + 1;
  }
} return void;
given sf_t_setup ([5, -1], 0, 0, 0, 7, 2):() then d2_blit_t_px00:(7)
given sf_t_setup ([5], 0, 0, 0, 7, 0):() then d2_blit_t_px00:(0)
