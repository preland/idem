// The rest of d2_blit_clip's row extent -- split out to keep it under the
// action limit.

d2_blit_clip2(int p, int x, int y, int i, int x0, int w) {
  int x1 = fx_min(x + w - 1, (import sf_cl)[2]);
  int[] px = d2_spr_px(p);
  d2_blit_clip3(x, y, i, x0, x1, px);
} return void;
given d2_blit_t_setup (0, 0, 0, 0, 0, 2):() then d2_blit_t_px00:(5)
given d2_blit_t_setup (1, 0, 0, 3, 0, 3):() then d2_blit_t_px00:(8)

d2_blit_clip3(int x, int y, int i, int x0, int x1, int[] px) {
  int idx = sf_idx(x0, y);
  d2_blit_row(px, i + x0 - x, (import sf_fb), idx, x1 - x0 + 1);
} return void;
given sf_t_setup (0, 0, 0, 0, 1, [5, 9]):() then d2_blit_t_px00:(5)
given sf_t_setup (0, 0, 0, 0, 0, [-1, 9]):() then d2_blit_t_px00:(0)
