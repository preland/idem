// The rest of d2_blit's setup -- the frame index and the vertical clip --
// split out to keep d2_blit under the action limit.

d2_blit_setup(int p, int x, int y, int f, int w, int h) {
  int nf = d2_spr_nf(p);
  int i = w * h * fx_clamp(f, 0, nf - 1);
  d2_blit_clip_y(p, x, y, w, h, i);
} return void;
given d2_blit_t_setup (0, 0, 0, 0, 2, 2):() then d2_blit_t_px00:(5)
given d2_blit_t_setup (1, 0, 0, 5, 3, 1):() then d2_blit_t_px00:(8)

d2_blit_clip_y(int p, int x, int y, int w, int h, int i) {
  int n = fx_min(h, (import sf_cl)[3] + 1 - y);
  int j0 = fx_max(0, (import sf_cl)[1] - y);
  d2_blit_rows(p, x, y, i, j0, n);
} return void;
given d2_blit_t_setup (0, 0, 0, 2, 2, 0):() then d2_blit_t_px00:(5)
given d2_blit_t_setup (0, 0, 48, 2, 2, 0):() then d2_blit_t_px00:(0)
