// glyph -- the default font, one character at a time.
//
// The engine ships a font so a game need not declare one: a score readout, a
// diagnostic and a UI label must work in a game whose .idml says nothing about
// text at all. It is the IBM VGA 8x16 face, code points 32..126, as row bitmasks
// in face/glyphs.gen.id (generated by tools/mkfont.py from test_assets/
// vga8x16.psf). A game that wants its own lettering has two other ways to get
// it: a sprite font (IDML_GAME.md section 2, drawn with txt_spr_draw), or a real
// .psf loaded at runtime with psf_load, which replaces this table in place. None
// of the three is preferred.
//
// txt_init must run before anything draws text -- txt_glyphs AND txt_st are
// exported globals, and an id export is NULL until its declaring function has
// executed, so reading either first would segfault with nothing to point at.
// That now covers txt_cell() as well, which used to be a literal and is a read
// of txt_st; idem_boot's init chain calls this first, and so does every unit
// suite that draws.

txt_init() {
  txt_glyph_data();
} return void;

// Where a code point's rows start in the table -- txt_cellh() of them, not 8:
// the face is 8x16 and a game may load one that is 8x14 or 12x24. Anything
// outside the face's range draws a space rather than reading past the end of the
// table, because an out-of-range list index aborts the process -- and a control
// character or a stray high byte in a game's text is a typo, not a reason to
// kill the game.
txt_glyph_at(int key) {
  int n = key;
  if (key < txt_first() || key > txt_last()) {
    n = txt_first();
  }
} return int (n - txt_first()) * txt_cellh();

txt_glyph(int key, int x, int y, int c) {
  txt_glyph_sc(key, x, y, c, 1000);
} return void;
