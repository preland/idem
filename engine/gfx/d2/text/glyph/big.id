// A glyph at any scale.
//
// `sc` is per-mille, like every other scale in the engine, and that is a change:
// this used to take a whole-pixel magnification on the argument that an 8x8
// bitmap magnified by 1.7 has rows one pixel thick and rows two pixels thick, and
// reads as a broken font rather than as bigger text.
//
// That argument was right about the *strokes* and wrong about the *size*. A
// caller that wants text two and a half times bigger and gets it twice as big has
// been told a lie about its own layout: a label centred in a rect is no longer
// centred, and text drawn into a view that is being zoomed jumps between whole
// steps while everything around it moves smoothly. The editor's own chrome still
// asks for whole steps, because it is drawing at one of a handful of window sizes
// and crisp is what it wants there; a game's UI asks for the stage's scale, and
// gets text that is exactly as big as the thing it is labelling.
//
// Each font pixel is the gap between two *rounded boundaries* rather than a fixed
// width -- `(k+1)*sc/1000 - k*sc/1000`. The rounding error therefore never
// accumulates: a glyph's columns span exactly `txt_cell() * sc / 1000` screen
// pixels, so a string's drawn width always equals what txt_width_sc measured. A
// fixed width per pixel is what makes a scaled bitmap font drift away from its
// own metrics.
//
// THE CELL IS NO LONGER SQUARE. It was 8x8 and one number was the row count, the
// column count and the advance; the default face is 8x16 and a loaded one may be
// 12x24, so the loop below counts rows with txt_cellh() and columns with
// txt_cell(), and the bit test shifts against txt_bit() -- which is neither, for
// a face whose width is not a multiple of 8 (glyph/face/face.id).

txt_glyph_sc(int key, int x, int y, int c, int sc) {
  int j = 0;
  while (j < txt_cellh()) {
    int txt_glyph_at_v = txt_glyph_at(key);
    txt_row_sc((import txt_glyphs)[txt_glyph_at_v + j], x, y, c, sc, j);
    j = j + 1;
  }
} return void;

// The top bit of the packed row is the leftmost column, so column k is bit
// txt_bit() - 1 - k.
txt_row_sc(int bits, int x, int y, int c, int sc, int j) {
  int k = 0;
  while (k < txt_cell()) {
    txt_px_sc(bits, x, y, c, sc, j * 256 + k);
    k = k + 1;
  }
} return void;

// Row and column arrive packed because a block's parameters are cheaper to read
// than to count: `j * 256 + k` is two indices in the space of one. 256 still
// clears both -- a row index now reaches 15 rather than 7, and psf_fit refuses
// any face taller than 64.
txt_px_sc(int bits, int x, int y, int c, int sc, int jk) {
  if (((bits >> (txt_bit() - 1 - jk % 256)) & 1) = 1) {
    int txt_ext_v = txt_ext(jk % 256, sc);
    int txt_ext_v2 = txt_ext(jk / 256, sc);
    sf_rect(x + jk % 256 * sc / 1000, y + jk / 256 * sc / 1000, txt_ext_v, txt_ext_v2, c);
  }
} return void;
