// num -- an integer, drawn digit by digit, with no string built anywhere.
//
// This is the single most-called text routine in a real game -- a score, a timer,
// a frame counter, a health value, every frame -- and it is the reason the engine
// can afford text at all. The obvious implementation, txt_draw("" + v, ...),
// allocates a string per digit per frame and never frees any of them: measured at
// 667 ms and 1.8 GB of retained memory for a thousand frames of one line of text
// (research/id-language.md section 3). So no string is built: the digits are
// extracted with / and %, and each one is drawn as its own glyph: '0' is 16 code
// points past the font's first, and '-' is 13.
//
// 0 draws "0" (txt_num_pow returns 1, so the loop runs once). A negative draws its
// minus sign first and then its magnitude. The one input this cannot handle is
// -2147483648, whose magnitude does not exist in 32 bits: fx_abs returns it
// unchanged and the digits come out wrong. Nothing in a game reaches it -- every
// fixed-point quantity in ARCHITECTURE.md section 4 is far below it -- and the
// alternative is word arithmetic in the hottest text path in the engine.

txt_number(int v, int x, int y, int c) {
  int txt_ui_v = txt_ui();
  txt_num_sc(v, x, y, c, txt_ui_v * 1000);
} return void;

// The same, at a given per-mille scale -- what a game's UI draws a score with,
// where the scale belongs to the stage rather than to the window.
txt_num_sc(int v, int x, int y, int c, int sc) {
  int m = fx_abs(v);
  if (v < 0) {
    txt_glyph_sc((import txt_first) + 13, x, y, c, sc);
  }
  int txt_cell_v = txt_cell();
  int txt_num_pow_v = txt_num_pow(m);
  int txt_num_pw_v = txt_num_pw(txt_num_pow_v, sc);
  txt_num_run(m, x + txt_cell_v * sc / 1000 * (v < 0), y, c, txt_num_pw_v);
} return void;

// pw walks 10^(digits-1) down to 1, so the digits come out most significant first
// -- which is the order they have to be drawn in, and the reason the power is
// computed up front rather than the digits being peeled off the bottom. The scale
// rides along packed with it, because a block's five parameters are already the
// most this loop can carry.
txt_num_run(int m, int x, int y, int c, int pwsc) {
  while (pwsc / 65536 > 0) {
    txt_glyph_sc((import txt_first) + 16 + (m / (pwsc / 65536)) % 10, x, y, c, pwsc % 65536);
    x = x + txt_cell() * (pwsc % 65536) / 1000;
    pwsc = pwsc / 65536 / 10 * 65536 + pwsc % 65536;
  }
} return void;
