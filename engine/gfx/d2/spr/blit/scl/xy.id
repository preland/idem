// The scaled blit with independent axes.
//
// The vertical scale decides how many destination rows there are and which source
// row each of them samples; the horizontal scale decides how wide each row is and
// which source column each pixel samples. They meet nowhere, which is why one
// function covers both and the square case is a call to it.

d2_blit_xy(int p, int x, int y, int f, int sx, int sy) {
  int d2_spr_w_v = d2_spr_w(p);
  int d2_spr_h_v = d2_spr_h(p);
  int d2_spr_nf_v = d2_spr_nf(p);
  int i = d2_spr_w_v * d2_spr_h_v * fx_clamp(f, 0, d2_spr_nf_v - 1);
  int d2_spr_h_v2 = d2_spr_h(p);
  int n = fx_min(d2_spr_h_v2 * sy / 1000, (import sf_cl)[3] + 1 - y);
  int fx_max_v = fx_max(0, (import sf_cl)[1] - y);
  d2_scl_rows(p, x, y, i, fx_max_v, n, sx, sy);
} return void;
