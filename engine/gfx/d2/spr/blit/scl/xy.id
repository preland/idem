// The scaled blit with independent axes.
//
// The vertical scale decides how many destination rows there are and which source
// row each of them samples; the horizontal scale decides how wide each row is and
// which source column each pixel samples. They meet nowhere, which is why one
// function covers both and the square case is a call to it.

d2_blit_xy(int p, int x, int y, int f, int sx, int sy) {
  int w = d2_spr_w(p);
  int h = d2_spr_h(p);
  d2_xy_setup(p, x, y, f, w, h, sx, sy);
} return void;

d2_xy_setup(int p, int x, int y, int f, int w, int h, int sx, int sy) {
  int nf = d2_spr_nf(p);
  int i = w * h * fx_clamp(f, 0, nf - 1);
  d2_xy_clip_y(p, x, y, w, h, i, sx, sy);
} return void;

d2_xy_clip_y(int p, int x, int y, int w, int h, int i, int sx, int sy) {
  int n = fx_min(h * sy / 1000, (import sf_cl)[3] + 1 - y);
  int j0 = fx_max(0, (import sf_cl)[1] - y);
  d2_scl_rows(p, x, y, i, j0, n, sx, sy);
} return void;
