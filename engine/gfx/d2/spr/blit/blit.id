// blit -- draw one frame of a sprite, clipped, transparency honoured.
//
// x, y is the sprite's top-left corner in whole pixels. Clipping happens exactly
// twice per blit and never per pixel: once vertically here (which rows of the
// sprite land on the surface) and once horizontally per row in d2_blit_clip
// (where that row starts and stops). What is left is d2_blit_row, a flat loop
// with no tests in it. That is the shape ARCHITECTURE.md section 3.1 demands.
//
// Every degenerate case falls out of the arithmetic rather than a guard:
//   y past the clip's bottom -> n <= 0, no rows
//   y above its top by h      -> the first row index is already past n, no rows
//   x off either side         -> the row's extent is empty, d2_blit_row's n <= 0
// so a sprite entirely off-screen costs a handful of comparisons and draws
// nothing, instead of aborting on an out-of-range store.
//
// The frame index is clamped, not trusted: an anim that runs one frame past the
// end would index past the pixel list, and that aborts the process.

d2_blit(int p, int x, int y, int f) {
  int i = d2_spr_w(p) * d2_spr_h(p) * fx_clamp(f, 0, d2_spr_nf(p) - 1);
  int n = fx_min(d2_spr_h(p), (import sf_cl)[3] + 1 - y);
  d2_blit_rows(p, x, y, i, fx_max(0, (import sf_cl)[1] - y), n);
} return void;

// j is the sprite row, so y + j is the surface row and i + w * j the first source
// pixel of it. j starts at the first row that is on-screen, not at 0.
d2_blit_rows(int p, int x, int y, int i, int j, int n) {
  while (j < n) {
    d2_blit_clip(p, x, y + j, i + d2_spr_w(p) * j);
    j = j + 1;
  }
} return void;

// The row's extent, clipped once. x0..x1 are surface columns; the source index
// skips the same number of pixels the left clip removed, which is what keeps a
// sprite hanging off the left edge from sliding sideways as it moves.
d2_blit_clip(int p, int x, int y, int i) {
  int x0 = fx_max(x, (import sf_cl)[0]);
  int x1 = fx_min(x + d2_spr_w(p) - 1, (import sf_cl)[2]);
  d2_blit_row(d2_spr_px(p), i + x0 - x, (import sf_fb), sf_idx(x0, y), x1 - x0 + 1);
} return void;
