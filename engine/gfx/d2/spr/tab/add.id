// add -- appending a sprite to the table.
//
// The idml loader calls this once per `sprite` or `font` declaration and then
// fills the pixels with d2_spr_put; a game's own id hook, or a test, can call it
// directly, which is what makes the table usable before the loader exists.
//
// The pixel list is allocated at full size (w * h * frames) and pre-filled with
// (import d2_clear), so a sprite is fully transparent until something writes to it and a
// half-decoded sprite draws holes rather than reading a cell that is not there.
// Growing it later is not an option worth having: push is cheap but an
// out-of-range index aborts the process, so the size is fixed here, once.
//
// The id it returns is the index every accessor takes. Ids are never reused and
// nothing is ever removed -- a sprite table is load-time data.

d2_spr_add(string name, int w, int h, int n) {
  int[] xs = [];
  lst_fill(xs, w * h * n, (import d2_clear));
  d2_spr_push(name, w, h, n, xs);
} return int len((import asset_sprw)) - 1;

// Five pushes in lockstep, split 2 + 3 by the action limit. Every column must be
// pushed exactly once per sprite or every later index is off by one, which is why
// they are here together and not at the call sites.
d2_spr_push(string name, int w, int h, int n, int[] xs) {
  push((import asset_sprw), w);
  push((import asset_sprh), h);
  d2_spr_push2(name, n, xs);
} return void;

d2_spr_push2(string name, int n, int[] xs) {
  push((import asset_sprf), n);
  push((import asset_sprpx), xs);
  push((import asset_sprn), name);
} return void;
