// line -- Bresenham, folded into the shape this language allows.
//
// The textbook loop ends with `if (x = x1 && y = y1) break;`. There is no break
// in `id`, so instead the loop is counted: a line from (x0,y0) to (x1,y1) is
// exactly max(|dx|, |dy|) + 1 pixels, the error term reaches the far endpoint on
// the last of them, and no test is needed inside the loop at all. That also
// makes a zero-length line one pixel rather than an infinite loop.
//
// The walker's state is three cells -- x, y, error -- in a list, because a
// helper cannot write back to its caller's locals but a list is a reference.
// Slots: 0 x, 1 y, 2 err.
//
// All eight octants come out of the two independent step tests in line2.id;
// there is no octant switch and no coordinate swap. Off-screen input is safe
// and needs no clip here: sf_pset tests every pixel, and the iteration count is
// bounded by the coordinate span, so a line drawn entirely off the surface costs
// time and draws nothing (as it should) rather than aborting.

d2_line(int x0, int y0, int x1, int y1, int c) {
  int[] st = [x0, y0, fx_abs(x1 - x0) - fx_abs(y1 - y0)];
  int n = fx_max(fx_abs(x1 - x0), fx_abs(y1 - y0));
  d2_line_run(st, fx_abs(x1 - x0), fx_abs(y1 - y0), fx_sign(x1 - x0), fx_sign(y1 - y0), n, c);
} return void;

// n + 1 pixels, counted rather than compared against the endpoint.
d2_line_run(int[] st, int dx, int dy, int sx, int sy, int n, int c) {
  int i = 0;
  while (i <= n) {
    i = i + d2_line_step(st, dx, dy, sx, sy, c);
  }
} return void;

// Plot, then advance. The 1 it returns is the loop's increment: the body of a
// while has three actions too, and handing the count to the callee's return
// clause is how a two-statement body becomes one.
d2_line_step(int[] st, int dx, int dy, int sx, int sy, int c) {
  sf_pset(st[0], st[1], c);
  d2_line_adv(st, dx, dy, sx, sy);
} return int 1;
