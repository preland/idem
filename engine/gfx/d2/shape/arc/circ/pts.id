// pts -- eight-way symmetry, in blocks of three actions.
//
// One computed arc point (i, j) is eight pixels: the four sign combinations, and
// the same four with the offsets swapped, which is the reflection across the
// 45-degree diagonal. Eight sf_psets do not fit in one block, so the split is
// 2 + 2 + 2 through three functions rather than one.
//
// At the diagonal (i = j) and on the axes (i = 0) some of the eight coincide and
// a pixel is written twice. That costs a store and changes nothing on screen;
// suppressing it would cost a branch per point.

d2_circ_pts(int x, int y, int i, int j, int c) {
  d2_circ_4(x, y, i, j, c);
  d2_circ_4(x, y, j, i, c);
} return void;

d2_circ_4(int x, int y, int i, int j, int c) {
  sf_pset(x + i, y + j, c);
  sf_pset(x - i, y + j, c);
  d2_circ_2(x, y, i, j, c);
} return void;

d2_circ_2(int x, int y, int i, int j, int c) {
  sf_pset(x + i, y - j, c);
  sf_pset(x - i, y - j, c);
} return void;
