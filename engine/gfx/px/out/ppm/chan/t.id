// Small, exact surfaces for ppm_dump/ppm_head/ppm_rows's own cases (dump.id,
// ../ppm2/rows.id). sf_t_setup's 64x48 surface is too big to spell out as one
// `prints` literal, so these fixtures build a surface a couple of pixels wide
// instead, with known colours at known slots.

ppm_t_small() {
  sf_open(2, 1);
  sf_pset(0, 0, 16711680);
  sf_pset(1, 0, 255);
} chain () {
  ppm_init();
} return void;
():() then calls sf_open:(2, 1)
():() then calls ppm_init:[1]

ppm_t_small2() {
  sf_open(1, 1);
  sf_pset(0, 0, 65280);
  ppm_init();
} return void;
():() then calls sf_open:(1, 1)
():() then calls sf_pset:(0, 0, 65280)
