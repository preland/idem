// ppm2 -- the rows of the dump.
//
// Split from ppm.id only by the 3-functions-per-file rule. ppm_head emits the
// maxval line and then walks the rows; a row walks its pixels; a pixel is three
// table lookups and four puts, with no allocation anywhere.

ppm_head() {
  print("255");
  ppm_rows(0);
  flush();
} return void;

ppm_rows(int y) {
  while (y < (import sf_gh)) {
    int sf_idx_v = sf_idx(0, y);
    ppm_row((import sf_fb), sf_idx_v, (import sf_gw));
    y = y + 1;
  }
} return void;

ppm_row(int[] xs, int i, int n) {
  int x = 0;
  while (x < n) {
    ppm_px(xs[i + x]);
    x = x + 1;
  }
  ppm_row_end();
} return void;
