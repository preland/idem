// span -- the fast path, and the reason a software rasteriser is viable here.
//
// Measured on this machine, in id:
//     sf_pset per pixel ............. 0.5 Gpx/s
//     lset per pixel ................ 1.0 Gpx/s
//     xs[i] = v, flat loop on a
//       list *parameter* ............ 4.3-5.0 Gpx/s
//
// The 10x comes from the list being a parameter: a parameter is an lvalue, so
// the store compiles to a direct indexed write with no call and no global read.
// So every routine that fills area -- rects, triangle spans, sprite rows,
// the upscaler -- clips its extent ONCE here and then hands a plain index range
// to sf_span_row, which contains nothing but the loop.
//
// At 640x400/60fps this budget is roughly 70 million stores per frame, or
// 30-290x overdraw. That is what makes a z-buffered 3D pipeline comfortable
// rather than marginal.

// Clipped to sf_cl, not to the surface. They are the same rectangle unless a
// caller narrowed it, so this costs two list reads a span and makes every filled
// area in the engine -- rects, lines, frames, text, triangle spans -- obey a
// panel's edges. Doing it here rather than in each of them is the only way it
// stays true of the ones written later.
sf_span(int x0, int x1, int y, int c) {
  if (y >= (import sf_cl)[1] && y <= (import sf_cl)[3] && x1 >= (import sf_cl)[0] && x0 <= (import sf_cl)[2]) {
    sf_span_go(x0, x1, y, c);
  }
} return void;

// Inclusive index range. Nothing in here tests anything: sf_span already proved
// the range is inside the surface.
sf_span_row(int[] xs, int i, int n, int c) {
  while (i <= n) {
    xs[i] = c;
    i = i + 1;
  }
} return void;

sf_rect(int x, int y, int w, int h, int c) {
  int j = 0;
  while (j < h) {
    sf_span(x, x + w - 1, y + j, c);
    j = j + 1;
  }
} return void;
