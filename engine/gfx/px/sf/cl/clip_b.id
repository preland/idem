// A clip narrowed away from the default full-surface rect, for sf_unclip's and
// sf_pset's own cases: they need to show a clip that is not already the answer
// sf_unclip resets to.
sf_t_clip_narrow() {
  sf_t_setup();
  sf_clip(5, 5, 10, 10);
} return void;
():() then sf_cl_t_check:([5, 5, 10, 10])
():()

// A pixel already written under the default (full) clip, for sf_pget's own
// cases: sf_pget has nothing to hand it but zeroed state otherwise.
sf_t_px_setup() {
  sf_t_setup();
  sf_pset(0, 0, 123);
} return void;
