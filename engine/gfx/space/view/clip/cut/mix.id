// Interpolating a packed colour, channel by channel.
//
// A packed 0xRRGGBB cannot be interpolated as one number: the carry out of blue
// lands in green. So it is taken apart, each channel is mixed at the same 1/65536
// parameter the coordinates use, and it is packed again. Both endpoints are real
// colours, so every mixed channel is between two values in 0..255 and needs no
// clamp -- unlike the Gouraud accumulator, which steps and can overshoot.

d3_cmix(int a, int b, int t) {
  int r = d3_chn(a / 65536, b / 65536, t);
  int g = d3_chn(a / 256, b / 256, t);
  int ret_i = d3_cmix_b(a, b, t, r, g);
} return int ret_i;
(0, 16777215, 0):(0)
(0, 16777215, 65536):(16777215)
(16711680, 65280, 32768):(8421120)

d3_cmix_b(int a, int b, int t, int r, int g) {
  int bl = d3_chn(a, b, t);
  int ret_i = d2_rgb(r, g, bl);
} return int ret_i;
(0, 16777215, 0, 0, 0):(0)
(16711680, 65280, 32768, 200, 100):(13132800)
(0, 0, 0, 300, -10):(16711680)

// One channel. The shift is the caller's, the mask is here: a / 65536 for red is
// already the top byte, but a / 256 for green still carries red above it.
d3_chn(int a, int b, int t) {
  int ret_i = d3_mix(a % 256, b % 256, t);
} return int ret_i;
(100, 200, 32768):(150)
(0, 255, 65536):(255)
(255, 0, 0):(255)
