// d3_wtri -- draw one triangle given in WORLD space.
//
// This is the 3D pipeline's front door, and everything below it is reached
// through here: transform the three vertices by the view matrix into camera
// space, clip against the near plane, project, cull, rasterise. A caller supplies
// the same 12-slot record d3_tri takes -- three x,y,z triples then three packed
// colours -- and never has to know that camera space exists.
//
// The record is transformed **in place**, so it is scratch: a caller that wants
// to draw the same triangle twice fills it twice. That is deliberate. The
// alternative is allocating a second record per triangle, and `id` never frees --
// a per-triangle allocation is a leak measured in megabytes per second.
//
// m4_apply reads all three coordinates of a vertex before writing any of them, so
// transforming in place does not shear the point (m4/ap/pt/transform.id).

d3_wtri(int[] tri) {
  m4_apply((import d3_vm), tri, 0);
  m4_apply((import d3_vm), tri, 3);
  d3_wtri2(tri);
} return void;

d3_wtri2(int[] tri) {
  m4_apply((import d3_vm), tri, 6);
  d3_nclip(tri);
} return void;
