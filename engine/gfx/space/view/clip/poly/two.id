// The two halves of the quad case. The cut between B and C is computed twice,
// once per half, rather than being carried between them: it is two divides for a
// triangle that is being clipped at all, and the alternative is a fifth slot in
// the scratch record whose lifetime spans two calls -- the kind of state that is
// wrong exactly once, in the frame nobody is looking at.

d3_ntri1(int[] tri, int c) {
  d3_ncopy(tri, (c + 1) % 3, 0);
  d3_ncopy(tri, (c + 2) % 3, 1);
  d3_nemit(tri, (c + 2) % 3, c);
} return void;
given d3_t_setup ([100, 200, 80, 10, 20, 40, 1000, 1000, 0, 1000, 2000, 3000], 2):() then d3_t_clp:([100, 200, 80, 10, 20, 40, 10, 20, 40, 1000, 2000, 2000])
given d3_t_setup ([5, 15, 0, 205, 215, 80, 55, 65, 40, 4000, 5000, 6000], 0):() then d3_t_clp:([205, 215, 80, 55, 65, 40, 55, 65, 40, 5000, 6000, 6000])

d3_ntri2(int[] tri, int c) {
  d3_ncopy(tri, (c + 1) % 3, 0);
  d3_ncut(tri, (c + 2) % 3, c, 1);
  d3_nemit(tri, c, (c + 1) % 3);
} return void;
given d3_t_setup ([100, 200, 80, 10, 20, 40, 1000, 1000, 0, 1000, 2000, 3000], 2):() then d3_t_clp:([100, 200, 80, 10, 20, 40, 550, 600, 40, 1000, 2000, 2000])
given d3_t_setup ([5, 15, 0, 205, 215, 80, 55, 65, 40, 4000, 5000, 6000], 0):() then d3_t_clp:([205, 215, 80, 55, 65, 40, 105, 115, 40, 5000, 6000, 4500])

