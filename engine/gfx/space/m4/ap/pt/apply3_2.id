// The rest of m4_apply3 -- the y and z rows -- split out to keep it under
// the action limit.

m4_apply3_b(int[] mat, int[] tri, int i, int x, int y, int z) {
  int p1 = m4_pt(mat, 4, x, y, z);
  lset(tri, i + 1, p1);
  m4_apply3_c(mat, tri, i, x, y, z);
} return void;
([1000,0,0,0,0,1000,0,0,0,0,1000,0,0,0,0,1000], [0,0,0,0,0,0], 0, 1000, 2000, 3000):([1000,0,0,0,0,1000,0,0,0,0,1000,0,0,0,0,1000], [0,2000,3000,0,0,0])
([1000,0,0,100,0,1000,0,200,0,0,1000,300,0,0,0,1000], [9,9,9,9,9,9], 3, 0, 0, 0):([1000,0,0,100,0,1000,0,200,0,0,1000,300,0,0,0,1000], [9,9,9,9,200,300])

m4_apply3_c(int[] mat, int[] tri, int i, int x, int y, int z) {
  int p2 = m4_pt(mat, 8, x, y, z);
  lset(tri, i + 2, p2);
} return void;
([1000,0,0,0,0,1000,0,0,0,0,1000,0,0,0,0,1000], [0,0,0,0,0,0], 0, 1000, 2000, 3000):([1000,0,0,0,0,1000,0,0,0,0,1000,0,0,0,0,1000], [0,0,3000,0,0,0])
([2000,0,0,0,0,2000,0,0,0,0,2000,0,0,0,0,1000], [9,9,9,9,9,9], 3, -100, 50, 25):([2000,0,0,0,0,2000,0,0,0,0,2000,0,0,0,0,1000], [9,9,9,9,9,50])
