// The two inner loops.
//
// Both walk an inclusive index range that is already inside the surface, so
// neither tests a coordinate; the only test is the depth one, and it guards the
// write rather than the loop, because a pixel that fails it still has to advance
// every interpolant.
//
// `dz > zb[i]` and not `>=`: equal depths keep whatever was drawn first, which is
// what makes two intersecting models render identically in either order -- a
// `>=` would let the later one win every tie and make draw order visible along
// the intersection.

d3_row(int[] fb, int[] zb, int i, int n, int c, int dz, int dzs) {
  while (i <= n) {
    if (dz > zb[i]) {
      fb[i] = c;
      zb[i] = dz;
    }
    i = i + 1;
    dz = dz + dzs;
  }
} return void;
([0, 0, 0, 0], [0, 0, 0, 0], 0, 2, 7, 10, 5):([7, 7, 7, 0], [10, 15, 20, 0])
([3], [100], 0, 0, 99, 100, 1000):([3], [100])

d3_row_g(int[] fb, int[] zb, int i, int n, int dz, int dzs, int[] xs) {
  while (i <= n) {
    d3_gpx(fb, zb, i, dz, xs);
    i = i + 1;
    dz = dz + dzs;
  }
} return void;
([0], [0], 0, 0, 100, 50, [65280, 65280, 65280, 10, 20, 30]):([16777215], [100], 0, 0, 100, 50, [65290, 65300, 65310, 10, 20, 30])
([3], [100], 0, 0, 100, 999, [1, 2, 3, 4, 5, 6]):([3], [100], 0, 0, 100, 999, [5, 7, 9, 4, 5, 6])

d3_gpx(int[] fb, int[] zb, int i, int dz, int[] xs) {
  if (dz > zb[i]) {
    d3_gput(fb, zb, i, dz, xs);
  }
  d3_gstep(xs);
} return void;
([0], [0], 0, 50, [65280, 65280, 65280, 1, 1, 1]):([16777215], [50], 0, 50, [65281, 65281, 65281, 1, 1, 1])
([7], [20], 0, 20, [100, 200, 300, -1, -2, -3]):([7], [20], 0, 20, [99, 198, 297, -1, -2, -3])
