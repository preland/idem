d3_span3_b(int y, int[] st, int t, int cl) {
  int i = sf_idx(st[0] + cl, y);
  int xmax = fx_min(st[6], (import d3_vp)[2]);
  d3_span3_c(y, st, t, i, xmax);
} return void;
