// The rest of d3_tri2 -- the two halves' y ranges -- split out to keep it
// under the action limit.

d3_tri2_b(int[] verts, int y0) {
  int y1 = fx_min(verts[7] - 1, (import d3_vp)[3]);
  d3_half(verts, y0, y1, 0, 12, 0, 6);
  d3_tri2_c(verts);
} return void;
given d3_t_setup ([1, 2, 3, 4, 5, 6, 7, 100, 9, 10, 11, 12, 13, 150, 15, 16, 17, 18], 48):([1, 2, 3, 4, 5, 6, 7, 100, 9, 10, 11, 12, 13, 150, 15, 16, 17, 18], 48)
given d3_t_setup ([21, 22, 23, 24, 25, 26, 27, -10, 29, 30, 31, 32, 33, -5, 35, 36, 37, 38], 0):([21, 22, 23, 24, 25, 26, 27, -10, 29, 30, 31, 32, 33, -5, 35, 36, 37, 38], 0)

d3_tri2_c(int[] verts) {
  int y2 = fx_max(verts[7], (import d3_vp)[1]);
  int y3 = fx_min(verts[13], (import d3_vp)[3]);
  d3_half(verts, y2, y3, 0, 12, 6, 12);
} return void;
given d3_t_setup ([1, 2, 3, 4, 5, 6, 7, 100, 9, 10, 11, 12, 13, 150, 15, 16, 17, 18]):([1, 2, 3, 4, 5, 6, 7, 100, 9, 10, 11, 12, 13, 150, 15, 16, 17, 18])
given d3_t_setup ([21, 22, 23, 24, 25, 26, 27, -10, 29, 30, 31, 32, 33, -5, 35, 36, 37, 38]):([21, 22, 23, 24, 25, 26, 27, -10, 29, 30, 31, 32, 33, -5, 35, 36, 37, 38])
