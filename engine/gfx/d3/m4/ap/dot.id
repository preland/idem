// One entry of a product, one wide multiply, and the cotangent.
//
// m4_wmul is the whole trick: `a * b` on two ints is an int multiply that wraps
// before anything sees it -- the operands decide the width, not the target -- so
// one operand is put in a `word` first and the product comes back 64-bit.
// Every product in this module goes through it.

m4_dot(int[] xs, int[] ys, int i, int j) {
  word wp = 0;
  int k = 0;
  while (k < 4) {
    wp = wp + m4_wmul(xs[i * 4 + k], ys[k * 4 + j]);
    k = k + 1;
  }
  int ret_i = wp / 1000;
} return int ret_i;

m4_wmul(int a, int b) {
  word wp = a;
  word ret_w = wp * b;
} return word ret_w;

// cot(deg) x1000, for a projection's focal term. deg is millidegrees; a quarter
// turn gives 0 and anything approaching zero gives a huge number, so callers
// pass half of a field of view that is comfortably inside (0, 180) degrees.
// fx_div answers 0 rather than dividing by zero, so a 180-degree fov degrades to
// a flat matrix instead of a core dump.
m4_cot(int deg) {
  int fx_cos_v = fx_cos(deg);
  int fx_sin_v = fx_sin(deg);
  int ret_i = fx_div(fx_cos_v, fx_sin_v, 1000);
} return int ret_i;
