// Where an edge crosses the near plane.
//
// t is the fraction along i -> k at which z reaches the plane, in 1/65536 -- the
// same 16-bit parameter the scanline interpolator uses, and for the same reason:
// per-mille rounding on a coordinate in the millions is visible as a wobble in
// the clipped edge.
//
// One endpoint is in front of the plane and the other behind it, so the
// denominator cannot be zero; fx_div answers 0 rather than dividing by one
// anyway, which keeps a degenerate triangle a degenerate triangle instead of an
// aborted process.
//
// The new z is *assigned* the plane's value rather than interpolated. Rounding
// the interpolation could put it a millunit behind the plane, and a vertex behind
// the near plane is the one thing the whole clip exists to prevent -- it would
// reach d3_tri, where the depth key is 2^36/z and z is trusted.

d3_ncut(int[] tri, int i, int k, int j) {
  d3_ncut6(tri, i, k, j,
           fx_div((import d3_cam)[5] - tri[i * 3 + 2], tri[k * 3 + 2] - tri[i * 3 + 2], 65536));
} return void;

d3_ncut6(int[] tri, int i, int k, int j, int t) {
  lset((import d3_clp), j * 3, d3_mix(tri[i * 3], tri[k * 3], t));
  lset((import d3_clp), j * 3 + 1, d3_mix(tri[i * 3 + 1], tri[k * 3 + 1], t));
  d3_ncut3(tri, i, k, j, t);
} return void;

d3_ncut3(int[] tri, int i, int k, int j, int t) {
  lset((import d3_clp), j * 3 + 2, (import d3_cam)[5]);
  lset((import d3_clp), 9 + j, d3_cmix(tri[9 + i], tri[9 + k], t));
} return void;
