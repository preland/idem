// The Gouraud accumulator, and the flat span loop.
//
// d3_gs is seven slots: the three colour channels x256, their three per-pixel
// steps, and the flat colour (or -1) in slot 6. It is filled once per span, at
// the clipped left end -- the same re-interpolation the depth uses, for the same
// reason: multiplying a step by two million clipped pixels overflows.
//
// d3_row is the engine's hot loop and the reason a software rasteriser is viable
// here at all. Its body is exactly three actions, which is a block's whole budget:
// the depth test, the index bump, and the depth step. fb and zb are list
// PARAMETERS, so `fb[i] = c` compiles to a direct indexed store with no call and
// no global read -- ten times faster than sf_pset per pixel, which is what buys
// the 30-290x overdraw a z-buffered pipeline spends.

d3_gs_init(int[] st, int t) {
  d3_gs_c(st, t);
  d3_gs_st(st);
} return void;

d3_gs_c(int[] st, int t) {
  int d3_mix_v = d3_mix(st[3], st[9], t);
  lset((import d3_gs), 0, d3_mix_v * 256);
  int d3_mix_v2 = d3_mix(st[4], st[10], t);
  lset((import d3_gs), 1, d3_mix_v2 * 256);
  int d3_mix_v3 = d3_mix(st[5], st[11], t);
  lset((import d3_gs), 2, d3_mix_v3 * 256);
} return void;

d3_gs_st(int[] st) {
  lset((import d3_gs), 3, st[13]);
  lset((import d3_gs), 4, st[14]);
  lset((import d3_gs), 5, st[15]);
} return void;
