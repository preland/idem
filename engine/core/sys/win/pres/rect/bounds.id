// The stage as a pixel rect. A 2D game draws its plane at (sys_sx, sys_sy) sized
// sys_sw by sys_sh, and everything inside it is in the units the game declared.

sys_sw() {
  int w = (import sys_vp)[3] * (import sys_vp)[0] / 1000;
} return int w;

sys_sh() {
  int h = (import sys_vp)[4] * (import sys_vp)[0] / 1000;
} return int h;

sys_sx() {
  int x = (import sys_vp)[1];
} return int x;
