// The other two columns, and clearing them.

err_keep2(int ln, string msg) {
  push((import err_ls), ln);
  push((import err_ms), msg);
} return void;

// A reload starts again. The count goes with them: a pane showing sixteen stale
// diagnostics beside a document that now parses is worse than showing none.
err_clear() {
  lset((import err_n), 0, 0);
  err_drop();
} return void;

err_drop() {
  while (len((import err_ms)) > 0) {
    pop((import err_fs));
    err_drop2();
  }
} return void;
