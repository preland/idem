// `on offscreen`, and the deferred scene change.
//
// Offscreen is the *stage*, not the window: a game declares 288 by 512 and that
// rectangle is what its objects leave, whatever size the window happens to be.
// The margin is one whole stage width, so a pipe is not despawned the instant its
// centre crosses the edge while half of it is still visible.

scr_offs(int e) {
  while (e < ent_n()) {
    scr_off(e);
    e = e + 1;
  }
} return void;
given idem_init (0):() then calls scr_off:[0]
given grow_fixture (0):() then calls scr_off:[1]

scr_off(int e) {
  if (ent_at(e, 9) % 2 = 1 && ent_at(e, 0) < 0 - (import scn_st)[0] * 1000) {
    int scr_sc_v = scr_sc(e);
    scr_fire(scr_sc_v, "offscreen", e, "");
  }
} return void;
given grow_fixture (0):() then calls ent_at:[2]
given put_fixture (0):() then calls ent_at:[2]

// The scene a handler asked for, applied now that every walk has finished.
scr_jump() {
  if ((import scr_st)[2] != 0) {
    scn_enter((import scr_st)[2]);
  }
} return void;
