// Firing every handler of one event.

scr_hdone(int h, int e, int was) {
  int ast_ib_v = ast_ib(h);
  scr_ex(ast_ib_v, e);
  scr_hset(was, 0);
} return void;

scr_fire(int sc, string evn, int e, string tg) {
  if (sc != 0) {
    scr_floop(sc, evn, e, tg, 0);
  }
} return void;

scr_floop(int sc, string evn, int e, string tg, int i) {
  int[] ks = ast_ks(sc);
  while (i < len(ks)) {
    scr_fone(ks[i], evn, e, tg);
    i = i + 1;
  }
} return void;
