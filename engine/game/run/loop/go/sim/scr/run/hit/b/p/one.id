// One entity's share of a key event.

scr_pent(string evn, int e) {
  if (ent_at(e, 9) % 2 = 1) {
    scr_fire(scr_sc(e), evn, e, "");
  }
} return void;

scr_ovl_tail(int a, int b) {
  int a0 = ent_at(a, 0);
  int a12 = ent_at(a, 12);
  int b0 = ent_at(b, 0);
  int b12 = ent_at(b, 12);
  int a1 = ent_at(a, 1);
  int a13 = ent_at(a, 13);
  int b1 = ent_at(b, 1);
  int b13 = ent_at(b, 13);
  int sx = scr_span(a0, a12, b0, b12);
  int sy = scr_span(a1, a13, b1, b13);
  int v = sx = 1 && sy = 1;
} return int v;

scr_span_tail(int ac, int aw, int bc, int bw) {
  int diff = ac - bc;
  int abs_diff = fx_abs(diff);
  int lhs = abs_diff * 2;
  int rhs = aw + bw;
  int span_val = lhs <= rhs;
} return int span_val;
