// Timers, the deferred scene change, and offscreen.
//
// A timer is per script and accumulates in whole frames, so `on timer 1400` at
// sixty frames a second fires every 87 or 88 frames rather than on a fractional
// one. The remainder is carried, not discarded: dropping it would make a 1400 ms
// timer fire every 1408 ms, and over a minute that is a pipe's worth of drift.

scr_tick(int dt) {
  lset((import scn_st), 12, (import scn_st)[12] + dt);
  scr_tfire(0 - 1, (import scn_st)[12]);
  scr_tents(0, dt);
} return void;

scr_tents(int e, int dt) {
  while (e < ent_n()) {
    scr_tent(e, dt);
    e = e + 1;
  }
} return void;

scr_tent(int e, int dt) {
  int ent_at_v = ent_at(e, 22);
  ent_put(e, 22, ent_at_v + dt);
  int ent_at_v2 = ent_at(e, 21);
  ent_put(e, 21, ent_at_v2 + dt);
  int ent_at_v3 = ent_at(e, 21);
  scr_tfire(e, ent_at_v3);
} return void;
