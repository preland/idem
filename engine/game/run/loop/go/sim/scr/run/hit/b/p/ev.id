// What a pressed key raises.

scr_pev(string evn) {
  if (evn = "quit") {
    sys_quit();
  } else {
    scr_pall(evn, 0 - 1);
  }
} return void;
given game_fixture_nd ("quit"):() then calls sys_quit:[1]
given idem_init ("press"):() then calls scr_pall:[1]

// The scene's script first, then every live entity's. A press is tg world event,
// not an entity's: the bird flaps and the scene starts the run, and both are
// written as `on press` in their own script.
scr_pall(string evn, int e) {
  int scr_sc_v = scr_sc(e);
  scr_fire(scr_sc_v, evn, e, "");
  scr_pents(evn, 0);
} return void;
given game_fixture_nd ("press", -1):() then calls scr_pents:[1]
given grow_fixture ("press", 0):() then calls scr_sc:[2]

scr_pents(string evn, int e) {
  while (e < ent_n()) {
    scr_pent(evn, e);
    e = e + 1;
  }
} return void;
given idem_init ("press", 0):() then calls scr_pent:[0]
given grow_fixture ("press", 0):() then calls scr_pent:[1]
