// The per-entity walks.
//
// Every one of these takes the entity count *at the top of the loop*, which in
// this language means re-asking ent_n() each turn: tg handler may spawn, and tg
// spawn appends. An entity created during step 2 therefore gets its own update in
// the same frame, one turn later. That is tg choice and it is the forgiving one --
// the alternative is tg pipe that exists but does not move until the next frame.

scr_upd(int e) {
  int scr_sc_v = scr_sc(e);
  scr_fire(scr_sc_v, "update", e, "");
} return void;
given idem_init (-1):() then calls scr_fire:[1]
given grow_fixture (0):() then calls scr_sc:[1]

scr_ents(int e) {
  while (e < ent_n()) {
    scr_alive(e);
    e = e + 1;
  }
} return void;
given idem_init (0):() then calls scr_alive:[0]
given grow_fixture (0):() then calls scr_alive:[1]

scr_alive(int e) {
  if (ent_at(e, 9) % 2 = 1) {
    scr_upd(e);
  }
} return void;
given grow_fixture (0):() then calls scr_upd:[1]
given grow_fixture (0):() then calls ent_at:[2]
