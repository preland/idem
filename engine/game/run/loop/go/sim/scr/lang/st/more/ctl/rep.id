// `repeat n { … }` -- a count, evaluated once before the loop.
//
// Once, and not per turn: `repeat count(enemy) { spawn … }` would otherwise
// re-ask a question the loop is changing the answer to, and the reading everyone
// expects from `repeat` is "this many times".

scr_ex5(int nd, int e) {
  int fin = 0;
  if (ast_kd(nd) = ast_k_repeat()) {
    fin = scr_rep(nd, e, fx_min(scr_ev(ast_ia(nd), e), 10000));
  } else {
    fin = scr_ex6(nd, e);
  }
} return int fin;

scr_rep(int nd, int e, int n) {
  int fin = 0;
  int i = 0;
  fin = scr_rloop(nd, e, n, i);
} return int fin;

scr_rloop(int nd, int e, int n, int i) {
  int fin = 0;
  while (fin = 0 && i < n) {
    fin = scr_ex(ast_ib(nd), e);
    i = i + 1;
  }
} return int fin;
