// Unary operators, and a bare name.

scr_un(string op, int v) {
  int r = 0 - v;
  if (op = "!") { r = v = 0; }
  else if (op = "~") { r = 0 - v - 1; }
} return int r;
("-", 5):(-5)
("~", 5):(-6)

// scr_ev6's operand, evaluated before the unary op is looked up.
scr_unrhs(int nd, int e) {
  int ia = ast_ia(nd);
  int rhs = scr_ev(ia, e);
} return int rhs;
given un_fixture ((import fixture_un), -1):(42)
given idem_init (0, -1):(0) then calls scr_ev:(0, -1)

// A bare identifier. Almost always a variable; `time` is the exception, and it is
// one because every game wants the clock and none of them should have to declare
// it. It is milliseconds since the scene loaded, which is what a `sin(time * n)`
// bob is written against.
scr_name(int nd, int e) {
  string ast_tx_v = ast_tx(nd);
  int v = scr_get(e, ast_tx_v);
  if (ast_tx(nd) = "time") { v = (import sim_st)[0]; }
} return int v;
given ident_fixture ((import fixture_ident), -1):(1)
given ident_fixture ((import fixture_time), -1):(0) then calls scr_get:[1]
