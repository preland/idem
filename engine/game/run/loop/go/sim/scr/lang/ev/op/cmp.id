// Remainder, equality, and the order comparisons.

scr_op3(string op, int a, int b) {
  int v = scr_op4(op, a, b);
  if (op = "%") { v = scr_mod(a, b); }
  else if (op = "=" || op = "==") { v = a = b; }
} return int v;
("%", 7, 3):(1)
("==", 5, 5):(1)

scr_op4(string op, int a, int b) {
  int v = scr_op5(op, a, b);
  if (op = "!=") { v = a != b; }
  else if (op = "<") { v = a < b; }
} return int v;
("!=", 5, 3):(1)
("<", 3, 5):(1)

scr_op5(string op, int a, int b) {
  int v = scr_op6(op, a, b);
  if (op = ">") { v = a > b; }
  else if (op = "<=") { v = a <= b; }
} return int v;
(">", 5, 3):(1)
("<=", 3, 3):(1)
