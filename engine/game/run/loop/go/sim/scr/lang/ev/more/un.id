// Unary operators, and a bare name.

scr_un(string op, int v) {
  int r = 0 - v;
  if (op = "!") { r = v = 0; }
  else if (op = "~") { r = 0 - v - 1; }
} return int r;

// A bare identifier. Almost always a variable; `time` is the exception, and it is
// one because every game wants the clock and none of them should have to declare
// it. It is milliseconds since the scene loaded, which is what a `sin(time * n)`
// bob is written against.
scr_name(int nd, int e) {
  int v = scr_get(e, ast_tx(nd));
  if (ast_tx(nd) = "time") { v = (import sim_st)[0]; }
} return int v;
