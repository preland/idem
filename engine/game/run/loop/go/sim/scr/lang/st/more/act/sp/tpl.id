// Finding a template, and one member of a spawn's tuple.

scr_tpl(string name) {
  int nd = 0;
  int i = 0;
  nd = scr_tscan(name, i, nd);
} return int nd;

scr_tscan(string name, int i, int nd) {
  while (i < len((import scr_pn))) {
    nd = scr_tpick(nd, i, (import scr_pn)[i] = name);
    i = i + 1;
  }
} return int nd;

scr_tpick(int nd, int i, int hit) {
  int v = nd;
  if (hit = 1 && nd = 0) { v = (import scr_pd)[i]; }
} return int v;
