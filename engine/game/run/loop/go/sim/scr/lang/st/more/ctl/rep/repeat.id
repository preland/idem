scr_rloop(int nd, int e, int n, int i) {
  int fin = 0;
  while (fin = 0 && i < n) {
    int ast_ib_v = ast_ib(nd);
    fin = scr_ex(ast_ib_v, e);
    i = i + 1;
  }
} return int fin;
