// Variables: three scopes in one flat table.
//
// A lookup walks the entity's own run, then the scene's, then the game's, and
// answers the first match -- which is what makes `scene.mode` and a bare `mode`
// name the same cell when an entity has no `mode` of its own, and different cells
// when it has.
//
// Linear scans over a handful of names. A game has tens of variables, not
// thousands, and a hash table would be more code than the frame budget asks for;
// the scan is bounded by the *block*, not by the whole table.

// e is -1 when a scene's own script is running, and -1 is not an index: the
// entity block has to be skipped rather than read, or the very first lookup in
// `on timer` reaches record minus one. scr_eb answers an empty range for it.
scr_find(int e, string name) {
  int scr_eb_v = scr_eb(e, 17);
  int scr_eb_v2 = scr_eb(e, 17);
  int scr_eb_v3 = scr_eb(e, 18);
  int i = scr_scan(scr_eb_v, scr_eb_v2 + scr_eb_v3, name);
  if (i < 0) { i = scr_sfind(name); }
} return int i;

// The scene's block, then the game's. Separated from scr_find so that an entity
// with no vars at all -- and the scene itself, which is `self` -1 -- reaches it
// without a special case.
scr_sfind(string name) {
  int i = scr_scan((import scn_st)[10], (import scn_st)[10] + (import scn_st)[11], name);
  if (i < 0) { i = scr_scan(0, (import scr_st)[4], name); }
} return int i;

// -1 for an unknown name, which every reader turns into 0 and every writer into
// a diagnostic. A script that misspells a variable must not silently create one:
// that is the class of bug a game ships with.
scr_scan(int i, int n, string name) {
  int at = 0 - 1;
  while (i < n) {
    at = lst_pick(at, i, (import scr_vn)[i] = name);
    i = i + 1;
  }
} return int at;
