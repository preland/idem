// The rest of the expression kinds.

scr_ev4(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_field()) {
    v = scr_fld(nd, e);
  } else {
    v = scr_ev5(nd, e);
  }
} return int v;

scr_ev5(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_call()) {
    v = scr_call(nd, e);
  } else {
    v = scr_ev6(nd, e);
  }
} return int v;

// Unary minus and `!`. `~` is the parser's too but no game has wanted one.
scr_ev6(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_un()) {
    v = scr_un(ast_tx(nd), scr_ev(ast_ia(nd), e));
  }
} return int v;
