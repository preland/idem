// The rest of the expression kinds.

scr_ev4(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_field()) {
    v = scr_fld(nd, e);
  } else {
    v = scr_ev5(nd, e);
  }
} return int v;

scr_ev5(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_call()) {
    v = scr_call(nd, e);
  } else {
    v = scr_ev6(nd, e);
  }
} return int v;

// Unary minus and `!`. `~` is the parser's too but no game has wanted one.
scr_ev6(int nd, int e) {
  int v = 0;
  if (ast_kd(nd) = ast_k_un()) {
    string ast_tx_v = ast_tx(nd);
    int ast_ia_v = ast_ia(nd);
    int scr_ev_v = scr_ev(ast_ia_v, e);
    v = scr_un(ast_tx_v, scr_ev_v);
  }
} return int v;
