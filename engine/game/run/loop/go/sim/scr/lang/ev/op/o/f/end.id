// The end of the chain, and the diagnostic that lives there.
//
// A script that calls a builtin this engine does not have reads as mysteriously
// inert otherwise -- the expression is 0, the entity does not move, and nothing
// says why. One sentence at load turns an afternoon into a line number.

scr_fn5(string name, int a, int b) {
  int v = 0;
  if (name = "min") { v = fx_min(a, b); }
  else { v = scr_fn6(name, a, b); }
} return int v;

scr_fn6(string name, int a, int b) {
  int v = 0;
  if (name = "max") { v = fx_max(a, b); }
  else { v = scr_fn7(name, a, b); }
} return int v;

// `key(code)` is 1 while that key is held. It is the one input question a script
// cannot ask any other way: `on press` is an edge, and a paddle that moves while
// a key is down needs the level. The code is the engine's own -- an ASCII byte
// for a key that makes a character, 256..259 for the arrows (engine/core/sys/inp).
scr_fn7(string name, int a, int b) {
  int v = 0;
  if (name = "key") { v = inp_down(a); }
  else { err_report("script", 0, "unknown function " + chr(39) + name + chr(39)); }
} return int v;
