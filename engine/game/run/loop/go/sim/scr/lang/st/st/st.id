// Executing a statement.
//
// Status, not control flow: `id` has no `break` and no early return, so a
// statement answers 0 for "keep going" and 1 for "this handler is finished", and
// every sequence folds that. `stop` and `despawn` both produce a 1, which is what
// makes them cut a handler short without the language having a way to.
//
// The status lives in scr_st[1] as well as being returned, because an assignment
// nested three expressions deep inside a `while` has no return path back out.

scr_ex(int nd, int e) {
  int fin = (import scr_st)[1];
  if (fin = 0) { fin = scr_ex1(nd, e); }
} return int fin;

scr_ex1(int nd, int e) {
  int fin = 0;
  if (ast_kd(nd) = (import ast_k_assign)) {
    int ia = ast_ia(nd);
    int rhs = scr_ex1v(nd, e);
    scr_asg(ia, rhs, e);
  } else {
    fin = scr_ex2(nd, e);
  }
} return int fin;

// A block is a node whose kids are its statements, and it is the only kind that
// folds a status out of more than one thing.
scr_ex2(int nd, int e) {
  int fin = 0;
  if (ast_kd(nd) = (import ast_k_block)) {
    fin = scr_seq(nd, e, 0);
  } else {
    fin = scr_ex3(nd, e);
  }
} return int fin;
