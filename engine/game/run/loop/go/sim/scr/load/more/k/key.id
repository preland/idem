// A key's name, as the code inp_ reports.
//
// Single-character names are their own ASCII, lowercased, which covers the whole
// alphabet and the digits in one line rather than in thirty-six. The rest are
// named because they have no character: the codes are backends/gfx's own (the
// key-code block in gfx.h), and the arrows start at 256 because 0..255 is where
// the characters live.

scr_kcode(string name) {
  int c = scr_knamed(name);
  if (len(name) = 1) { c = scr_klower(charat(name, 0)); }
} return int c;

scr_klower(int c) {
  int v = c;
  if (c >= 65 && c <= 90) { v = c + 32; }
} return int v;

scr_knamed(string name) {
  int c = scr_knamed2(name);
  if (name = "space") { c = 32; }
  else if (name = "enter" || name = "return") { c = 13; }
} return int c;
