// Scanning the document for a scene of a given name, and emptying the world.

scn_bfind(int doc, string name, int i) {
  int nd = 0;
  int[] ks = ast_ks(doc);
  while (i < len(ks) && nd = 0) {
    nd = scn_bone(ks[i], name);
    i = i + 1;
  }
} return int nd;
