// The event a binding names, and the game's persistent variables.

// `space = press` -- the value is the binding's one child, an identifier. A
// binding with no value raises nothing.
scr_kev(int nd) {
  string s = "";
  if (len(ast_ks(nd)) > 0) { s = ast_tx(ast_ks(nd)[0]); }
} return string s;

// `persist { high = 0 }`. These are the game's own variables: declared once,
// before any scene, and never truncated by a scene change -- which is the whole
// difference between them and a scene's `var`. The initialiser is a token rather
// than an expression (par_kv), so it is read as digits.
scr_persist(int nd, int i) {
  while (i < len(ast_ks(nd))) {
    scr_p1(ast_ks(nd)[i]);
    i = i + 1;
  }
  lset((import scr_st), 4, len((import scr_vv)));
} return void;

scr_p1(int nd) {
  scr_push(ast_tx(nd), scr_kev2(nd));
} return void;
