// A scene's own variables and script, and an entity's.
//
// A scene load truncates the variable table back to the game's block and then
// declares the scene's `var`s, so entering a scene twice -- which is how flappy
// restarts a run -- starts from the declared values rather than from wherever the
// last run left them.

scn_svars(int nd, int i) {
  scr_reset();
  lset((import scn_st), 10, len((import scr_vv)));
  scn_svars2(nd, i);
} return void;

scn_svars2(int nd, int i) {
  while (i < len(ast_ks(nd))) {
    scn_svar(ast_ks(nd)[i]);
    i = i + 1;
  }
  lset((import scn_st), 11, len((import scr_vv)) - (import scn_st)[10]);
} return void;

// A scene member and an entity member declare variables the same way, so both go
// through scr_dmem and neither knows how a binding is spelled.
scn_svar(int nd) {
  scr_dmem(nd);
} return void;
