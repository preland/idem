// The tag registry.
//
// A tag is an index into scr_tn and a bit in every entity's slot 20, so a game
// may declare at most 31 distinct tags -- an int's worth, less the sign. That is
// far more than any game here uses and the limit is written down rather than
// discovered: the 32nd tag would silently share a bit with the 1st.
//
// Registration is on first use, which is why there is no `tags` declaration: the
// set of tags in a game is exactly the set that appears in it.

scr_tag(string name) {
  int i = scr_tfind(name, 0);
  if (i < 0) { i = scr_tadd(name); }
} return int i;

scr_tfind(string name, int i) {
  int at = 0 - 1;
  while (i < len((import scr_tn))) {
    at = lst_pick(at, i, (import scr_tn)[i] = name);
    i = i + 1;
  }
} return int at;

scr_tadd(string name) {
  int len_v = len((import scr_tn));
  int i = fx_min(len_v, 30);
  push((import scr_tn), name);
} return int i;
