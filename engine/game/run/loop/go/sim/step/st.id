// The clock, gravity, and the integration step.

sim_init() {
  export int[] sim_st = [0];
} return void;

// A body that is not solid is the only thing that falls. A solid body is world
// geometry -- a floor, a wall, a pipe -- and something with no body at all is
// decoration that moves under its own velocity if it has one.
sim_grav(int e, int dt) {
  if (ent_at(e, 9) % 8 = 5) {
    int ent_at_v = ent_at(e, 3);
    ent_put(e, 3, ent_at_v + (import scn_st)[8] * dt / 1000);
  }
} return void;

// Velocity is millunits per second and dt is milliseconds, so the product needs
// dividing by a thousand and the position is already in millunits.
sim_move(int e, int dt) {
  int ent_at_v = ent_at(e, 0);
  int ent_at_v2 = ent_at(e, 2);
  ent_put(e, 0, ent_at_v + ent_at_v2 * dt / 1000);
  int ent_at_v3 = ent_at(e, 1);
  int ent_at_v4 = ent_at(e, 3);
  ent_put(e, 1, ent_at_v3 + ent_at_v4 * dt / 1000);
} return void;
