// The window loop and the headless shot.

idem_aloop(int alive) {
  while (alive = 1) {
    alive = idem_aframe();
  }
} return void;

idem_aframe() {
  int t = sys_now();
  idem_astep();
  idem_apace(t);
  int ret_i = sys_alive();
} return int ret_i;

idem_apace(int t) {
  func(int) return int gs = (import eng_stage);
  sys_present();
  int gs_v = gs(3);
  int fx_max_v = fx_max(gs_v, 1);
  sys_pace(t, fx_max_v);
} return void;
