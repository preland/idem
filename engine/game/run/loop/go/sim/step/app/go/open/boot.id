// Bringing the game up, and the window with it.
//
// g_init before sys_open, because the size the window asks for is the game's to
// state and it has to exist to be asked. The window is a *request*: the window
// manager decides, sys_ follows it, and the stage maps the game's declared units
// into whatever it gets.
//
// g_init and g_stage are read once, here, as the function values eng_seam
// stored (app/entry.id).

idem_aopen() {
  func() return void gi = (import eng_init);
  func(int) return int gs = (import eng_stage);
  idem_aopen1(gi, gs);
} return void;
given seam_fixture ():() then calls idem_aopen1:(stub_ginit, stub_gstage)
given seam_fixture given idem_init ():() then calls idem_aopen1:(stub_ginit, stub_gstage)

idem_aopen1(func() return void gi, func(int) return int gs) {
  gi();
  idem_aopen1b(gs);
} return void;
(stub_ginit, stub_gstage):() then prints:("ginit\n") then calls idem_aopen1b:(stub_gstage)
(idem_init, fx_abs):() then calls idem_aopen1b:(fx_abs)

// Input last, because it sizes nothing and needs the surface to exist before it
// clamps a pointer against it.
idem_aopen2() {
  txt_init();
  inp_init();
  tin_init();
} return void;
