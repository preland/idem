// N frames to stdout as a PPM, with no display. Only the last one survives, so
// `--shot 60` is a picture of the world after a second rather than of frame 60
// drawn over frame 1.

idem_ashot(int n) {
  ppm_init();
  idem_ashots(n, 0);
  ppm_dump();
} return void;
given seam_fixture given game_fixture_nd given ui_pinit (1):() then calls idem_ashots:(1, 0)
given seam_fixture given game_fixture_nd given ui_pinit (0):() then calls ppm_dump:[1]

idem_ashots(int n, int i) {
  while (i < n) {
    idem_astep();
    i = i + 1;
  }
} return void;
given seam_fixture given game_fixture_nd given ui_pinit (0, 0):() then calls idem_astep:[0]
given seam_fixture given game_fixture_nd given ui_pinit (1, 0):() then calls idem_astep:[1]

// The page's item tree, found once at load.
ui_pinit() {
  export int[] ui_pg = [0];
} return void;
():() then read_ui_pg0:(0)
