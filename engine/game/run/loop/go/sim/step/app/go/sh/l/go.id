// The two ways of running.

idem_ago(int argc, string[] argv) {
  int n = err_count();
  idem_ago2(argc, argv);
} return int n;

idem_ago2(int argc, string[] argv) {
  if (argc > 1) {
    idem_ashot(fx_max(shot_n(argc, argv), 1));
  } else {
    idem_aloop(1);
  }
  gfx_close();
} return void;

// idem_app's own three actions, moved here because app.id -- its home file and
// directory -- is already at the 3-function, 3-entry caps app.id's own header
// describes as saturated. Unrelated to "the two ways of running" above; here
// only because this file had a spare slot and the chain does not.
idem_app2(string[] chunks, int argc, string[] argv) {
  idem_init();
  idem_pre(argc, argv);
  idem_alay(run_join(chunks, 0, ""));
} return void;
