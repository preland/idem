// The two ways a game runs: a window, or a fixed number of frames to stdout.
//
// Nothing else may reach stdout in shot mode -- there is no stderr in this
// language, so one stray print corrupts the image (NAMES.md 6). That is also why
// diagnostics are counted rather than printed during a frame.
//
// `--shot` renders one frame; `--shot 30` simulates thirty and writes the last.
// That is not a convenience. One frame shows what a scene *declares*; thirty show
// what it *does* -- whether the ground scrolled, whether the bird fell, whether an
// animation advanced -- and the difference between those two is the whole of the
// simulation. Verifying it any other way needs a person watching a window.

idem_go(int argc, string[] argv) {
  int n = err_count();
  idem_go2(argc, argv);
} return int n;
given game_fixture_nd (2, ["prog", "x"]):(0) then calls idem_shot:(1)
given game_fixture_nd (2, ["prog", "5"]):(0) then calls idem_shot:(5)

idem_go2(int argc, string[] argv) {
  if (argc > 1) {
    int shot_n_v = shot_n(argc, argv);
    int fx_max_v = fx_max(shot_n_v, 1);
    idem_shot(fx_max_v);
  } else {
    idem_run();
  }
} return void;
given game_fixture_nd (2, ["prog", "x"]):() then calls idem_shot:(1)
given game_fixture_nd (2, ["prog", "5"]):() then calls idem_shot:(5)

idem_shot(int n) {
  ppm_init();
  shot_frames(n);
  ppm_dump();
} return void;
given game_fixture_nd (1):() then calls shot_frames:(1)
given game_fixture_nd (5):() then calls shot_frames:(5)
