// Appending one entity, and counting them.
//
// A new record is all zeros except the four fields whose zero is wrong: an unset
// sprite is -1 rather than sprite 0, an unset scale is 1000 rather than nothing,
// and a new entity is live.

ent_n() {
  int ret_i = len((import ent_r)) / 28;
} return int ret_i;

ent_add() {
  lst_fill((import ent_r), 28, 0);
  int ent_n_v = ent_n();
  ent_new(ent_n_v - 1);
  int ret_i = ent_n() - 1;
} return int ret_i;

ent_new(int e) {
  m4_pair((import ent_r), e * 28 + 4, e * 28 + 5, 1000, 1000);
  m4_pair((import ent_r), e * 28 + 6, e * 28 + 9, 0 - 1, 1);
  m4_pair((import ent_r), e * 28 + 15, e * 28 + 16, 0 - 1, 100);
} return void;
