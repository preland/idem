// What an entity shows: a sprite, or a shape.

ent_show(int e) {
  if (ent_at(e, 6) >= 0) {
    int ent_at_v = ent_at(e, 6);
    ent_blit(ent_at_v, e);
  } else if (ent_at(e, 24) = 1) {
    ent_box(e);
  }
} return void;

// An entity's `shape box`, on the stage.
//
// Centred on `pos` like everything else, and scaled by the stage exactly as a
// sprite is -- so a paddle declared 10 by 60 is ten by sixty of the game's own
// units wherever it is drawn, in a window, in a zoomed editor panel, or in a
// letterboxed stage.

ent_box(int e) {
  int sys_sx_v = sys_sx();
  int ent_bx_v = ent_bx(e, 0, 25);
  int sys_sy_v = sys_sy();
  int ent_bx_v2 = ent_bx(e, 1, 26);
  int ent_bs_v = ent_bs(e, 25);
  int ent_bs_v2 = ent_bs(e, 26);
  int ent_at_v = ent_at(e, 27);
  sf_rect(sys_sx_v + ent_bx_v, sys_sy_v + ent_bx_v2, ent_bs_v, ent_bs_v2, ent_at_v);
} return void;
