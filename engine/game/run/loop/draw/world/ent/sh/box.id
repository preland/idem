// What an entity shows: a sprite, or a shape.

ent_show(int e) {
  if (ent_at(e, 6) >= 0) {
    ent_blit(ent_at(e, 6), e);
  } else if (ent_at(e, 24) = 1) {
    ent_box(e);
  }
} return void;

// An entity's `shape box`, on the stage.
//
// Centred on `pos` like everything else, and scaled by the stage exactly as a
// sprite is -- so a paddle declared 10 by 60 is ten by sixty of the game's own
// units wherever it is drawn, in a window, in a zoomed editor panel, or in a
// letterboxed stage.

ent_box(int e) {
  sf_rect(sys_sx() + ent_bx(e, 0, 25), sys_sy() + ent_bx(e, 1, 26), ent_bs(e, 25), ent_bs(e, 26), ent_at(e, 27));
} return void;
