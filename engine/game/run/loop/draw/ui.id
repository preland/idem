// The UI item, if the scene declared one.

run_ui2(int nd) {
  if (nd != 0) {
    lset((import ui_ts), 0, (import sys_vp)[0]);
    int sys_sx_v = sys_sx();
    int sys_sy_v = sys_sy();
    int sys_sw_v = sys_sw();
    int sys_sh_v = sys_sh();
    ui_draw(nd, sys_sx_v, sys_sy_v, sys_sw_v, sys_sh_v);
  }
} return void;

// A scene's `ui` member, by kind.
scn_ui(int nd, int i) {
  int u = 0;
  while (nd != 0 && i < len(ast_ks(nd))) {
    int[] ast_ks_v = ast_ks(nd);
    u = scn_ui2(u, ast_ks_v[i]);
    i = i + 1;
  }
} return int u;

scn_ui2(int u, int nd) {
  int v = u;
  if (ast_kd(nd) = ast_k_ui() && len(ast_ks(nd)) > 0) { v = ast_ks(nd)[0]; }
} return int v;
