// The UI item, if the scene declared one.

run_ui2(int nd) {
  if (nd != 0) {
    lset((import ui_ts), 0, (import sys_vp)[0]);
    ui_draw(nd, sys_sx(), sys_sy(), sys_sw(), sys_sh());
  }
} return void;

// A scene's `ui` member, by kind.
scn_ui(int nd, int i) {
  int u = 0;
  while (nd != 0 && i < len(ast_ks(nd))) {
    u = scn_ui2(u, ast_ks(nd)[i]);
    i = i + 1;
  }
} return int u;

scn_ui2(int u, int nd) {
  int v = u;
  if (ast_kd(nd) = ast_k_ui() && len(ast_ks(nd)) > 0) { v = ast_ks(nd)[0]; }
} return int v;
