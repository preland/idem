// A scene's `ui` member, by kind.
scn_ui(int nd, int i) {
  int u = 0;
  int[] ks = ast_ks(nd);
  while (nd != 0 && i < len(ks)) {
    u = scn_ui2(u, ks[i]);
    i = i + 1;
  }
} return int u;
