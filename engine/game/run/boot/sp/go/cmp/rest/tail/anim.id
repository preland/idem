// The wrap's upper bound and the animation.
//
// `anim (first, last, ms)` cycles frames first..last, one every ms. An entity
// with no anim keeps last = -1, which ent_anim reads as "hold frame 0" -- so a
// still sprite needs no flag of its own.

scn_efill7(int e, int nd) {
  int wx = scn_mtup(nd, "wrap", 1);
  ent_put(e, 11, wx * 1000);
  scn_efill_af(e, nd);
} return void;

scn_efill8(int e, int nd) {
  int al = scn_manim(nd, 1);
  ent_put(e, 15, al);
  scn_efill_ams(e, nd);
} return void;
