par_dtgt(int[] pos, int ln) {
  int nd = 0;
  if (par_kind(pos) = lex_k_ident() && par_line(pos) = ln) { nd = par_ident(pos); }
} return int nd;

par_goto(int[] pos) {
  par_next(pos);
  string name = par_text(pos);
  par_next(pos);
  int ast_k_goto_v = ast_k_goto();
  int ret_i = ast_new_k(ast_k_goto_v, name);
} return int ret_i;

par_play(int[] pos) {
  par_next(pos);
  string name = par_text(pos);
  par_next(pos);
  int ast_k_play_v = ast_k_play();
  int ret_i = ast_new_k(ast_k_play_v, name);
} return int ret_i;
