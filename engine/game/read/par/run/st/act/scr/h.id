par_h2(int[] pos, string name) {
  int arg = par_hopt(pos);
  int ret_i = par_h2_node(pos, name, arg);
} return int ret_i;

par_h2_node(int[] pos, string name, int arg) {
  int ast_k_on_v = (import ast_k_on);
  int par_block_v = par_block(pos);
  int ret_i = ast_new_ab(ast_k_on_v, name, arg, par_block_v);
} return int ret_i;

// `on key space`, `on hit enemy`, `on timer 500` take one argument; `on start`,
// `on update`, `on press`, `on offscreen`, `on death`, `on enter`, `on leave` take
// none. Recognised by shape -- whatever precedes the '{' is the argument -- so
// adding an event later needs no change here.
par_hopt(int[] pos) {
  int nd = 0;
  if (par_is(pos, "{") = 0 && par_kind(pos) != (import lex_k_eof)) { nd = par_arg(pos); }
} return int nd;
