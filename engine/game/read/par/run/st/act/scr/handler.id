par_script2(int[] pos, int[] kids) {
  par_hfill(pos, kids);
  int ast_k_script_v = (import ast_k_script);
  int ret_i = ast_new_kids(ast_k_script_v, "", kids);
} return int ret_i;

par_hfill(int[] pos, int[] kids) {
  while (par_is(pos, "}") = 0 && par_kind(pos) != (import lex_k_eof)) {
    int par_handler_v = par_handler(pos);
    push(kids, par_handler_v);
  }
  par_eat(pos, "}");
} return void;

par_handler(int[] pos) {
  par_want(pos, "on");
  string name = par_optxt(pos);
  int ret_i = par_h2(pos, name);
} return int ret_i;
