// par_if's "(" prefix -- shared with par_while, whose condition is the same
// shape -- and par_if3's else-branch and node build, split out to stay
// within the action limit.

par_if_pre(int[] pos) {
  par_next(pos);
  par_want(pos, "(");
} return void;
given par_if_setup ([0]):() then calls par_want:[1]
given par_if_setup ([5]):() then calls par_err:[1]

par_if3_els(int[] pos) {
  int els = 0;
  if (par_is(pos, "else")) { els = par_else(pos); }
} return int els;
given par_if_setup ([9]):(4) then calls par_else:[1]
given par_if_setup ([1]):(0) then calls par_else:[0]

par_if3_node(int cond, int thn, int els) {
  int ast_k_if_v = (import ast_k_if);
  int ret_i = ast_new_abc(ast_k_if_v, "", cond, thn, els);
} return int ret_i;
given ast_init (1, 2, 3):(1) then calls ast_new_abc:(118, "", 1, 2, 3)
given ast_init (5, 6, 0):(1) then calls ast_new_abc:(118, "", 5, 6, 0)
