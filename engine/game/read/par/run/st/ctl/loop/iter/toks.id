// shape correctly (its "repeat" is a bare keyword). Placed beside loop.id/
// node.id -- iter/ had room, ctl/ itself did not.

par_repeat_setup() {
  lex_init();
  ast_init();
  par_repeat_setup2();
} return void;
():() then lex_kind_len:(8)
