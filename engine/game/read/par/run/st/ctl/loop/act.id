// `spawn Template at (x, y[, z])` as a statement. The same node kind serves the
// scene-level spawner, which adds the source name, template and period.
par_sspawn(int[] pos) {
  par_next(pos);
  string name = par_text(pos);
  par_next(pos);
  int nd = par_sspawn2(pos, name);
} return int nd;

par_sspawn2(int[] pos, string name) {
  par_eat(pos, "at");
  int kd = ast_k_spawn();
  int tup = par_etuple(pos);
  int nd = ast_new_a(kd, name, tup);
} return int nd;

// `despawn` alone means this entity; `despawn other` names one. Since newlines
// carry no structure inside a block, the target is only taken when it sits on the
// same line as the keyword -- otherwise `despawn` followed by `say "x"` would eat
// the next statement's first token.
par_despawn(int[] pos) {
  int ln = par_line(pos);
  par_next(pos);
  int kd = ast_k_despawn();
  int tgt = par_dtgt(pos, ln);
  int nd = ast_new_a(kd, "", tgt);
} return int nd;
