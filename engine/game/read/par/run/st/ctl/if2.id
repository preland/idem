par_else(int[] pos) {
  par_next(pos);
  int ret_i = par_else2(pos);
} return int ret_i;

// `else if` chains by making the else arm another `if` node rather than a block,
// so the tree has no special case and neither does the interpreter.
par_else2(int[] pos) {
  int nd = 0;
  if (par_is(pos, "if")) { nd = par_if(pos); } else { nd = par_block(pos); }
} return int nd;

par_while(int[] pos) {
  par_next(pos);
  par_want(pos, "(");
  int par_expr_v = par_expr(pos);
  int ret_i = par_while2(pos, par_expr_v);
} return int ret_i;
