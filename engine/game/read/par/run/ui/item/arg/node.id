// par_uargs2's kid-list fill and node build, split out to stay within the
// action limit.

par_uargs2_kids(int[] pos) {
  int[] kids = [];
  par_ufill(pos, kids);
  par_want(pos, ")");
} return int[] kids;
given par_item_setup ([2]):([1, 2]) then calls ast_new_num:(2, 0)
given par_item_setup ([5]):([])

par_uargs2_node(int[] kids) {
  int ast_k_args_v = (import ast_k_args);
  int ret_i = ast_new_kids(ast_k_args_v, "", kids);
} return int ret_i;
