par_efill(int[] pos, int[] kids) {
  while (par_is(pos, ")") = 0 && par_kind(pos) != (import lex_k_eof)) {
    int par_expr_v = par_expr(pos);
    push(kids, par_expr_v);
    par_eat(pos, ",");
  }
  par_eat(pos, ")");
} return void;
