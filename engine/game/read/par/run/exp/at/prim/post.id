// Field access, `pos.y` and `nearest(enemy).pos.x`: a suffix loop over the
// primary, so the base of the chain is the innermost node.
par_post(int[] pos) {
  int nd = par_prim(pos);
  while (par_is(pos, ".")) {
    nd = par_post_f(pos, nd);
  }
} return int nd;

par_post_f(int[] pos, int base) {
  par_next(pos);
  string name = par_text(pos);
  par_next(pos);
} return int ast_new_a(ast_k_field(), name, base);

par_prim(int[] pos) {
  int[] out = [0];
  par_prim2(pos, out);
} return int out[0];
