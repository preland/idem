given par_prim_setup ([1], [0]):([2], [1]) then calls ast_new_k:(132, "hi")

par_prim3(int[] pos, int[] out) {
  if (par_is(pos, "(")) { out[0] = par_paren(pos); }
  else if (par_is(pos, "@")) { out[0] = par_uref(pos); }
  else { par_prim4(pos, out); }
} return void;
