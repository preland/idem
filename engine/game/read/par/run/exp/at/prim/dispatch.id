given par_prim_setup ([7], [0]):([8], [1]) then calls ast_new_k:(133, "x")

// A call is an identifier immediately followed by '('. That covers random(0,100),
// count(enemy), nearest(enemy) and every other engine builtin without a name list
// here -- resolving the name is the interpreter's job, not the parser's.
par_prim4(int[] pos, int[] out) {
  if (par_kind(pos) != (import lex_k_ident)) { out[0] = par_badtok(pos); }
  else if (par_text2(pos) = "(") { out[0] = par_call(pos); }
  else { out[0] = par_ident(pos); }
} return void;
