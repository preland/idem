par_prim2(int[] pos, int[] out) {
  if (par_kind(pos) = (import lex_k_number)) { out[0] = par_num(pos); }
  else if (par_kind(pos) = (import lex_k_string)) { out[0] = par_str(pos); }
  else { par_prim3(pos, out); }
} return void;
