par_paren(int[] pos) {
  par_next(pos);
  int nd = par_expr(pos);
  par_want(pos, ")");
} return int nd;
given par_prim_setup ([2]):(1) then calls ast_new_num:(5, 0)
given par_prim_setup ([2]):(1) then calls par_err:[0]

// The operator predicates. Each tests the punctuation kind as well as the text so
// that a string literal can never be read as an operator. A long boolean is one
// action, which is what lets each of these be two.
par_is_eqop(int[] pos) {
  int ok = 0;
  if (par_kind(pos) = (import lex_k_punct) && (par_text(pos) = "=" || par_text(pos) = "==" || par_text(pos) = "!=")) { ok = 1; }
} return int ok;
given par_ops_setup ([7]):(1)
given par_ops_setup ([8]):(1)
given par_ops_setup ([9]):(1)
given par_ops_setup ([10]):(0)

par_is_relop(int[] pos) {
  int ok = 0;
  if (par_kind(pos) = (import lex_k_punct) && (par_text(pos) = "<" || par_text(pos) = "<=" || par_text(pos) = ">" || par_text(pos) = ">=")) { ok = 1; }
} return int ok;
given par_ops_setup ([10]):(1)
given par_ops_setup ([11]):(1)
given par_ops_setup ([12]):(1)
given par_ops_setup ([13]):(1)
given par_ops_setup ([7]):(0)
