par_paren(int[] pos) {
  par_next(pos);
  int nd = par_expr(pos);
  par_want(pos, ")");
} return int nd;

// The operator predicates. Each tests the punctuation kind as well as the text so
// that a string literal can never be read as an operator. A long boolean is one
// action, which is what lets each of these be two.
par_is_eqop(int[] pos) {
  int ok = 0;
  if (par_kind(pos) = (import lex_k_punct) && (par_text(pos) = "=" || par_text(pos) = "==" || par_text(pos) = "!=")) { ok = 1; }
} return int ok;

par_is_relop(int[] pos) {
  int ok = 0;
  if (par_kind(pos) = (import lex_k_punct) && (par_text(pos) = "<" || par_text(pos) = "<=" || par_text(pos) = ">" || par_text(pos) = ">=")) { ok = 1; }
} return int ok;
