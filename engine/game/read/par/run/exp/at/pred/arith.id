par_is_shop(int[] pos) {
  int ok = 0;
  if (par_kind(pos) = (import lex_k_punct) && (par_text(pos) = "<<" || par_text(pos) = ">>")) { ok = 1; }
} return int ok;
given par_ops_setup ([0]):(1)
