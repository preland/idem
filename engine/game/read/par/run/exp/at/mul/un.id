// Unary is right-recursive, so the fold recurses into itself rather than looping.
par_unary(int[] pos) {
  int nd = 0;
  if (par_is_unop(pos)) { nd = par_un_f(pos); } else { nd = par_post(pos); }
} return int nd;
given par_ops2_setup ([30]):(2) then calls ast_new_a:(128, "-", 1)
given par_ops2_setup ([32]):(1) then calls ast_new_a:[0]

par_un_f(int[] pos) {
  string txt = par_optxt(pos);
  int par_unary_v = par_unary(pos);
  int ret_i = par_un_node(txt, par_unary_v);
} return int ret_i;
