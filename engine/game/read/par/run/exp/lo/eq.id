par_and(int[] pos) {
  int lv = par_eq(pos);
  while (par_is(pos, "&&")) {
    lv = par_and_f(pos, lv);
  }
} return int lv;

par_and_f(int[] pos, int lv) {
  par_next(pos);
  int par_eq_v = par_eq(pos);
  int ret_i = par_binnode("&&", lv, par_eq_v);
} return int ret_i;

par_eq(int[] pos) {
  int lv = par_rel(pos);
  while (par_is_eqop(pos)) {
    lv = par_eq_f(pos, lv);
  }
} return int lv;
