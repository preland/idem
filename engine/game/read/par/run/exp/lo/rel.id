par_eq_f(int[] pos, int left) {
  string txt = par_text(pos);
  par_next(pos);
  int nd = par_rel(pos);
} return int ast_new_ab(ast_k_bin(), txt, left, nd);

par_rel(int[] pos) {
  int left = par_bor(pos);
  while (par_is_relop(pos)) {
    left = par_rel_f(pos, left);
  }
} return int left;

par_rel_f(int[] pos, int left) {
  string txt = par_text(pos);
  par_next(pos);
  int nd = par_bor(pos);
} return int ast_new_ab(ast_k_bin(), txt, left, nd);
