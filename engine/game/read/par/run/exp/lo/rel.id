par_eq_f(int[] pos, int lv) {
  string txt = par_optxt(pos);
  int nd = par_rel(pos);
  int ret_i = par_binnode(txt, lv, nd);
} return int ret_i;

par_rel(int[] pos) {
  int lv = par_bor(pos);
  while (par_is_relop(pos)) {
    lv = par_rel_f(pos, lv);
  }
} return int lv;

par_rel_f(int[] pos, int lv) {
  string txt = par_optxt(pos);
  int nd = par_bor(pos);
  int ret_i = par_binnode(txt, lv, nd);
} return int ret_i;
