par_eq_f(int[] pos, int left) {
  string txt = par_text(pos);
  par_next(pos);
  int nd = par_rel(pos);
  int ast_k_bin_v = ast_k_bin();
  int ret_i = ast_new_ab(ast_k_bin_v, txt, left, nd);
} return int ret_i;

par_rel(int[] pos) {
  int left = par_bor(pos);
  while (par_is_relop(pos)) {
    left = par_rel_f(pos, left);
  }
} return int left;

par_rel_f(int[] pos, int left) {
  string txt = par_text(pos);
  par_next(pos);
  int nd = par_bor(pos);
  int ast_k_bin_v = ast_k_bin();
  int ret_i = ast_new_ab(ast_k_bin_v, txt, left, nd);
} return int ret_i;
