par_bor(int[] pos) {
  int left = par_bxor(pos);
  while (par_is(pos, "|")) {
    left = par_bor_f(pos, left);
  }
} return int left;

par_bor_f(int[] pos, int left) {
  par_next(pos);
} return int ast_new_ab(ast_k_bin(), "|", left, par_bxor(pos));

par_bxor(int[] pos) {
  int left = par_band(pos);
  while (par_is(pos, "^")) {
    left = par_bxor_f(pos, left);
  }
} return int left;
