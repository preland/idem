par_bor(int[] pos) {
  int lv = par_bxor(pos);
  while (par_is(pos, "|")) {
    lv = par_bor_f(pos, lv);
  }
} return int lv;

par_bor_f(int[] pos, int lv) {
  par_next(pos);
  int par_bxor_v = par_bxor(pos);
  int ret_i = par_binnode("|", lv, par_bxor_v);
} return int ret_i;

par_bxor(int[] pos) {
  int lv = par_band(pos);
  while (par_is(pos, "^")) {
    lv = par_bxor_f(pos, lv);
  }
} return int lv;
