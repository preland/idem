par_bor(int[] pos) {
  int left = par_bxor(pos);
  while (par_is(pos, "|")) {
    left = par_bor_f(pos, left);
  }
} return int left;

par_bor_f(int[] pos, int left) {
  par_next(pos);
  int ast_k_bin_v = ast_k_bin();
  int par_bxor_v = par_bxor(pos);
  int ret_i = ast_new_ab(ast_k_bin_v, "|", left, par_bxor_v);
} return int ret_i;

par_bxor(int[] pos) {
  int left = par_band(pos);
  while (par_is(pos, "^")) {
    left = par_bxor_f(pos, left);
  }
} return int left;
