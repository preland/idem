par_bxor_f(int[] pos, int left) {
  par_next(pos);
  int ast_k_bin_v = ast_k_bin();
  int par_band_v = par_band(pos);
  int ret_i = ast_new_ab(ast_k_bin_v, "^", left, par_band_v);
} return int ret_i;

par_band(int[] pos) {
  int left = par_shift(pos);
  while (par_is(pos, "&")) {
    left = par_band_f(pos, left);
  }
} return int left;

par_band_f(int[] pos, int left) {
  par_next(pos);
  int ast_k_bin_v = ast_k_bin();
  int par_shift_v = par_shift(pos);
  int ret_i = ast_new_ab(ast_k_bin_v, "&", left, par_shift_v);
} return int ret_i;
