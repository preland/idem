par_bxor_f(int[] pos, int lv) {
  par_next(pos);
  int par_band_v = par_band(pos);
  int ret_i = par_binnode("^", lv, par_band_v);
} return int ret_i;

par_band(int[] pos) {
  int lv = par_shift(pos);
  while (par_is(pos, "&")) {
    lv = par_band_f(pos, lv);
  }
} return int lv;

par_band_f(int[] pos, int lv) {
  par_next(pos);
  int par_shift_v = par_shift(pos);
  int ret_i = par_binnode("&", lv, par_shift_v);
} return int ret_i;
