// A variant's body: `key: value` pairs, one per line.

par_vbody(int[] pos, string name, int[] ks) {
  par_want(pos, "{");
  par_vprops(pos, ks);
  par_want(pos, "}");
  int ast_k_variant_v = ast_k_variant();
  int ret_i = ast_new_kids(ast_k_variant_v, name, ks);
} return int ret_i;

par_vprops(int[] pos, int[] ks) {
  while (par_is(pos, "}") = 0 && par_kind(pos) != lex_k_eof()) {
    int par_vprop_v = par_vprop(pos);
    push(ks, par_vprop_v);
  }
} return void;

// The colon is eaten rather than demanded: `colour 0xFFFFFF` is the same
// statement with one fewer character, and refusing it would buy nothing.
par_vprop(int[] pos) {
  string name = par_text(pos);
  par_next(pos);
  par_eat(pos, ":");
  int ast_k_comp_v = ast_k_comp();
  int par_arg_v = par_arg(pos);
  int ret_i = ast_new_a(ast_k_comp_v, name, par_arg_v);
} return int ret_i;
