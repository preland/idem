// Arguments end at a `{` (a body follows) or a `}` (the enclosing block
// ends on this same line), whichever comes first, so a same-line close
// brace stops the fill exactly as a line change would.
par_dafill(int[] pos, int[] kids, int ln) {
  while (par_line(pos) = ln && par_is(pos, "{") = 0 && par_is(pos, "}") = 0 && par_kind(pos) != (import lex_k_eof)) {
    int par_darg_v = par_darg(pos);
    push(kids, par_darg_v);
  }
} return void;
