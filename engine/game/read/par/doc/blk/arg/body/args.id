// The arguments and the braced body.
//
// Arguments run to the end of the declaration's own line, which is how a
// component is delimited in a whitespace-insensitive language: the lexer records
// a line per token, so "the rest of this line" is a question that can be asked.
// A `{` ends them whatever line it is on.

par_dbody(int[] pos, int kd, string name, int ln) {
  int a = par_dargs(pos, ln);
  int[] kids = [];
  int ret_i = par_dfin(pos, kd, name, a, kids);
} return int ret_i;
