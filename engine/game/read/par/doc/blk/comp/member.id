// The two sub-languages, and a plain component.

par_mem2(int[] pos) {
  int nd = 0;
  if (par_is(pos, "script") = 1) {
    nd = par_script(pos);
  } else {
    nd = par_mem3(pos);
  }
} return int nd;
given par_dmem_setup ([8]):(1) then calls ast_new_kids:(115, "", [])
given par_dmem_setup ([30]):(2) then calls ast_new_kids:(136, "", [1])

par_mem3(int[] pos) {
  int nd = 0;
  if (par_is(pos, "ui") = 1) {
    nd = par_mui(pos);
  } else {
    nd = par_comp(pos);
  }
} return int nd;
given par_dmem_setup ([30]):(2) then calls ast_new_kids:(136, "", [1])
given par_dmem_setup ([0]):(3) then calls ast_new:(113, "tag", 2, 0, 0, [])
