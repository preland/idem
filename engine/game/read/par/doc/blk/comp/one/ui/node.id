// par_mui2's kid-list and node build, and par_comp's advance-and-dispatch,
// split out to stay within the action limit.

par_mui2_kids(int[] pos) {
  int[] kids = [par_item(pos)];
  par_want(pos, "}");
} return int[] kids;
given par_dmem_setup ([13]):([1]) then calls ast_new:(137, "box", 0, 0, 0, [])
given par_dmem_setup ([32]):([1]) then calls ast_new:(137, "panel", 0, 0, 0, [])

par_mui2_node(int[] kids) {
  int ast_k_ui_v = (import ast_k_ui);
  int ret_i = ast_new_kids(ast_k_ui_v, "", kids);
} return int ret_i;
given ast_init ([1]):(1) then calls ast_new_kids:(136, "", [1])
given ast_init ([5, 9]):(1) then calls ast_new_kids:(136, "", [5, 9])

par_comp_fin(int[] pos, string name, int ln) {
  par_next(pos);
  int ret_i = par_comp2(pos, name, ln);
} return int ret_i;
given par_dmem_setup ([0], "tag", 1):(3) then calls ast_new:(113, "tag", 2, 0, 0, [])
given par_dmem_setup ([27], "tag", 13):(3) then calls ast_new:(113, "tag", 2, 0, 0, [])
