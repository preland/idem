// `ui { item }` -- one item, wrapped so the loader can find it by kind.

par_mui(int[] pos) {
  par_next(pos);
  par_want(pos, "{");
  int ret_i = par_mui2(pos);
} return int ret_i;
given par_dmem_setup ([11]):(2) then calls ast_new_kids:(136, "", [1])
given par_dmem_setup ([30]):(2) then calls ast_new_kids:(136, "", [1])

par_mui2(int[] pos) {
  int[] kids = par_mui2_kids(pos);
  int ret_i = par_mui2_node(kids);
} return int ret_i;
