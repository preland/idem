// One `name = value` binding.
//
// The value is a single token -- an identifier or a literal -- not an expression:
// `space = press` binds an action name, and parsing it as an expression would make
// `press, enter` a comma operator this language does not have.

par_kv(int[] pos) {
  string name = par_text(pos);
  par_next(pos);
  int ret_i = par_kv2(pos, name);
} return int ret_i;

par_kv2(int[] pos, string name) {
  int[] kids = par_kv2_kids(pos);
  int ast_k_comp_v = ast_k_comp();
  int ret_i = ast_new_kids(ast_k_comp_v, name, kids);
} return int ret_i;

par_kv3(int[] pos, int[] kids) {
  int ast_new_k_v = par_kv3_node(pos);
  push(kids, ast_new_k_v);
  par_kv3_adv(pos);
} return void;
