// par_comp2's kid-list fill and node build, split out to stay within the
// action limit.

par_comp2_kids(int[] pos) {
  int[] kids = [];
  par_cbody(pos, kids);
} return int[] kids;
given par_dmem_setup ([16]):([2, 4]) then calls ast_new_kids:(113, "fire", [3])
given par_dmem_setup ([2]):([])

par_comp2_node(string name, int a, int[] kids) {
  int ast_k_comp_v = (import ast_k_comp);
  int ret_i = ast_new(ast_k_comp_v, name, a, 0, 0, kids);
} return int ret_i;
given ast_init ("tag", 2, []):(1) then calls ast_new:(113, "tag", 2, 0, 0, [])
given ast_init ("pos", 5, [9]):(1) then calls ast_new:(113, "pos", 5, 0, 0, [9])
