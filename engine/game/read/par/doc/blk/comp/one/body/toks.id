// A token stream for doc/blk/comp and doc/blk/arg/body: a bare-number
// component, a tuple component, an empty script block, a one-item ui block,
// a keys block with two bindings, a nested entity with one component, and a
// second ui block, then two same-line entities (`entity a{tag 9}entity
// b{tag 8}}`) whose closing braces share their argument's line, to witness
// par_dafill stopping at a same-line `}` (it used to run past one).
// Placed beside node.id/one.id -- body/ had room.

par_dmem_setup() {
  lex_init();
  ast_init();
  par_dmem_setup2();
} return void;
():() then lex_kind_len:(48)
