  err_init();
  lex_run("tag 1\npos (10, 20)\nscript {\n}\nui {\n  box\n}\nkeys {\n  space = jump\n  fire = shoot\n}\nentity bird {\n  tag 5\n}\nui {\n  panel\n}\nentity a{tag 9}entity b{tag 8}}");
} return void;
