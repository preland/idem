// par_dbad's diagnostic; the node itself is par_badtok_tail's, shared with
// par_badtok (par/cur/lit/err/bad.id) -- same shape, one function.

par_dbad_err(int[] pos, string name) {
  string chr_v = chr(39);
  par_err(pos, "unknown declaration " + chr_v + name + chr_v);
} return void;
given par_lit_setup ([0], "xyz"):() then calls par_err:[1]
given par_lit_setup ([5], "abc"):() then calls par_err:[1]
