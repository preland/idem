// A dotted path, `bird.pos.y`, as a field chain over an identifier -- the same
// node shape a script expression produces, so the UI binder and the interpreter
// read one representation.
par_pathx(int[] pos) {
  int nd = par_ident(pos);
  while (par_is(pos, ".")) {
    nd = par_post_f(pos, nd);
  }
} return int nd;

par_uref(int[] pos) {
  par_next(pos);
  int nd = par_pathx(pos);
} return int par_uref2(pos, nd);

// The trailing `!` is idml's *live* marker: a falling bird must not be eased.
par_uref2(int[] pos, int nd) {
  string txt = "";
  if (par_is(pos, "!")) { txt = "!"; par_next(pos); }
} return int ast_new_a(ast_k_ref(), txt, nd);
