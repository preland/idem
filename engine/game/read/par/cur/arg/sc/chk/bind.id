// par_bind's two halves: the "name =" prefix, then the var node built from the
// bound argument. Split to stay within the action limit.

par_bind_pre(int[] pos) {
  string name = par_text(pos);
  par_next(pos);
  par_want(pos, "=");
} return string name;

par_bind_node(int[] pos, string name) {
  int ast_k_var_v = (import ast_k_var);
  int par_arg_v = par_arg(pos);
  int ret_i = ast_new_a(ast_k_var_v, name, par_arg_v);
} return int ret_i;
