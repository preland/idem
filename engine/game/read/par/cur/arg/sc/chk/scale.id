par_fchk(int[] pos, int fr, int sc) {
  if (fr > sc) { par_err(pos, "a literal with " + fr + " fractional digits does not fit a slot scaled to " + sc); }
} return void;
given par_arg_setup ([10], 3, 2):() then calls par_err:[1]
given par_arg_setup ([10], 1, 2):() then calls par_err:[0]

// `name = value`: a key bound to one value. The same shape serves `keys { space =
// press }`, `persist { high = 0 }` and `hook update = my_update`.
par_bind(int[] pos) {
  string name = par_bind_pre(pos);
  int ret_i = par_bind_node(pos, name);
} return int ret_i;
given par_arg_setup ([8]):(2) then calls ast_new_a:(114, "radius", 1)
given par_arg_setup ([12]):(2) then calls ast_new_a:(114, "speed", 1)
