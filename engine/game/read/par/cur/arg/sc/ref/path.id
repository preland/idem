given par_arg_setup ([2]):(2) then calls ast_new_a:(129, "z", 1)

par_uref(int[] pos) {
  par_next(pos);
  int nd = par_pathx(pos);
  int ret_i = par_uref2(pos, nd);
} return int ret_i;
