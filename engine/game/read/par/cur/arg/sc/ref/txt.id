// par_uref2's live-marker scan, split out to stay within the action limit.

par_uref2_txt(int[] pos) {
  string txt = "";
  if (par_is(pos, "!")) { txt = "!"; par_next(pos); }
} return string txt;
given par_arg_setup ([7]):("!") then calls par_next:[1]
given par_arg_setup ([17]):("") then calls par_next:[0]
