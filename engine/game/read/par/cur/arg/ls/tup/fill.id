// Every collection loop in this parser carries `par_kind(pos) != (import lex_k_eof)`.
// That guard, not error recovery, is what makes malformed input terminate.
par_tfill(int[] pos, int[] kids) {
  while (par_is(pos, ")") = 0 && par_kind(pos) != (import lex_k_eof)) {
    int par_arg_v = par_arg(pos);
    push(kids, par_arg_v);
    par_eat(pos, ",");
  }
  par_eat(pos, ")");
} return void;
given par_ls_setup ([3], []):([7], [1, 2]) then calls ast_new_num:(2, 0)
given par_ls_setup ([17], []):([18], [])

par_sfill(int[] pos, int[] kids, int sc) {
  while (par_is(pos, ")") = 0 && par_kind(pos) != (import lex_k_eof)) {
    int par_snum_v = par_snum(pos, sc);
    push(kids, par_snum_v);
    par_eat(pos, ",");
  }
  par_eat(pos, ")");
} return void;
given par_ls_setup ([3], [], 2):([7], [1, 2]) then calls ast_new_num:(200, 0)
given par_ls_setup ([17], [], 2):([18], [])
