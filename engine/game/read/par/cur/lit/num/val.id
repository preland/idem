// par_str's node build and par_num's scaled value, split out to stay within
// the action limit.

par_str_node(string txt) {
  int ast_k_str_v = (import ast_k_str);
  int ret_i = ast_new_k(ast_k_str_v, txt);
} return int ret_i;

par_num_val(int[] pos, int sg) {
  int par_val_v = par_val(pos);
  int par_frac_v = par_frac(pos);
  int nd = ast_new_num(par_val_v * sg, par_frac_v);
} return int nd;
