par_eat(int[] pos, string txt) {
  int ok = par_is(pos, txt);
  if (ok = 1) { par_next(pos); }
} return int ok;

// Report but do not consume on a mismatch. There is no recovery beyond that:
// every collection loop carries an end-of-input guard, so a wrong token costs one
// diagnostic and a misshapen subtree, never a hang.
par_want(int[] pos, string txt) {
  int ok = par_eat(pos, txt);
  par_wchk(pos, txt, ok);
} return void;

// 39 is an apostrophe.
par_wchk(int[] pos, string txt, int ok) {
  if (ok = 0) {
    string found = par_text(pos);
    string chr_v = chr(39);
    par_err(pos, "expected " + chr_v + txt + chr_v + ", found " + chr_v + found + chr_v);
  }
} return void;
