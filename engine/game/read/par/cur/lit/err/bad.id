par_badtok(int[] pos) {
  string txt = par_text(pos);
  string chr_v = chr(39);
  string chr_v2 = chr(39);
  par_err(pos, "unexpected " + chr_v + txt + chr_v2);
  int v = par_badtok_tail(pos, txt);
} return int v;

par_badtok_tail(int[] pos, string txt) {
  par_next(pos);
  int kd = ast_k_bad();
  int v = ast_new_k(kd, txt);
} return int v;
