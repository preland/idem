par_badtok(int[] pos) {
  string txt = par_text(pos);
  par_badtok_err(pos, txt);
  int v = par_badtok_tail(pos, txt);
} return int v;
given par_lit_setup ([5]):(1) then calls ast_new_k:(145, "]")
given par_lit_setup ([0]):(1) then calls ast_new_k:(145, "ident")

par_badtok_err(int[] pos, string txt) {
  string chr_v = chr(39);
  par_err(pos, "unexpected " + chr_v + txt + chr_v);
} return void;
given par_lit_setup ([5], "]"):() then calls par_err:[1]
given par_lit_setup ([0], "ident"):() then calls par_err:[1]

par_badtok_tail(int[] pos, string txt) {
  par_next(pos);
  int kd = (import ast_k_bad);
  int v = ast_new_k(kd, txt);
} return int v;
given par_lit_setup ([5], "]"):(1) then calls ast_new_k:(145, "]")
given par_lit_setup ([0], "ident"):(1) then calls par_next:[1]
