// Diagnostics are accumulated, never thrown: err_report counts and prints, and
// parsing carries on so that one run reports every problem a game has.
par_err(int[] pos, string msg) {
  string pth = par_pth(pos);
  int ln = par_line(pos);
  err_report(pth, ln, msg);
} return void;
given par_lit_setup ([0], "test message"):() then calls err_report:("<input>", 1, "test message")
given par_lit_setup ([5], "other"):() then calls err_report:("<input>", 1, "other")
