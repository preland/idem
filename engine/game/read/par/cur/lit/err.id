// Diagnostics are accumulated, never thrown: err_report counts and prints, and
// parsing carries on so that one run reports every problem a game has.
par_err(int[] pos, string msg) {
  string pth = par_pth(pos);
  int ln = par_line(pos);
  err_report(pth, ln, msg);
} return void;

par_badtok(int[] pos) {
  string txt = par_text(pos);
  par_err(pos, "unexpected " + chr(39) + txt + chr(39));
  par_next(pos);
  int kd = ast_k_bad();
  int v = ast_new_k(kd, txt);
} return int v;

par_ident(int[] pos) {
  string name = par_text(pos);
  par_next(pos);
  int kd = ast_k_ident();
  int v = ast_new_k(kd, name);
} return int v;
