given par_tok_setup ([10]):("")

// String tokens are excluded so that a sprite row or a `say "}"` can never be
// mistaken for punctuation and close a block early.
par_is(int[] pos, string txt) {
  int ok = 0;
  if (par_kind(pos) != (import lex_k_string) && par_text(pos) = txt) { ok = 1; }
} return int ok;
given par_tok_setup ([2], "+"):(1)
given par_tok_setup ([1], "hi"):(0)
