// Advancing stamps the consumed token's line into the arena, so every node built
// afterwards carries a source line without any production mentioning one.
par_next(int[] pos) {
  int ln = par_line(pos);
  ast_mark(ln);
  pos[0] = pos[0] + 1;
} return void;
given ast_init given par_tok_setup ([0]):([1]) then ast_cur_val:(1)
given ast_init given par_tok_setup ([10]):([11]) then ast_cur_val:(-1)

par_text2(int[] pos) {
  string s = "";
  if (pos[0] + 1 < len((import lex_text))) { s = (import lex_text)[pos[0] + 1]; }
} return string s;
