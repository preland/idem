lex_hex_tail(string src, int i, int e) {
  int v = lex_hexval(src, i + 2, e);
  lex_hex_push(src, i, e, v);
} return void;
given lex_init ("0x1F", 0, 4):() then calls lex_push:(13, "0x1F", 31, 0)
given lex_init ("0xAB", 0, 4):() then calls lex_push:(13, "0xAB", 171, 0)

lex_hex_push(string src, int i, int e, int v) {
  int kd = (import lex_k_number);
  string s = str_slice(src, i, e - i);
  lex_push(kd, s, v, 0);
} return void;
given lex_init ("0x1F", 0, 4, 31):() then calls lex_push:(13, "0x1F", 31, 0)
given lex_init ("0xAB", 0, 4, 171):() then calls lex_push:(13, "0xAB", 171, 0)
