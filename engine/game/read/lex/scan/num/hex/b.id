lex_hexend(string src, int i) {
  int e = i;
  while (lex_is_hex(charat(src, e))) {
    e = e + 1;
  }
} return int e;

lex_hexval(string src, int a, int b) {
  int v = 0;
  while (a < b) {
    v = v * 16 + lex_hdig(charat(src, a));
    a = a + 1;
  }
} return int v;

// 87 = 'a' - 10, 55 = 'A' - 10, 48 = '0'
lex_hdig(int c) {
  int v = c - 48;
  if (c >= 97) { v = c - 87; } else if (c >= 65) { v = c - 55; }
} return int v;
