lex_hexend(string src, int i) {
  int e = i;
  int c = charat(src, e);
  while (lex_is_hex(c)) {
    e = e + 1;
    c = charat(src, e);
  }
} return int e;
("1F", 0):(2)
("1G", 0):(1)

lex_hexval(string src, int a, int b) {
  int v = 0;
  while (a < b) {
    int c = charat(src, a);
    v = v * 16 + lex_hdig(c);
    a = a + 1;
  }
} return int v;
("1F", 0, 2):(31)
("F", 0, 0):(0)

// 87 = 'a' - 10, 55 = 'A' - 10, 48 = '0'
lex_hdig(int c) {
  int v = c - 48;
  if (c >= 97) { v = c - 87; } else if (c >= 65) { v = c - 55; }
} return int v;
(48):(0)
(65):(10)
(97):(10)
