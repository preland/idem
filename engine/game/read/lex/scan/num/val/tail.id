lex_frlen(int e, int fe) {
  int fr = 0;
  if (fe > e) { fr = fe - e - 1; }
} return int fr;
(1, 3):(1)
(2, 2):(0)

lex_dnum_tail(string src, int i, int fe, int fr, int v) {
  int kd = (import lex_k_number);
  string s = str_slice(src, i, fe - i);
  lex_push(kd, s, v, fr);
} return void;
given lex_init ("42", 0, 2, 0, 42):() then calls lex_push:(13, "42", 42, 0)
given lex_init ("3.5", 0, 3, 1, 35):() then calls lex_push:(13, "3.5", 35, 1)
