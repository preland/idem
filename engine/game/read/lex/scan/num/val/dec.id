// 46 is '.'. A point only continues the number when a digit follows it, so
// `pos.y` and `nearest(enemy).pos.x` still lex as field access.
lex_fracend(string src, int e) {
  int fe = e;
  int c = charat(src, e + 1);
  if (charat(src, e) = 46 && lex_is_digit(c)) { fe = lex_digend(src, e + 1); }
} return int fe;
("3.5", 1):(3)
("3x", 1):(1)

lex_dnum(string src, int i, int e, int fe) {
  int fr = lex_frlen(e, fe);
  int v = lex_dval(src, i, fe);
  lex_dnum_tail(src, i, fe, fr, v);
} return int fe;
given lex_init ("42", 0, 2, 2):(2) then calls lex_push:(13, "42", 42, 0)
given lex_init ("3.5", 0, 1, 3):(3) then calls lex_push:(13, "3.5", 35, 1)

lex_dval(string src, int a, int b) {
  int v = 0;
  while (a < b) {
    int c = charat(src, a);
    v = lex_acc(v, c);
    a = a + 1;
  }
} return int v;
("42", 0, 2):(42)
("3.5", 0, 3):(35)
