// 46 is '.'. A point only continues the number when a digit follows it, so
// `pos.y` and `nearest(enemy).pos.x` still lex as field access.
lex_fracend(string src, int e) {
  int fe = e;
  if (charat(src, e) = 46 && lex_is_digit(charat(src, e + 1))) { fe = lex_digend(src, e + 1); }
} return int fe;

lex_dnum(string src, int i, int e, int fe) {
  int fr = 0;
  if (fe > e) { fr = fe - e - 1; }
  lex_push(lex_k_number(), str_slice(src, i, fe - i), lex_dval(src, i, fe), fr);
} return int fe;

lex_dval(string src, int a, int b) {
  int v = 0;
  while (a < b) {
    v = lex_acc(v, charat(src, a));
    a = a + 1;
  }
} return int v;
