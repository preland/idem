// A string literal, stored unescaped: the parser and every later stage want the
// value, not the spelling. 34 is '"', 92 is a backslash.
lex_string(string src, int i) {
  int e = lex_strend(src, i + 1);
  int lex_k_string_v = lex_k_string();
  string lex_unesc_v = lex_unesc(src, i + 1, e);
  lex_push(lex_k_string_v, lex_unesc_v, 0, 0);
  int ret_i = e + 1;
} return int ret_i;

lex_strend(string src, int i) {
  while (charat(src, i) != 34 && charat(src, i) != -1) {
    i = lex_sadv(src, i);
  }
} return int i;

lex_sadv(string src, int i) {
  int nxt = i + 1;
  if (charat(src, i) = 92) { nxt = i + 2; }
} return int nxt;
