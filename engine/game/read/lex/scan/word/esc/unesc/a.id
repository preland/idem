// Unescaping goes through the flat store, not string concatenation: `s = s + c`
// in a loop is the single most expensive thing this language can do. One alloc,
// one str_of_mem, and the escape sequence decides how far the source index moves
// while the destination always moves one byte.
lex_unesc(string src, int a, int b) {
  word ad = alloc(b - a + 1);
  int n = lex_unfill(src, a, b, ad);
  string s = str_of_mem(ad, n);
} return string s;
("hi", 0, 2):("hi")
("x", 0, 0):("")

lex_unfill(string src, int a, int b, word ad) {
  int n = 0;
  while (a < b) {
    a = lex_unone(src, a, ad + n);
    n = n + 1;
  }
} return int n;
given lex_wbuf_setup ("hi", 0, 2, (import lex_wbuf)):(2) then lex_wbuf_sum:(263)
given lex_wbuf_setup ("hi", 0, 0, (import lex_wbuf)):(0) then lex_wbuf_sum:(72)

lex_unone(string src, int a, word ad) {
  int nxt = a + 1;
  int c = charat(src, a);
  int result = lex_unone_tail(src, a, c, nxt, ad);
} return int result;
given lex_wbuf_setup ("hi", 0, (import lex_wbuf)):(1) then lex_wbuf_sum:(167)
given lex_wbuf_setup ("\\n", 0, (import lex_wbuf)):(2) then lex_wbuf_sum:(73)
