lex_plen(string src, int i) {
  int n = 1;
  if (lex_p2(src, i)) { n = 2; }
} return int n;

// The multi-character operators, as two byte codes rather than eight string
// comparisons. That is not micro-optimisation, it is the difference between a
// linear lexer and a quadratic one: charat remembers the length of the *last*
// string it was asked about, so reading one string is free and alternating
// between two costs a strlen of both, every character. str_eqat alternates by
// construction (source against pattern), and at 0.83 us a call on a 130 KB
// source, eight of them per punctuation token is 40 ms of nothing on a real
// game -- growing with the square of its size. Reading only `src` keeps the
// memo warm and the whole scan flat.
//
// 61 is '=', 60 '<', 62 '>', 33 '!', 38 '&', 124 '|'. Two shapes cover all
// eight: something followed by '=', or a character doubled.
lex_p2(string src, int i) {
} return int lex_op2(charat(src, i), charat(src, i + 1));

lex_op2(int c, int nxt) {
  int ok = 0;
  if (nxt = 61 && (c = 60 || c = 62 || c = 61 || c = 33)) { ok = 1; }
  else if (c = nxt && (c = 38 || c = 124 || c = 60 || c = 62)) { ok = 1; }
} return int ok;
