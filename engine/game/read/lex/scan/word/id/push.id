// lex_ident's push, split out to stay within the action limit.

lex_ident_push(string src, int i, int e) {
  int lex_k_ident_v = (import lex_k_ident);
  string str_slice_v = str_slice(src, i, e - i);
  lex_push(lex_k_ident_v, str_slice_v, 0, 0);
} return void;
given lex_init ("abc", 0, 3):() then calls lex_push:(12, "abc", 0, 0)
given lex_init ("xy", 0, 2):() then calls lex_push:(12, "xy", 0, 0)
