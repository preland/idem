// ident = [A-Za-z_][A-Za-z0-9_-]*, which collides with subtraction: `x-1` could
// be one identifier. Resolved by letting '-' continue an identifier only when a
// letter follows it, so `bird-up`, `top-left` and `pipe-body` lex as one token
// while `x-1` and `x - y` are subtraction. Two hyphenated identifiers subtracted
// without spaces (`hp-dmg`) lex as one name; write the spaces.
lex_ident(string src, int i) {
  int e = lex_idend(src, i);
  int lex_k_ident_v = lex_k_ident();
  string str_slice_v = str_slice(src, i, e - i);
  lex_push(lex_k_ident_v, str_slice_v, 0, 0);
} return int e;

lex_idend(string src, int i) {
  int e = i;
  while (lex_is_alnum(charat(src, e)) || lex_hyp(src, e)) {
    e = e + 1;
  }
} return int e;

// 45 is '-'
lex_hyp(string src, int e) {
  int ok = 0;
  if (charat(src, e) = 45 && lex_is_alpha(charat(src, e + 1))) { ok = 1; }
} return int ok;
