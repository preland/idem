// The comment itself, and the markers the toolchain hides in one.

lex_hash(string src, int i) {
  int e = str_eol(src, i);
  lex_marker(src, i, e);
} return int e;
given lex_init ("#file foo.idml", 0):(14) then calls lex_setpath:("foo.idml")
given lex_init ("# hi", 0):(4) then calls lex_setpath:[0]

lex_marker(string src, int i, int e) {
  if (str_eqat(src, i, "#file ")) {
    string path = str_slice(src, i + 6, e - i - 6);
    lex_setpath(path);
  }
} return void;
given lex_init ("#file a.b", 0, 9):() then calls lex_setpath:("a.b")
given lex_init ("# nah", 0, 5):() then calls lex_setpath:[0]
