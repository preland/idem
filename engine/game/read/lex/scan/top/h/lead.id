// The backward half of the line-leading test, and the colour.

lex_lead2(string src, int j, int ok) {
  while (j >= 0 && charat(src, j) != 10 && ok = 1) {
    ok = charat(src, j) = 32 || charat(src, j) = 9;
    j = j - 1;
  }
} return int ok;

// `#rrggbb` as a number, so a colour reaches the parser as the literal it is.
// The digits are the same scan `0x` uses -- one hex reader, and a colour that
// disagreed with a hex literal about what `f` means would be a very quiet bug.
lex_pcol(string src, int i) {
  int e = lex_hexend(src, i + 1);
  lex_push(lex_k_number(), str_slice(src, i, e - i), lex_hexval(src, i + 1, e), 0);
} return int e;
