// Convenience shapes. Each one differs from its neighbours by its signature, so
// the function-logic uniqueness rule is satisfied without contrivance.
ast_new_k(int kd, string txt) {
  int[] kids = [];
  int v = ast_new(kd, txt, 0, 0, 0, kids);
} return int v;
given ast_init (100, "nil2"):(1) then ast_n:(2)
given ast_init (101, "x"):(1) then ast_n:(2)

ast_new_a(int kd, string txt, int a) {
  int[] kids = [];
  int v = ast_new(kd, txt, a, 0, 0, kids);
} return int v;
given ast_init (100, "x", 5):(1) then ast_n:(2)
given ast_init (101, "y", 6):(1) then ast_n:(2)

ast_new_ab(int kd, string txt, int a, int b) {
  int[] kids = [];
  int v = ast_new(kd, txt, a, b, 0, kids);
} return int v;
given ast_init (100, "x", 5, 6):(1) then ast_n:(2)
given ast_init (101, "y", 7, 8):(1) then ast_n:(2)
