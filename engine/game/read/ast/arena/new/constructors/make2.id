ast_new_abc(int kd, string txt, int a, int b, int c) {
  int[] kids = [];
  int v = ast_new(kd, txt, a, b, c, kids);
} return int v;

ast_new_kids(int kd, string txt, int[] kids) {
  int v = ast_new(kd, txt, 0, 0, 0, kids);
} return int v;

