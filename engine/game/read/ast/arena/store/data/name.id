ast_ktake(string[] strs, string s, int i) {
  int e = ast_kend(s, i);
  int v = ast_ktake_tail(strs, s, i, e);
} return int v;

// The `find` idiom that stands in for `break`: the loop bound is the result, so
// assigning it on a hit ends the loop. 32 is a space. Missing separator yields
// len(s), which is what a caller slicing the last field wants.
ast_kend(string s, int i) {
  int e = len(s);
  while (i < e) {
    if (charat(s, i) = 32) { e = i; }
    i = i + 1;
  }
} return int e;

ast_mark(int ln) {
  lset((import ast_cur), 0, ln);
} return void;
