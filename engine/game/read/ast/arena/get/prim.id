// Accessors, one line each. Every later pass -- the asset builder, the scene
// loader, the UI tiler, the script interpreter -- touches only these.
ast_kd(int nd) {
  int k = (import ast_kind)[nd];
} return int k;

ast_tx(int nd) {
  string tx = (import ast_text)[nd];
} return string tx;

ast_ia(int nd) {
  int a = (import ast_a)[nd];
} return int a;
