// A second, known-content node atop the nil node ast_init always creates: the
// accessors (ast_kd, ast_tx, ast_ia, ast_ib, ast_ic, ast_ks, ast_lnof) are one
// line each and have nothing to read until some node holds distinct values in
// every column, the same shape as lex/tok/cols and idstd's buf/known.id.

ast_known_setup() {
  ast_init();
  ast_known_mark();
} return void;
():() then ast_n:(2)
