// Walking the children in order, each one advancing the running offset.
ui_kids_loop(int[] ks, int x, int y, int w, int h, int k) {
  int i = 0;
  int p = 0;
  while (i < len(ks)) {
    p = p + ui_kid(ks[i], x, y, w, h, k, p);
    i = i + 1;
  }
} return void;
given ui_leaf_t_setup ([], 0, 0, 100, 50, 1):() then calls ui_rput:[0]
given ui_leaf_t_setup ([3], 0, 0, 100, 50, 1):() then calls ui_rput:[1]
