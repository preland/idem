// Placing one child inside its parent's rect.
//
// A stacked child (k = -1) takes the whole rect and advances nothing. A tiled
// child takes its percentage of the main axis at the running offset, and the
// parent's full extent across.

ui_place(int nd, int x, int y, int w, int h, int k, int p) {
  int n = ui_main(nd, w, h, k);
  ui_at(nd, x, y, w, h, k, p, n);
} return int n;
given ui_row_t_setup (1, 0, 0, 100, 50, 1, 5):(100) then calls ui_rput:("Row", 5, 0, 100, 50)
given ui_row_t_setup (1, 0, 0, 100, 50, 0, 5):(50) then calls ui_rput:("Row", 0, 5, 100, 50)

ui_at(int nd, int x, int y, int w, int h, int k, int p, int n) {
  if (k = 1) {
    ui_draw(nd, x + p, y, n, h);
  } else {
    ui_row(nd, x, y, w, h, k, p, n);
  }
} return void;
given ui_row_t_setup (1, 0, 0, 100, 50, 1, 5, 30):() then calls ui_rput:("Row", 5, 0, 30, 50)
given ui_row_t_setup (1, 0, 0, 100, 50, 0, 5, 30):() then calls ui_row:[1]

ui_row(int nd, int x, int y, int w, int h, int k, int p, int n) {
  if (k = 0) {
    ui_draw(nd, x, y + p, w, n);
  } else {
    ui_draw(nd, x, y, w, h);
  }
} return void;
given ui_row_t_setup (1, 0, 0, 100, 50, 0, 5, 30):() then calls ui_rput:("Row", 0, 5, 100, 30)
given ui_row_t_setup (1, 0, 0, 100, 50, -1, 5, 30):() then calls ui_rput:("Row", 0, 0, 100, 50)
