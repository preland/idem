// Two num nodes (index 1 = 42, index 2 = 99) for ui_dim's a/b hop.
ui_dim_t_nums() {
  ast_init();
  int n1 = ast_new_num(42, 0);
  int n2 = ast_new_num(99, 0);
} return void;
