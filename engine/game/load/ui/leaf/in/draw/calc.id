// Calculation helpers for text input display.

tin_calc_y(int y, int h) {
  int txt_cellh_v = txt_cellh();
  int txt_ui_v = txt_ui();
  int ret_i = y + (h - txt_cellh_v * txt_ui_v) / 2;
} return int ret_i;
given txt_init given sf_t_setup (10, 20):(12)
given txt_init given sf_t_setup (0, 16):(0)

tin_calc_caret_x(int i) {
  int txt_st_v = (import tin_st)[0];
  int txt_cell_v = txt_cell();
  int ret_i = txt_st_v * txt_cell_v * txt_ui();
} return int ret_i;
given tin_init given txt_init given sf_t_setup (0):(0)
given tin_t_hi_setup given txt_init given sf_t_setup (0):(8)
