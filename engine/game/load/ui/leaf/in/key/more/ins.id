// The two edits, and the one place the buffer and the caret are written.

// Insert a character at the caret and step past it.
//
// Two slices and a concat, per keystroke -- three allocations that are never
// freed. That is the expensive shape in this language and it is the right one
// here: it happens when a person presses a key, not when a frame runs, so a
// furious typist costs a few hundred bytes a second against a budget of nothing.
// The rule the engine actually holds is that NOTHING BUILDS A STRING PER FRAME
// (in.id, and txt_number is the reason it can be kept); this is on the other
// side of that line.
tin_ins(int key) {
  string s = tin_text();
  int i = (import tin_st)[0];
  tin_put(str_slice(s, 0, i) + chr(key) + str_slice(s, i, len(s) - i), i + 1);
} return void;

// Delete the character at i, if there is one. Backspace and Delete are the same
// operation at two different indices, so the guard is here rather than in each
// of them -- and it is what makes both keys safe at the ends of the buffer.
tin_del(int i) {
  string s = tin_text();
  if (i >= 0 && i < len(s)) {
    tin_put(str_slice(s, 0, i) + str_slice(s, i + 1, len(s) - i - 1), i);
  }
} return void;

// Every write to the buffer goes through here, and so does every write to the
// caret. That is what makes the caret's invariant -- 0 <= caret <= len -- a
// property of the module rather than of each caller: there is no path that sets
// one without clamping the other against it.
tin_put(string s, int i) {
  sset((import tin_s), 0, s);
  lset((import tin_st), 0, fx_clamp(i, 0, len(s)));
} return void;
