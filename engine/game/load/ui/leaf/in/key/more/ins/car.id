// A buffer "hi" with the caret parked mid-string (index 1, between the two
// characters), for cases that need a non-empty, non-boundary caret rather
// than tin_init's empty field.
tin_t_hi_setup() {
  tin_init();
  tin_put("hi", 1);
} return void;
():() then tin_text:("hi")
():() then tin_caret:(1)
