// The rest of the chain: the caret keys, and the two that end the edit.

// Right (257), Home (260). The codes are the seam's, not ASCII's: a key that
// makes no character is 256 upward (engine/core/sys/inp/inp.id), and arrows are
// 256-259 in the order left, right, up, down. Up and down are not handled --
// this is a one-line field, and a field that silently ignored a second line
// would be worse than one that never offers it.
tin_key3(int key) {
  if (key = 257) {
    tin_move(1);
  } else if (key = 260) {
    string tin_text_v = tin_text();
    tin_put(tin_text_v, 0);
  } else {
    tin_key4(key);
  }
} return void;

// End (261), Return (13) and Escape (27). The last two only record what
// happened; they do not touch the buffer, because committing and cancelling mean
// something different to every caller and this module has no idea which. `1 +
// (key = 27)` is the branchless form NAMES.md section 6 names: a comparison is an
// int, so Return records 1 and Escape 2 with no second branch.
tin_key4(int key) {
  if (key = 261) {
    string tin_text_v = tin_text();
    string tin_text_v2 = tin_text();
    int len_v = len(tin_text_v2);
    tin_put(tin_text_v, len_v);
  } else if (key = 13 || key = 27) {
    lset((import tin_st), 4, 1 + (key = 27));
  }
} return void;

// The caret, moved by mv and clamped by tin_put -- so walking off either end is a
// no-op rather than an index that later slices out of range. (`mv` and not `d`:
// `d` is a depth everywhere else in the program and a name holds one meaning,
// NAMES.md section 2.)
tin_move(int mv) {
  string tin_text_v = tin_text();
  tin_put(tin_text_v, (import tin_st)[0] + mv);
} return void;
