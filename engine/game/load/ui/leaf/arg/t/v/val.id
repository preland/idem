// What a `@ref` in the layout reads.
//
// The one direction data flows: the game publishes, the layout displays. idml
// never computes a value and never holds one -- it names one, and the name is
// resolved by g_ref, the function value every game hands in through eng_seam
// (app.id) and this reads back as eng_ref (docs/IDML.md §2).
//
// A ref node's own text is idml's trailing `!` live marker; the *name* is on the
// path node hanging off it. A path of more than one segment -- `@item.top` inside
// a Repeat -- is not resolved yet and reads as its first segment.

ui_val_txt(int nd) {
  string s = "";
  int ast_ia_v = ast_ia(nd);
  if (ast_ia_v != 0) { s = ast_tx(ast_ia_v); }
} return string s;

ui_val(int nd) {
  string s = ui_val_txt(nd);
  func(string) return int gr = (import eng_ref);
  int ret_i = gr(s);
} return int ret_i;
