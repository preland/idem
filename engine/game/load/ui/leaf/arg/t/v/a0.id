ui_tc(int nd) {
  string s = ast_tx(nd);
  int c = ui_vprop(s, "colour", 0xC8C8C8);
  int result = ui_arg(nd, 1, c);
} return int result;

// A Text's first argument, and how wide a number drawn at a scale is.

ui_arg0(int nd) {
  int result = scn_arg(nd, 0);
} return int result;

// It has to agree with what txt_num_sc actually draws, or a centred score drifts
// by half a digit as it crosses a power of ten.
txt_num_wsc(int v, int sc) {
  int cell = txt_cell();
  int abs_v = fx_abs(v);
  int dn = txt_num_dn(abs_v);
  int result = txt_num_wsc_tail(v, sc, cell, dn);
} return int result;
