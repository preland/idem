// One row of blocks, and one block.

jpg_arow(int ci, int by, int bx) {
  while (bx < (import jpg_c)[ci * 10 + 8]) {
    jpg_ablk(ci, bx, by);
    bx = bx + 1;
  }
} return void;

jpg_ablk(int ci, int bx, int by) {
  jpg_ablk_prep(ci, bx, by);
  jpg_idct();
  jpg_store(ci, bx * 8, by * 8);
} return void;
