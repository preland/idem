// One quantisation table, and one of its entries.

jpg_dqt1(int p) {
  int pq = asset_at(p) / 16;
  int asset_at_v = asset_at(p);
  jpg_qfill(p + 1, asset_at_v % 16, pq);
  int ret_i = p + 1 + 64 * (pq + 1);
} return int ret_i;

jpg_qfill(int p, int tq, int pq) {
  int k = 0;
  while (k < 64) {
    int jpg_q1_v = jpg_q1(p, k, pq);
    lset((import jpg_q), tq * 64 + k, jpg_q1_v);
    k = k + 1;
  }
} return void;

// Precision 1 means 16-bit entries, which only appears in 12-bit images; it is
// read correctly here so that such a file fails on its sample precision rather
// than on a quantisation table read at half stride.
jpg_q1(int p, int k, int pq) {
  int v = asset_at(p + k);
  if (pq = 1) { v = asset_at(p + k * 2) * 256 + asset_at(p + k * 2 + 1); }
} return int v;
