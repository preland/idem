// The most negative 16-bit value (-32768 & 65535 = 32768) -- the one input
// that pins the sign-extension boundary in jpg_cget (>= 32768, not > 32768).
jpg_csetneg_fixture() {
  jpg_coefbuf_fixture();
  jpg_cset((import jpg_coef_a), 0, -32768);
} return void;
