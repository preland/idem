jpg_dht1(int p) {
  int t = jpg_dht1_setup(p);
  jpg_dht1_store(p, t);
  int ret_i = p + 17 + jpg_htot(t);
} return int ret_i;
given jpg_raw_fixture (181):(201) then calls jpg_dht1_store:(181, 0)
given jpg_raw_fixture (205):(226) then calls jpg_dht1_store:(205, 4)

jpg_dht1_setup(int p) {
  int t = asset_at(p) % 16 + 4 * (asset_at(p) / 16);
  jpg_hcnt(p + 1, t);
} return int t;
given jpg_raw_fixture (181):(0) then calls jpg_hcnt:(182, 0)
given jpg_raw_fixture (205):(4) then calls jpg_hcnt:(206, 4)

jpg_dht1_store(int p, int t) {
  int jpg_htot_v = jpg_htot(t);
  jpg_hsym(p + 17, t, jpg_htot_v);
} return void;
given jpg_dht1_fixture (181, 0):() then calls jpg_hsym:(198, 0, 3)
given jpg_init (0, 0):() then calls jpg_hsym:(17, 0, 0)
