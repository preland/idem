jpg_sof1c(int p, int asset_at_v, int asset_at_v2, int asset_at_v3, int asset_at_v4) {
  m4_pair((import jpg_st), 1, 0, asset_at_v * 256 + asset_at_v2, asset_at_v3 * 256 + asset_at_v4);
  jpg_sof1d(p);
