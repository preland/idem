// The sign bit is read here and nowhere else, in its own statement, because it
// must be consumed immediately after the symbol and before any correction bit.
jpg_rsym3(int a, int rn, int sz) {
  if (sz != 0) {
    jpg_rsign(a);
  } else {
    jpg_rzrl(a, rn);
  }
} return void;
