// One output row, and one pixel.

jpg_orows(int y) {
  while (y < (import jpg_st)[1]) {
    jpg_orow(y, asset_row(y));
    y = y + 1;
  }
} return void;

// Three samples in one expression is safe here only because jpg_samp reads and
// writes nothing: two side-effecting calls in one expression may evaluate in
// either order in this language, which would silently swap two channels.
jpg_orow(int y, int ra) {
  int x = 0;
  while (x < (import jpg_st)[0]) {
    jpg_opx(ra + 1 + x * 3, jpg_samp(0, x, y), jpg_samp(1, x, y), jpg_samp(2, x, y));
    x = x + 1;
  }
} return void;

// YCbCr to RGB, JFIF's coefficients at x1024. The shifts floor rather than
// truncate, which matters because Cb and Cr are signed once centred.
jpg_opx(int da, int lu, int cb, int cr) {
  poke8(da, fx_clamp(lu + ((1436 * (cr - 128)) >> 10), 0, 255));
  poke8(da + 1, fx_clamp(lu - ((352 * (cb - 128) + 731 * (cr - 128)) >> 10), 0, 255));
  poke8(da + 2, fx_clamp(lu + ((1815 * (cb - 128)) >> 10), 0, 255));
} return void;
