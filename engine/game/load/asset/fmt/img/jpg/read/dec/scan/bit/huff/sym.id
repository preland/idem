// The same, one symbol ("10" -> 7) already consumed -- so the next decode
// starts on bit 3 of 0x8F, which is "0" -> symbol 0.
jpg_huff2_fixture() {
  jpg_huff_fixture();
  jpg_dec(0);
} return void;
