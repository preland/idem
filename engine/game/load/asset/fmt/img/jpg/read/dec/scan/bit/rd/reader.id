// The entropy-coded bit reader.
//
// Bits are most-significant first within a byte, which is the opposite of
// DEFLATE, so this cannot reuse the inflate's reader. The other difference is
// byte stuffing: a literal 0xFF in the data is written as 0xFF 0x00, so a 0x00
// after 0xFF is consumed and anything else means a marker has been reached and
// the entropy data is over.
//
// jpg_b: 0 the read cursor, 1 the bit buffer, 2 bits left in it, 3 marker hit.

jpg_bset(int p) {
  m4_pair((import jpg_b), 0, 1, p, 0);
  m4_pair((import jpg_b), 2, 3, 0, 0);
} return void;
