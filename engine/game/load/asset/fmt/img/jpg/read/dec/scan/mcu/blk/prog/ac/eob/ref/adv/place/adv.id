// Placing the sign, starting an end-of-band run, and the advance.

// The sign bit is read into its own local before anything else happens: it must
// be consumed immediately after the symbol, and two side-effecting reads in one
// expression may evaluate in either order.
jpg_rsign(int a) {
  int bt = jpg_bit();
  int inf_pow2_v = fx_pow(2, (import jpg_st)[16]);
  jpg_rsign1(a, inf_pow2_v, bt);
} return void;
