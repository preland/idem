// A real output row (png_st[7]/[8]) and a small width (jpg_st[0]=4), with no
// components (jpg_st[2]=0 stays at jpg_init's default) -- jpg_samp then
// always answers its safe default, 128, so orow.id's cases exercise the
// real row-writing loop without needing a real decoded image behind it.
jpg_pngrow_fixture() {
  jpg_raw_fixture();
  jpg_pngrow_set();
  lset((import jpg_st), 0, 4);
} return void;
