// One component's declaration, and the MCU grid that follows from all of them.

jpg_comps(int p, int ci) {
  while (ci < (import jpg_st)[2]) {
    jpg_comp(p + ci * 3, ci);
    ci = ci + 1;
  }
  jpg_mcus();
} return void;

jpg_comp(int p, int ci) {
  int asset_at_v = asset_at(p);
  int asset_at_v2 = asset_at(p + 1);
  m4_pair((import jpg_c), ci * 10, ci * 10 + 1, asset_at_v, asset_at_v2 / 16);
  int asset_at_v3 = asset_at(p + 1);
  int asset_at_v4 = asset_at(p + 2);
  m4_pair((import jpg_c), ci * 10 + 2, ci * 10 + 3, asset_at_v3 % 16, asset_at_v4);
} return void;

// An MCU is one block of every component at its own sampling, so its size in
// pixels is eight times the largest sampling factor and the grid is the image
// rounded up to that. The padding is real: the bottom and right MCUs are decoded
// in full and the surplus is simply never read out.
jpg_mcus() {
  jpg_maxes(0);
  jpg_grid();
  jpg_planes(0);
} return void;
