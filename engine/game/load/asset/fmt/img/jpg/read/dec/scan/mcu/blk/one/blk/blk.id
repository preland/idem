// One block: decode, transform, store.

// One block of one MCU, addressed in the component's own block grid.
jpg_one(int mx, int my, int ci, int by, int bx) {
  int jpg_bat_v = jpg_bat(ci, mx * (import jpg_c)[ci * 10 + 1] + bx, my * (import jpg_c)[ci * 10 + 2] + by);
  jpg_blk(ci, jpg_bat_v);
} return void;

// Which decoder a scan wants. Baseline sends DC and the whole AC band in one
// visit; progressive splits them, and splits the AC band again by precision.
jpg_blk(int ci, int a) {
  if ((import jpg_st)[10] = 0) {
    jpg_bblk(ci, a);
  } else {
    jpg_pblk(ci, a);
  }
} return void;

// The DC coefficient is sent as a difference from the previous block of the same
// component, which is why the predictor is per component and survives across
// blocks until a restart or a new scan clears it.
jpg_dc(int ci, int a) {
  int sz = jpg_dec((import jpg_c)[ci * 10 + 4]);
  int jpg_diff_v = jpg_diff(sz);
  jpg_dc1(ci, a, jpg_diff_v);
} return void;
