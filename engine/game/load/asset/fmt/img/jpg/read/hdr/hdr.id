// The marker walk.
//
// A JPEG is a chain of segments, each introduced by 0xFF and a marker byte. Most
// carry a big-endian length that covers itself; SOI, EOI and the restart markers
// do not, and 0xFF may repeat as fill before a marker.
//
// 216 is SOI, 217 EOI, 218 SOS, 219 DQT, 196 DHT, 221 DRI, 192/193/194 SOF0/1/2.

jpg_soi(int n) {
  int ok = 0;
  if (n > 4 && asset_at(0) = 255 && asset_at(1) = 216) { ok = 1; }
} return int ok;

jpg_walk(int ok) {
  lset((import jpg_st), 8, ok);
  lset((import jpg_st), 9, 2);
  jpg_loop();
} return int jpg_fin();

// The pixels are built after the whole file has been walked, not at the end of
// the scan: a progressive image has several scans and only the last completes
// the coefficients. Baseline reaches here with one scan decoded, which is the
// same thing.
jpg_fin() {
  if ((import jpg_st)[8] = 1 && (import jpg_st)[0] > 0) {
    jpg_all();
  }
} return int (import jpg_st)[8];
