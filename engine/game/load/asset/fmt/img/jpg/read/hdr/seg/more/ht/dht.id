// The Huffman tables.
//
// JPEG hands them over already in canonical form: sixteen counts, one per code
// length, then the symbols in canonical order. That is exactly the (counts,
// symbols) pair the decoder walks, so unlike DEFLATE -- where the lengths arrive
// per symbol and a table has to be built -- there is nothing to build here.
//
// The table index folds class and id together: DC tables are 0..3 and AC tables
// 4..7, so one number selects a table and a component's td and ta are stored
// already offset.

jpg_dht(int p, int end) {
  while (p < end && (import jpg_st)[8] = 1) {
    p = jpg_dht1(p);
  }
} return void;
given jpg_walk1_fixture (181, 201):() then calls jpg_dht1:[1]
given jpg_init (5, 5):() then calls jpg_dht1:[0]

jpg_hcnt(int p, int t) {
  int k = 1;
  while (k <= 16) {
    int asset_at_v = asset_at(p + k - 1);
    lset((import jpg_hc), t * 17 + k, asset_at_v);
    k = k + 1;
  }
} return void;
