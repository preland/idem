jpg_sos1(int p) {
  int asset_at_v2 = asset_at(p);
  jpg_stab(p + 1, 0, asset_at_v2);
  jpg_sos2(p);
} return void;
given jpg_raw_fixture (281):() then calls jpg_stab:(282, 0, 3) then calls jpg_sos2:(281)
given jpg_raw_fixture (0):() then calls jpg_stab:(1, 0, 255) then calls jpg_sos2:(0)

jpg_sos2(int p) {
  int asset_at_v3 = asset_at(p);
  jpg_scan(p + 1 + asset_at_v3 * 2);
} return void;
given jpg_raw_fixture (281):() then calls jpg_scan:(288)
given jpg_raw_fixture (0):() then calls jpg_scan:(511)
