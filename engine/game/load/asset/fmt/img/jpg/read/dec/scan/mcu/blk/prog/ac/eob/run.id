// The extra bits are read only when there are any: recv(0) would be harmless but
// the run length must be computed before them, and keeping the two apart is what
// makes the order visible.
jpg_eobset(int n, int rn) {
  if (rn > 0) {
    n = n + jpg_recv(rn);
  }
  lset((import jpg_st), 17, n);
} return void;
