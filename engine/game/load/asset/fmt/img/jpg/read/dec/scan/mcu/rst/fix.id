// A synthetic restart marker (FF D0, RST0) poked into grad.jpg's own loaded
// bytes at file offset 300/301 -- well past the scan header, well before
// EOI -- the bit reader positioned just before it, and the restart interval
// flagged (jpg_st[7]=1). For rst.id and seek.id's cases.
jpg_rstbyte_fixture() {
  jpg_raw_fixture();
  jpg_rstbyte_set();
  jpg_bset(280);
} return void;
():() then jpg_bcursor_check:(280)
given jpg_init ():() then jpg_bcursor_check:(280)

