// 208..215 are RST0..RST7.
jpg_isrst(int p) {
  int ok = 0;
  if (asset_at(p) = 255 && asset_at(p + 1) >= 208 && asset_at(p + 1) <= 215) { ok = 1; }
} return int ok;
