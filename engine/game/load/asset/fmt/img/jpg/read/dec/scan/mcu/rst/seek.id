// Walking to just past the next restart marker, and clearing the predictors.

jpg_seek() {
  while ((import jpg_b)[0] < (import asset_io)[1] - 1 && jpg_isrst((import jpg_b)[0]) = 0) {
    lset((import jpg_b), 0, (import jpg_b)[0] + 1);
  }
  lset((import jpg_b), 0, (import jpg_b)[0] + 2);
} return void;

jpg_isrst(int p) {
  int ok = 0;
  if (asset_at(p) = 255 && asset_at(p + 1) >= 208 && asset_at(p + 1) <= 215) { ok = 1; }
} return int ok;

jpg_preds(int ci) {
  while (ci < (import jpg_st)[2]) {
    lset((import jpg_c), ci * 10 + 6, 0);
    ci = ci + 1;
  }
} return void;
