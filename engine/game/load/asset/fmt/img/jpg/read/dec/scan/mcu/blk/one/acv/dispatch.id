// The two shapes a symbol takes, and writing a coefficient.
//
// A zero size means one of two things: a run of exactly sixteen zeros (run 15),
// or the end of the block (any other run). A non-zero size means skip `rn`
// zeros and take a value.

jpg_ac2(int ci, int a, int k, int rn, int sz) {
  int nk = 0;
  if (sz = 0) { nk = jpg_eob(k, rn); }
  else { nk = jpg_acv(ci, a, k + rn, sz); }
} return int nk;
given jpg_coefbuf_fixture (0, (import jpg_coef_a), 1, 0, 7):(2) then calls jpg_acv:(0, (import jpg_coef_a), 1, 7)
given jpg_coefbuf_fixture (0, (import jpg_coef_a), 1, 0, 0):(0) then calls jpg_eob:(1, 0)

jpg_eob(int k, int rn) {
  int nk = 0;
  if (rn = 15) { nk = k + 16; }
} return int nk;
(1, 15):(17)
(1, 0):(0)

// The zigzag map turns the transmission order into the block's natural order,
// and the quantisation table is indexed by the transmission order -- so `k`
// serves both, one through jpg_zz and one directly.
// The coefficient is stored **quantised**. Dequantisation waits until every scan
// has been read, because a progressive image's coefficients are not final until
// then and multiplying a partial value by its quantiser would have to be undone.
jpg_acv(int ci, int a, int k, int sz) {
  int nk = 0;
  if (k < 64) {
    jpg_cwrite1(a, k, sz);
    nk = k + 1;
  }
} return int nk;
given jpg_coefbuf_fixture (0, (import jpg_coef_a), 1, 7):(2) then calls jpg_cwrite1:((import jpg_coef_a), 1, 7)
given jpg_coefbuf_fixture (0, (import jpg_coef_a), 64, 7):(0)
