jpg_max1(int ci) {
  lset((import jpg_st), 3, fx_max((import jpg_st)[3], (import jpg_c)[ci * 10 + 1]));
  lset((import jpg_st), 4, fx_max((import jpg_st)[4], (import jpg_c)[ci * 10 + 2]));
} return void;

jpg_grid() {
