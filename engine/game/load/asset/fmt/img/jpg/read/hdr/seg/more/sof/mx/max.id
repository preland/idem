// The sampling maxima, and the grid.

jpg_maxes(int ci) {
  while (ci < (import jpg_st)[2]) {
    jpg_max1(ci);
    ci = ci + 1;
  }
} return void;

jpg_grid() {
  jpg_gridc(0, 3, 5);
  jpg_gridc(1, 4, 6);
} return void;

jpg_gridc(int szi, int sfi, int outi) {
  int fx_max_v = fx_max(8 * (import jpg_st)[sfi], 1);
  lset((import jpg_st), outi, ((import jpg_st)[szi] + 8 * (import jpg_st)[sfi] - 1) / fx_max_v);
} return void;
