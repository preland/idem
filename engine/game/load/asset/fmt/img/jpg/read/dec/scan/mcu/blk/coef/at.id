// Where a block's coefficients live.
// Where a block's 64 coefficients live: the component's buffer, indexed in the
// MCU-padded grid so that interleaved and non-interleaved scans address the same
// block by the same arithmetic. Two bytes each.
jpg_bat(int ci, int bx, int by) {
  int ret_i = (import jpg_ca)[ci] + (by * (import jpg_c)[ci * 10 + 8] + bx) * 128;
} return int ret_i;
