// One step of the advance.
//
// A nonzero coefficient takes a correction bit and the walk continues. A zero one
// either counts down the run or, when the run is spent, receives the new value --
// and that is what returns the machine to reading symbols.

jpg_radv1(int a) {
  if (jpg_cget(a, (import jpg_zz)[(import jpg_r)[0]]) != 0) {
    jpg_rcorr(a, (import jpg_r)[0]);
  } else {
    jpg_rzero(a);
  }
  lset((import jpg_r), 0, (import jpg_r)[0] + 1);
} return void;

jpg_rzero(int a) {
  if ((import jpg_r)[1] = 0) {
    jpg_rput(a);
  } else {
    lset((import jpg_r), 1, (import jpg_r)[1] - 1);
  }
} return void;

// The new coefficient. Phase goes back to 0 so the outer machine reads the next
// symbol; the caller's own increment moves past this position.
jpg_rput(int a) {
  jpg_cset(a, (import jpg_zz)[(import jpg_r)[0]], (import jpg_r)[2]);
  lset((import jpg_r), 3, 0);
} return void;
