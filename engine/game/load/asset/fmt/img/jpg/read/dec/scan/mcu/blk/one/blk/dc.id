jpg_dc1(int ci, int a, int diff) {
  int jpg_c_v = (import jpg_c)[ci * 10 + 6];
  lset((import jpg_c), ci * 10 + 6, jpg_c_v + diff);
  jpg_dc2(ci, a);
} return void;
