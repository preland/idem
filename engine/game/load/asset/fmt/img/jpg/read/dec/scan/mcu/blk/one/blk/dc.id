jpg_dc2(int ci, int a) {
  int jpg_c_v2 = (import jpg_c)[ci * 10 + 6];
  int inf_pow2_v = fx_pow(2, (import jpg_st)[16]);
  jpg_cset(a, 0, jpg_c_v2 * inf_pow2_v);
} return void;
