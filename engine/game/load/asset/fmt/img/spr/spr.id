// spr -- a decoded PNG, registered as sprite frames.
//
// png_load leaves unfiltered rows in the flat store; nothing above it can draw
// those. This is the join: it walks them once and writes packed colours into the
// engine's sprite table, after which the image is an ordinary sprite and every
// blit, flip and scaled draw works on it with no knowledge that it came from a
// file.
//
//     spr_png(name, path, cols, rows, cw, ch) -> sprite id, or -1
//
// `cols` x `rows` is the frame grid, numbered row-major, which is how sheets in
// the wild are laid out (test_assets/spryte-run.png is 5x5 of 512x512). A whole
// image as one frame is 1, 1. `cw` x `ch` is the size each frame is sampled down
// to, nearest-neighbour; 0 in either means "keep the source cell's size".
//
// The cell size is not optional decoration. A 2560x2560 sheet is 6.5 million
// pixels and a list cell is eight bytes, so loading one at full size would cost
// 52 MB to draw on a 320x200 surface. Sampling on the way in is the only point
// where that can be avoided -- the sprite table holds what it is given.
//
// Transparency is decided by ALPHA, never by colour: a fully transparent pixel
// can carry a real one (pixel (0,0) of the test sheet is 250 249 252 0), so a
// loader that keyed on the colour would punch holes in the visible art and keep
// the invisible.

spr_png(string name, string path, int cols, int rows, int cw, int ch) {
  int p = 0 - 1;
  if (png_load(path) = 1) {
    p = spr_png2(name, cols, rows, cw, ch);
  }
} return int p;

// The source cell is the image divided by the grid. Integer division, so a sheet
// whose width is not a multiple of its column count loses the last few pixels of
// each row rather than sliding every frame sideways by a growing offset.
spr_png2(string name, int cols, int rows, int cw, int ch) {
  int sw = (import png_st)[0] / fx_max(cols, 1);
  int sh = (import png_st)[1] / fx_max(rows, 1);
  int fx_max_v = fx_max(cols, 1);
  int fx_max_v2 = fx_max(rows, 1);
  int spr_cell_v = spr_cell(cw, sw);
  int spr_cell_v2 = spr_cell(ch, sh);
  int ret_i = spr_dims(name, fx_max_v, fx_max_v2, spr_cell_v, spr_cell_v2, sw, sh);
} return int ret_i;

// 0 or less means the source cell's own size. Floored at 1 either way: a zero
// dimension would make d2_spr_add allocate nothing and every later index abort.
spr_cell(int v, int n) {
  int m = v;
  if (v <= 0) { m = n; }
  int ret_i = fx_max(m, 1);
} return int ret_i;
