// Inflating the gathered stream, and undoing the filters.
//
// The output is exactly h rows of (1 + w * channels) bytes: the filter byte and
// the filtered pixels. Sizing it from the header rather than from the stream is
// what makes a lying length field harmless -- inf_put refuses to write past the
// capacity, so a stream that claims more simply faults.

png_inflate() {
  int n = (import png_st)[1] * (import png_st)[8];
  png_inflate_alloc(n);
  int png_inf2_v = png_inf2(n);
  lset((import png_st), 9, png_inf2_v);
  int ret_i = (import png_st)[9];
} return int ret_i;

// asset_io[0] + offset: the walk speaks in offsets from the start of the file and
// the store speaks in addresses. The +2 skips the zlib header.
png_inf2(int n) {
  int got = inf_run((import asset_io)[0] + (import png_st)[5] + 2, (import png_st)[6] - 2, (import png_st)[7], n);
  int ok = got = n;
  int ret_i = png_unfilt(ok);
} return int ret_i;

// Every scanline carries a filter byte saying how it was predicted from its
// neighbours, and undoing it must happen top to bottom and left to right: the
// prediction refers to bytes this loop has already corrected, so a row cannot be
// unfiltered out of order.
png_unfilt(int ok) {
  int y = 0;
  while (y < (import png_st)[1] && ok = 1) {
    int asset_row_v = asset_row(y);
    png_row(y, asset_row_v);
    y = y + 1;
  }
} return int ok;
