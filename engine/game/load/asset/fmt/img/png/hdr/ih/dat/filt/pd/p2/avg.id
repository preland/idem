// Average and Paeth -- the two filters that look at both neighbours.

png_pred3(int y, int r, int i, int f) {
  int v = 0;
  if (f = 3) { v = (png_left(r, i) + png_up(y, i)) / 2; }
  else if (f = 4) { int png_left_v = png_left(r, i); int png_up_v = png_up(y, i); int png_ul_v = png_ul(y, i); v = png_paeth(png_left_v, png_up_v, png_ul_v); }
} return int v;
