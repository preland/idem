// Average and Paeth -- the two filters that look at both neighbours.

png_pred3(int y, int r, int i, int f) {
  int v = 0;
  if (f = 3) { v = (png_left(r, i) + png_up(y, i)) / 2; }
  else if (f = 4) { v = png_pred3_p(y, r, i); }
} return int v;

png_pred3_p(int y, int r, int i) {
  int png_left_v = png_left(r, i);
  int png_up_v = png_up(y, i);
  int v = png_pred3_p2(y, i, png_left_v, png_up_v);
} return int v;

png_pred3_p2(int y, int i, int png_left_v, int png_up_v) {
  int png_ul_v = png_ul(y, i);
  int v = png_paeth(png_left_v, png_up_v, png_ul_v);
} return int v;
