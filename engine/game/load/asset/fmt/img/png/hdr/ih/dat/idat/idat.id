// Moving one IDAT payload into place.

png_gather(int p, int n) {
  int i = 0;
  png_first(p);
  while (i < n) {
    int next_i = png_gather_one(p, i);
    i = next_i;
  }
} return void;

// The first IDAT decides where the gathered stream lives. Its own payload is
// already in the right place, so the copy above is a self-copy for that chunk --
// harmless, and cheaper than a branch per byte.
png_first(int p) {
  if ((import png_st)[5] = 0) {
    lset((import png_st), 5, p);
  }
} return void;

// Two bytes of zlib header, then the deflate stream. The header's window size and
// preset-dictionary bit are not consulted: PNG forbids a preset dictionary, and
// the window only bounds distances this decoder already validates against what it
// has actually written.
png_done() {
  int ok = 0;
  if ((import png_st)[9] = 2 && (import png_st)[6] > 2) { ok = png_inflate(); }
} return int ok;
