// The PSF2 header, and the one test that decides whether a file is safe to read.

// PSF2's seven 32-bit fields, at fixed offsets: 4 version, 8 header size,
// 12 flags, 16 glyph count, 20 charsize, 24 height, 28 width. Version and flags
// are read by nobody -- version is 0 in every file that exists, and the only
// flag says a unicode table follows the glyphs, which this decoder skips (psf.id).
//
// The header size is taken from the file rather than assumed to be 32, which is
// the one piece of forward compatibility PSF2 has and it costs nothing to honour.
psf_two() {
  int psf_fld_v = psf_fld(8);
  int psf_fld_v2 = psf_fld(16);
  int psf_fld_v3 = psf_fld(20);
  int psf_fld_v4 = psf_fld(24);
  int psf_fld_v5 = psf_fld(28);
  int ret_i = psf_one(psf_fld_v, psf_fld_v2, psf_fld_v3, psf_fld_v4, psf_fld_v5);
} return int ret_i;

// One header field: 32-bit little-endian, of which only the low three bytes are
// taken -- a fourth byte that is not zero answers -1 and refuses the file.
//
// That is not laziness about the top byte. Every field in the format is small
// (the largest legitimate one is a glyph count of 512), and `int` is 32 bits and
// signed, so a full-width read of a corrupt or hostile field can hand back a
// negative number that passes every `<=` bound below it. Three bytes cannot: the
// value is in 0..16777215, and psf_fit's ceilings do the rest.
//
// It is also why this is not asset_be32 or bl_le32. A .blend reads the same four
// bytes the same way round, and the compiler rejected the copy -- correctly, they
// were the same function. This one is a different function: it has a guard.
psf_fld(int p) {
  int v = 0 - 1;
  if (asset_at(p + 3) = 0) {
    v = asset_at(p) + asset_at(p + 1) * 256 + asset_at(p + 2) * 65536;
  }
} return int v;

// Is this a face this engine can hold, and does its glyph data fit in the file?
//
// The width ceiling is 24 and not 32: a packed row is an int, `int` is 32 bits
// and signed, and a 32-wide row would set the sign bit and make the `>>` in
// txt_px_sc arithmetic rather than logical. 24 covers every fixed face in
// existence -- the widest kbd(1) ships is 16 -- and leaves the sign bit clear by
// a whole byte.
//
// The height ceiling is 64 because txt_row_sc packs a row index and a column
// index as `j * 256 + k` and a taller face would collide the two. The charsize
// test allows a glyph *bigger* than its rows need, because the format permits
// padding, and refuses one that is smaller, because that is a file that would be
// read past. The two ceilings on cs and n are there so that `sa + n * cs` cannot
// overflow into a positive number smaller than the file -- 65536 * 256 is 2^24,
// with seven bits of headroom left. The count has to clear (import txt_first): a font
// with no printable ASCII is not one this engine can draw with.
psf_fit(int sa, int n, int cs, int h, int w) {
  int ok = 0;
  if (w >= 1 && w <= 24 && h >= 1 && h <= 64 && cs >= h * ((w + 7) / 8) && cs <= 256 && n <= 65536) {
    ok = n > (import txt_first) && sa > 0 && sa + n * cs <= (import asset_io)[1];
  }
} return int ok;
