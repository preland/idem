psf_copy2(int sa, int n, int cs, int h, int w) {
  psf_glyphs(sa + (import txt_first) * cs, n - (import txt_first), cs, h, (w + 7) / 8);
} return void;
given psf_vga_fixture (32, 256, 16, 16, 8):() then calls psf_glyphs:(544, 224, 16, 16, 1)
given psf_vga_fixture (0, 64, 8, 8, 4):() then calls psf_glyphs:(256, 32, 8, 8, 1)
