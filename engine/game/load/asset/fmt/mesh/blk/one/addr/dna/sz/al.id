// Four-byte alignment, measured from the SDNA payload's start.

bl_al(int p) {
  int ret_i = (import bl_st)[2] + ((p - (import bl_st)[2] + 3) / 4) * 4;
} return int ret_i;
given bl_al_t_setup (0):(0)
given bl_al_t_setup (1):(4)

bl_le16(int p) {
  int ret_i = asset_at(p) + asset_at(p + 1) * 256;
} return int ret_i;
given bl_tlen_t_bytes (0):(4)
given bl_tlen_t_bytes (2):(8)

// The size of one type, from TLEN.
bl_tlen(int i) {
  int ret_i = bl_le16((import bl_st)[9] + i * 2);
} return int ret_i;
given bl_tlen_t_setup (0):(4)
given bl_tlen_t_setup (1):(8)
