// The two string tables, and the alignment they are padded to.

bl_names(int p) {
  int bl_le32_v = bl_le32(p);
  lset((import bl_st), 4, bl_le32_v);
  lset((import bl_st), 7, p + 4);
  int bl_skip_v = bl_skip(p + 4, (import bl_st)[4]);
  bl_types(bl_skip_v);
} return void;

bl_types(int p) {
  int bl_le32_v = bl_le32(p + 4);
  lset((import bl_st), 5, bl_le32_v);
  lset((import bl_st), 8, p + 8);
  int bl_skip_v = bl_skip(p + 8, (import bl_st)[5]);
  bl_tlens(bl_skip_v);
} return void;

// Past n NUL-terminated strings, then aligned. The alignment is measured from the
// SDNA payload's start, not from the file's -- getting that wrong lands one byte
// off and the next tag reads as garbage.
bl_skip(int p, int n) {
  int i = 0;
  while (i < n) {
    p = bl_zend(p);
    i = i + 1;
  }
  int ret_i = bl_al(p);
} return int ret_i;
