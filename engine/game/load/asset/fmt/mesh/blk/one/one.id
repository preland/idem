  if (asset_at(p) = 69 && asset_at(p + 1) = 78 && asset_at(p + 2) = 68 && asset_at(p + 3) = 66) { ok = 1; }
} return int ok;

bl_block(int p) {
  int n = bl_le32(p + 16);
  push((import bl_ba), bl_le64(p + 8));
  bl_push(asset_be32(p), p + 32, n, bl_le32(p + 4));
} return int p + 32 + n;

bl_push(int kd, int p, int n, int i) {
  push((import bl_bc), kd);
  push((import bl_bp), p);
  bl_push2(n, i);
} return void;
