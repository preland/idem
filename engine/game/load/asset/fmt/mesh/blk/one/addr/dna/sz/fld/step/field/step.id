given bl_sfind_t_setup (61, "y", 3):() then bl_fdone:(-1)

// bl_st[3] holds the hit as offset+1, so 0 means "no such field" and offset 0 is
// still expressible. The struct's total size is the walk's return value.
bl_fdone() {
  int k = (import bl_st)[3] - 1;
  lset((import bl_st), 3, 0);
} return int k;
