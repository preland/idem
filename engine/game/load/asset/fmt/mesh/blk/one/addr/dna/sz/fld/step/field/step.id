// One field of the walk.
//
// The answer is smuggled through bl_st[3]: the walk has to keep accumulating to
// compute the struct's own size (which is what verifies the arithmetic), so it
// cannot stop at the match -- and a loop in this language cannot break out anyway.

bl_fstep(int p, string name, int o) {
  int np = bl_ftype(p);
  bl_fhit(np, name, o);
  int ret_i = bl_fsz_at(p, np);
} return int ret_i;

bl_fhit(int np, string name, int o) {
  if (bl_streq(np, name) = 1) {
    lset((import bl_st), 3, o + 1);
  }
} return void;

// bl_st[3] holds the hit as offset+1, so 0 means "no such field" and offset 0 is
// still expressible. The struct's total size is the walk's return value.
bl_fdone() {
  int k = (import bl_st)[3] - 1;
  lset((import bl_st), 3, 0);
} return int k;
