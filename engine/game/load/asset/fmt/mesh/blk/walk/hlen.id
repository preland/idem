// The header length, then the walk.
//
// Blender 5.x writes `BLENDER` followed by two ASCII digits giving the header's
// own length -- 17 for this file, where the classic header was 12. A reader that
// assumes 12 starts the block walk five bytes early and every field after is
// noise.
// The header length, then the walk. Two ASCII digits at offset 7.
bl_hlen() {
  int asset_at_v = asset_at(7);
  int asset_at_v2 = asset_at(8);
  lset((import bl_st), 0, (asset_at_v - 48) * 10 + asset_at_v2 - 48);
  bl_clear();
  int ret_i = bl_walk((import bl_st)[0]);
} return int ret_i;
