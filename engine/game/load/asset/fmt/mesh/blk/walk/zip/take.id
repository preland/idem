// Taking the decompressed bytes, if it worked.
//
// A failure leaves asset_io pointing at the compressed file, so bl_head then
// fails to find `BLENDER` and bl_open answers 0 -- one failure path, not two.

bl_unz3(int da, int cap) {
  bl_unz4(da, zst_run((import asset_io)[0], (import asset_io)[1], da, cap));
} return void;

bl_unz4(int da, int got) {
  if (got > 0) {
    lset((import asset_io), 0, da);
    lset((import asset_io), 1, got);
  }
} return void;
