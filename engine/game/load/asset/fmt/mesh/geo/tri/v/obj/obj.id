// obj -- an Object's world transform.
//
// A mesh in a .blend is geometry in its own local space; where it stands in the
// scene is an Object's business. The showroom has 49 mesh objects over 29 meshes
// -- the ceiling lights share one -- so a scene is drawn by walking OBJECTS, each
// placing its mesh with its own matrix. Without this every mesh sits at the
// origin and the room is a pile.
//
// The composition is translate * rotate * scale, with rotation as an XYZ Euler
// triple: R = Rz * Ry * Rx, which is what `rotation_mode = 'XYZ'` means. Rather
// than three matrix products, the rotation is built once and its columns are
// scaled in place -- a diagonal scale on the right is exactly that -- and the
// translation is written into the fourth column, which is exactly what a pure
// translation on the left does.
//
// **Parenting is not composed yet.** 47 of the 49 objects here are parented to
// `walls`, whose own transform is the identity and whose `parentinv` is the
// identity too, so world == local for every object in this file and the result is
// exact. A file where a parent is moved would need
// `world = parent.world * parentinv * local`, and that is the next piece.
//
// **Field names in the SDNA carry their array brackets**: the Object struct's
// fields are spelled `loc[3]`, `rot[3]` and `size[3]`, not `loc`, `rot`, `size`.
// Asking for the bare name finds nothing, bl_foff answers -1, and every read
// lands one byte before the struct -- which produced a zero scale and put all
// 130 657 vertices of the showroom at the origin.
//
// Angles are radians in the file and millidegrees in the engine: 180000/pi is
// 57295.8, and bl_f32 already scaled by 1000, so the conversion is one multiply
// by 57296 and a divide by 1000 -- good to a thousandth of a degree.

bl_wm_init() {
  export int[] bl_wm = m4_new();
} return void;

bl_world(int p, int si) {
  m4_ident((import bl_wm));
  bl_wrot(p, si);
  bl_wts(p, si);
} return void;

// Rotation, as Rz * Ry * Rx built straight into the destination.
bl_wrot(int p, int si) {
  m4_rot4((import bl_wm), 0, 1, 4, 5, bl_deg(bl_f32(p + bl_foff(si, "rot[3]") + 8)));
  bl_wrx(p, si);
} return void;
