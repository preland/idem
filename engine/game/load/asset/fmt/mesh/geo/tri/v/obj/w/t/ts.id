// Scale on the right (columns), translation in the fourth column.

bl_wts(int p, int si) {
  int bl_foff_v = bl_foff(si, "size[3]");
  int bl_f32_v = bl_f32(p + bl_foff_v);
  int bl_foff_v2 = bl_foff(si, "size[3]");
  int bl_f32_v2 = bl_f32(p + bl_foff_v2 + 4);
  int bl_foff_v3 = bl_foff(si, "size[3]");
  int bl_f32_v3 = bl_f32(p + bl_foff_v3 + 8);
  bl_wscale(bl_f32_v, bl_f32_v2, bl_f32_v3);
  bl_wtrans(p, si);
} return void;

// Column j scaled by size[j] -- which is what multiplying by a diagonal matrix on
// the right does, without the matrix or the product.
bl_wscale(int a, int b, int c) {
  int i = 0;
  while (i < 3) {
    bl_wcol(i, a, b, c);
    i = i + 1;
  }
} return void;

bl_wcol(int i, int a, int b, int c) {
  int fx_mul_v = fx_mul((import bl_wm)[i * 4], a, 1000);
  lset((import bl_wm), i * 4, fx_mul_v);
  int fx_mul_v2 = fx_mul((import bl_wm)[i * 4 + 1], b, 1000);
  lset((import bl_wm), i * 4 + 1, fx_mul_v2);
  int fx_mul_v3 = fx_mul((import bl_wm)[i * 4 + 2], c, 1000);
  lset((import bl_wm), i * 4 + 2, fx_mul_v3);
} return void;
