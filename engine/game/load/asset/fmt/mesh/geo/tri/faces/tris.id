// One face's corner range, read from the poly-offset block and fanned.

bl_tris_fan(int cv, int po, int f) {
  int bl_le32_v = bl_le32((import bl_bp)[po] + f * 4);
  int bl_le32_v2 = bl_le32((import bl_bp)[po] + f * 4 + 4);
  bl_fan(cv, bl_le32_v, bl_le32_v2);
} return void;
given bl_mesh_t_load (0, 1074, 0):() then calls bl_fan:[1]
given bl_mesh_t_load (1069, 1074, 0):() then calls bl_fan:[1]
