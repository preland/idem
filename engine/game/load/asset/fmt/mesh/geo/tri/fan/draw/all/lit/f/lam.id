// bl_lam's clamp, split out so that function's own block still fits its
// action budget.
bl_lamc(word wp) {
  int a = wp;
  int fx_abs_v = fx_abs(a);
  int ret_i = fx_clamp(fx_abs_v, 0, 1000);
} return int ret_i;
