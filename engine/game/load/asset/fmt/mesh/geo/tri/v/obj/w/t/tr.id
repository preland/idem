// The translation, and radians to millidegrees.

bl_wtrans(int p, int si) {
  int bl_foff_v = bl_foff(si, "loc[3]");
  int bl_f32_v = bl_f32(p + bl_foff_v);
  int bl_foff_v2 = bl_foff(si, "loc[3]");
  int bl_f32_v2 = bl_f32(p + bl_foff_v2 + 4);
  m4_pair((import bl_wm), 3, 7, bl_f32_v, bl_f32_v2);
  int bl_foff_v3 = bl_foff(si, "loc[3]");
  int bl_f32_v3 = bl_f32(p + bl_foff_v3 + 8);
  lset((import bl_wm), 11, bl_f32_v3);
} return void;

// bl_f32 already scaled by 1000, so this turns milliradians into millidegrees:
// 180000/pi = 57295.8, and the product stays inside an int for any angle a file
// can hold (2*pi milliradians is 6283, times 57296 is 3.6e8).
bl_deg(int mrad) {
  int ret_i = mrad * 57296 / 1000;
} return int ret_i;
