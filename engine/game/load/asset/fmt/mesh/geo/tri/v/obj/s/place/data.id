// The Object's `*data` pointer, resolved to a block index and handed to bl_obj3.

bl_obj2_data(int i, int si) {
  int bl_gat_v = bl_obj2_mi(i, si);
  bl_obj3(i, si, bl_gat_v);
} return void;
