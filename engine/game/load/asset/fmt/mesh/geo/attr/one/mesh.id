// "ME\0\0" packed most significant byte first: 77*2^24 + 69*2^16 = 1296367616.
bl_mesh3(int p) {
  int si = bl_sfind("Mesh");
  bl_verts(p, si);
  int ret_i = bl_faces(p, si);
} return int ret_i;
