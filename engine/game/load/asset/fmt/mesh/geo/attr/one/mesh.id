// An int field of a struct, by name -- the field offset comes from the file's own
// schema, so this reads the same field correctly in a file from any version.
bl_mint(int p, int si, string name) {
  int bl_foff_v = bl_foff(si, name);
  int ret_i = bl_le32(p + bl_foff_v);
} return int ret_i;
