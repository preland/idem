// The second of the pair, and the same tail on the other side.

huf_wc(int n) {
  int fse_dsym_v = fse_dsym(3, (import huf_ab)[1]);
  lset((import huf_wt), n, fse_dsym_v);
  int ret_i = huf_wc_next(n);
} return int ret_i;
given huf_init given huf_wstart_test_setup_a given huf_wstart_ab (0):(1)
given huf_init given huf_wstart_test_setup_b given huf_wstart_ab (1):(2)

huf_wd(int n) {
  int m = n;
  if (zb_done() = 1) {
    int fse_dsym_v = fse_dsym(3, (import huf_ab)[0]);
    lset((import huf_wt), n, fse_dsym_v);
    m = n + 1;
  }
} return int m;
given huf_wstart_test_setup_a given huf_wstart_ab (0):(0)
given huf_wstart_test_setup_b given huf_wstart_ab (1):(1)

huf_wc_next(int n) {
  int fse_dnext_v = fse_dnext(3, (import huf_ab)[1]);
  lset((import huf_ab), 1, fse_dnext_v);
  int ret_i = huf_wd(n + 1);
} return int ret_i;
given huf_wstart_test_setup_a given huf_wstart_ab (0):(1)
given huf_wstart_test_setup_b given huf_wstart_ab (1):(2)
