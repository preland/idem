// Placing one symbol, and filling the decode table.
//
// A symbol of weight w occupies `(1 << w) >> 1` consecutive entries and its code
// is `tableLog + 1 - w` bits long. Weight 0 symbols occupy nothing. Filling by
// weight, in order, is what makes every entry of one run identical -- which is why
// the reference can memcpy them and why this can write them in a flat loop.

huf_sput(int i, int w) {
  lset((import huf_sm), (import huf_rs)[w], i);
  lset((import huf_rs), w, (import huf_rs)[w] + 1);
} return void;

huf_fill() {
  int w = 1;
  int p = 0;
  huf_fill_loop(w, p);
} return void;

// Where weight w's symbols start in the ordered list: the running total of every
// lower weight's count, weight 0 excluded because it holds no table entries.
huf_first(int w) {
  int k = 1;
  int p = 0;
  while (k < w) {
    p = p + (import huf_rk)[k];
    k = k + 1;
  }
} return int p;
