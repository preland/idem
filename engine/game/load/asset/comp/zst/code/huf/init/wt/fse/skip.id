// Where the weight bitstream starts inside the description.
//
// fse_read consumed the table description with the FORWARD reader; the bitstream
// that follows is read BACKWARD from the end of the same section. zf_used reports
// how many bytes the description took, and that is where the bitstream begins.

huf_wskip() {
  int ret_i = zf_used();
} return int ret_i;

huf_ab_init() {
  export int[] huf_ab = [0, 0];
} return void;

huf_wstart() {
  int fse_dstart_v = fse_dstart(3);
  lset((import huf_ab), 0, fse_dstart_v);
  int fse_dstart_v2 = fse_dstart(3);
  lset((import huf_ab), 1, fse_dstart_v2);
} return void;
