// One weight's run of table entries.

huf_fill1(int w, int p, int s0) {
  int i = 0;
  while (i < (import huf_rk)[w]) {
    int huf_sm_v = (import huf_sm)[s0 + i];
    int huf_st_v = (import huf_st)[0];
    int inf_pow2_v = inf_pow2(w);
    p = huf_frun(p, huf_sm_v, huf_st_v + 1 - w, inf_pow2_v / 2);
    i = i + 1;
  }
} return int p;

huf_frun(int p, int kd, int nb, int n) {
  int i = 0;
  while (i < n) {
    huf_fput(p + i, kd, nb);
    i = i + 1;
  }
  int ret_i = p + n;
} return int ret_i;

huf_fput(int p, int kd, int nb) {
  lset((import huf_sy), p, kd);
  lset((import huf_nb), p, nb);
} return void;
