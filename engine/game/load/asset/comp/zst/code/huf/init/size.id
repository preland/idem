// Sizing the tables.
//
// A Huffman table log is at most 11, so 2048 entries; there are at most 256
// symbols and weights, and 12 ranks (0..11).

huf_init4() {
  export int[] huf_nb = [];
  lst_fill((import huf_st), 4, 0);
  huf_init5();
} return void;

huf_init5() {
  lst_fill((import huf_wt), 256, 0);
  lst_fill((import huf_rk), 16, 0);
  huf_init6();
} return void;

huf_init6() {
  lst_fill((import huf_rs), 16, 0);
  lst_fill((import huf_sm), 256, 0);
  huf_init7();
} return void;
