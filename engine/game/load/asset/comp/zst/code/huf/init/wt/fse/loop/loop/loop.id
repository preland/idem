// The two-state weight loop, and its asymmetric tail.
//
// FSE_decompress alternates two states, and the stream's *length* -- not a count
// -- is what ends it: the number of weights is whatever the bitstream yields. The
// reference checks whether the stream has run out **between** the two symbols of
// each pair, and emits one final symbol from the other state when it has.
//
// Checking only once per pair, as an earlier version here did, stops up to two
// symbols early. That is invisible in the weight histogram -- the missing weights
// are trailing zeros -- but it shifts which symbol the implied final weight
// belongs to, and every code in the table after it.

huf_wloop(int n) {
  while (n < 255 && zb_done() = 0) {
    n = huf_wa(n);
  }
} return int n;

huf_wa(int n) {
  int fse_dsym_v = fse_dsym(3, (import huf_ab)[0]);
  lset((import huf_wt), n, fse_dsym_v);
  int ret_i = huf_wa_next(n);
} return int ret_i;

// If the stream ended with the first of the pair, the second state still owes one
// symbol -- and it is emitted without an update, because there are no bits left
// for one.
huf_wb(int n) {
  int m = n + 1;
  if (zb_done() = 0) {
    m = huf_wc(n);
  } else {
    int fse_dsym_v = fse_dsym(3, (import huf_ab)[1]);
    lset((import huf_wt), n, fse_dsym_v);
  }
} return int m;
