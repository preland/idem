// Weights written directly, four bits each, high nibble first.

huf_direct(int p, int n) {
  int i = 0;
  while (i < n) {
    huf_dpair(p, i, n);
    i = i + 2;
  }
} return int n;
given huf_init (0, 0):(0)
given huf_frame_setup (0, 2):(2)

huf_dpair(int p, int i, int n) {
  int v = peek8((import zst_st)[0] + p + i / 2) / 16;
  lset((import huf_wt), i, v);
  huf_dodd(p, i, n);
} return void;
given huf_frame_setup (0, 0, 1):()
given huf_frame_setup (0, 1, 2):()

// The second nibble of the pair, unless the count is odd and this is the tail.
huf_dodd(int p, int i, int n) {
  if (i + 1 < n) {
    int v = peek8((import zst_st)[0] + p + i / 2) % 16;
    lset((import huf_wt), i + 1, v);
  }
} return void;
given huf_init (0, 0, 1):()
given huf_frame_setup (0, 1, 3):()
