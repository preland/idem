// Helper for dropping bits from zf state.

zf_drop_update(int zf_st_v, int inf_pow2_v, int n) {
  lset((import zf_st), 2, zf_st_v / inf_pow2_v);
  lset((import zf_st), 3, (import zf_st)[3] - n);
} return void;
given fse_init (255, 2, 1):()
given fse_init (64, 4, 2):()

