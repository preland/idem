// One symbol's slots, and stepping past the low-probability region.

fse_sp2(int kd, int step, int p) {
  int i = 0;
  while (i < (import fse_ct)[kd]) {
    p = fse_sp3(kd, step, p);
    i = i + 1;
  }
} return int p;

fse_sp3(int kd, int step, int p) {
  lset((import fse_sy), (import fse_st)[6] + p, kd);
} return int fse_skip(step, (p + step) % (import fse_st)[7]);

// Slots above `high` already hold the -1 symbols, so the walk steps over them
// rather than through them. The size is a power of two, so `% size` is the mask
// the reference implementation writes as `& (size - 1)`.
fse_skip(int step, int p) {
  while (p > (import fse_st)[8]) {
    p = (p + step) % (import fse_st)[7];
  }
} return int p;
