// sp*8 - nbits = 16 - 7 = 9, one past a multiple of 8 -- the boundary where
// ceil(9/8) = 2 only holds with the exact "+7" rounding constant.
zf_used_setup() {
  fse_init();
  m4_pair((import zf_st), 1, 3, 2, 7);
} return void;
