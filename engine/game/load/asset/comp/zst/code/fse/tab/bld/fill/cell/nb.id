// Helper for fse_bcell2 filling.

fse_bcell2_fill(int u, int ns) {
  fse_bcell2_nb(u, ns);
  fse_bbase(u, ns);
} return void;

fse_bcell2_nb(int u, int ns) {
  int fse_st_v = (import fse_st)[6];
  int fse_hib_v = fse_hib(ns);
  fse_bcell2_upd(fse_st_v, u, ns, fse_hib_v);
} return void;

fse_bcell2_upd(int fse_st_v, int u, int ns, int fse_hib_v) {
  int fse_st_v2 = (import fse_st)[0];
  lset((import fse_nb), fse_st_v + u, fse_st_v2 - fse_hib_v);
} return void;
