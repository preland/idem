// The base state, and the highest set bit it needs.

fse_bbase(int u, int ns) {
  int fse_st_v = (import fse_st)[6];
  int inf_pow2_v = fx_pow(2, (import fse_nb)[(import fse_st)[6] + u]);
  lset((import fse_bs), fse_st_v + u, ns * inf_pow2_v - (import fse_st)[7]);
} return void;
given fse_init (0, 1):()
given fse_init (1, 2):()

// The index of the highest set bit: 0 for 1, 1 for 2-3, 2 for 4-7. A loop rather
// than a table because it runs once per table slot at build time, never per
// symbol at decode time.
fse_hib(int v) {
  int b = 0;
  while (v > 1) {
    v = v / 2;
    b = b + 1;
  }
} return int b;
(1):(0)
(2):(1)
(4):(2)
(3):(1)
(7):(2)
(8):(3)
