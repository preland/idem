// One byte into the buffer, and the peek/drop pair.

zf_more2() {
  lset((import zf_st), 2, (import zf_st)[2] + peek8((import zf_st)[0] + (import zf_st)[1]) * inf_pow2((import zf_st)[3]));
  lset((import zf_st), 1, (import zf_st)[1] + 1);
  lset((import zf_st), 3, (import zf_st)[3] + 8);
