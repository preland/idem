// Peek and rewind.

zb_look(int n) {
  int v = zb_take(n);
  zb_rew(n);
} return int v;
given zb_frame_setup (2):(2) then zb_rel_check:([1, 6, 0])
given zb_frame_setup (0):(0) then zb_rel_check:([1, 6, 0])

zb_take(int n) {
  int v = 0;
  int i = 0;
  while (i < n) {
    v = v * 2 + zb_soft();
    i = i + 1;
  }
} return int v;
given zb_frame_setup (2):(2) then zb_rel_check:([1, 4, 0])
given zb_frame_setup (0):(0) then zb_rel_check:([1, 6, 0])

zb_soft() {
  int v = 0;
  if ((import zb_st)[1] >= (import zb_st)[0]) {
    v = peek8((import zb_st)[1]) / fx_pow(2, (import zb_st)[2]) % 2;
  }
  int result = zb_next(v);
} return int result;
given zb_frame_setup ():(1) then zb_rel_check:([1, 5, 0])
given zb_exhausted_setup ():(0) then zb_rel_check:([-1, 5, 0])
