// The three-byte size form, the literals buffer, and filling it.

// 20 bits: the header's top 4, then two whole bytes.
zst_lsz3(int h) {
  int n = h / 16 + zst_byte((import zst_st)[1] + 1) * 16 + zst_byte((import zst_st)[1] + 2) * 4096;
  lset((import zst_st), 1, (import zst_st)[1] + 3);
} return int n;

// One buffer, allocated once at the largest a block's literals can be (a block
// decompresses to at most 128 KiB) and reused by every block of every frame. A
// buffer per block would be an allocation per few kilobytes of output in a
// language that frees nothing.
zst_lbuf(int n) {
  lset((import zst_st), 9, n);
  lset((import zst_st), 10, 0);
  zst_lchk(n);
} return void;

zst_lchk(int n) {
  if (n > zst_lmax()) {
    lset((import zst_st), 6, 1);
  }
} return void;
