// The tables every block reuses, and the literals buffer, sized by zst_lmax in
// engine/conf.id.

zst_tabs() {
  zst_tabs_lit();
  zb_init();
  zst_tabs2();
} return void;

zst_tabs_lit() {
  int v = alloc((import zst_lmax));
  lset((import zst_st), 8, v);
} return void;

zst_tabs2() {
  fse_init();
  zst_stabs_init();
  zst_tabs3();
} return void;
