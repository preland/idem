// The four-stream form.
//
// Six bytes of jump table, then four back-to-back streams. The output is split
// into four equal segments -- `(regenerated + 3) / 4` -- with the last taking
// whatever remains, so a size that does not divide by four leaves the shortfall
// on the fourth stream rather than spreading it.
//
// Each length is read into its own local before any of them is used. They are
// pure reads, but keeping them as separate statements is the habit that has
// already caught three ordering bugs in this module.

zst_l4(int reg, int n) {
  int l1 = zst_l16(0);
  zst_l4_read(reg, n, l1);
} return void;

zst_l4a(int reg, int n, int l1, int l2, int l3) {
  int seg = (reg + 3) / 4;
  zst_l4b(reg, n, seg, l1, l2, l3);
} return void;

zst_l4b(int reg, int n, int seg, int l1, int l2, int l3) {
  zst_l4run(0, seg, 6, l1);
  zst_l4run(seg, seg, 6 + l1, l2);
  zst_l4c(reg, n, seg, l1, l2, l3);
} return void;
