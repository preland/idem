// The same two real fixtures as zst_lhuf's own (mix.zst, four.zst), taken
// one step further: past the literals-section header, with the regenerated
// size already read off (zst_lreg) and the literals buffer already sized
// (zst_lbuf) -- exactly the state zst_lhuf2 expects on entry.

zst_lhuf2_mix_setup() {
  zst_lhuf_mix_setup();
  int reg = zst_lreg(0, 66);
  zst_lbuf(reg);
} return void;
