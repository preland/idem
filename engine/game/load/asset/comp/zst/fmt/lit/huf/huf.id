// Huffman-coded literals: the section header, the tree, then the stream(s).
//
// Types 2 (Compressed, a new tree) and 3 (Treeless, reusing the previous block's)
// share everything but the tree. Size_Format decides both how wide the two size
// fields are and how many streams the literals come in:
//
//     0   10 bits each, ONE stream        1   10 bits each, four streams
//     2   14 bits each, four streams      3   18 bits each, four streams
//
// Four streams exist so a decoder can run them in parallel; here they run one
// after another, which still needs the 6-byte jump table at the front to find
// where each begins.
//
// The compressed size covers the tree description **and** the streams, so the
// stream length is what is left of it after the tree -- and the source cursor has
// to be advanced past the whole thing, or the sequences section is read from the
// middle of the literals.

zst_lhuf(int kd, int sf, int h) {
  int reg = zst_lreg(sf, h);
  zst_lbuf(reg);
  zst_lhuf2(kd, sf, reg);
} return void;

zst_lhuf2(int kd, int sf, int reg) {
  int p0 = (import zst_st)[1];
  zst_ltree(kd);
  zst_lstream(sf, reg, p0);
} return void;

// Slot 14 carries the compressed size out; a function answers one value and both
// sizes are needed. It is NOT slot 3 -- that is the output address, and an earlier
// version of this wrote the size over it.
zst_lreg(int sf, int h) {
  int w = zst_lwid(sf);
  word wp = zst_lval(w);
  zst_lregv(wp, w);
  int ret_i = wp / 16 % inf_pow2(w);
} return int ret_i;
