// `off` is where in the literals buffer this stream's output starts, `m` how
// many symbols it owes, `p` where its bytes begin relative to the section, and
// `len` how many bytes it has.
zst_l4run(int off, int m, int p, int len) {
  lset((import zst_st), 10, off);
  zb_start((import zst_st)[0] + (import zst_st)[1] + p, len);
  huf_dec(m);
} return void;
