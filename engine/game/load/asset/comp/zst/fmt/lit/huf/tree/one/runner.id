// Decoding a Huffman stream into a slice of the literals buffer.
//
// One stream is the degenerate case of four: the whole buffer is one segment
// starting at 0, with no jump table in front of it. Sharing the runner means the
// two forms cannot drift apart.

zst_l1(int reg, int n) {
  zst_l4run(0, reg, 0, n);
} return void;
