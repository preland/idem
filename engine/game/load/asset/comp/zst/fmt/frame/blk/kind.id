// The three block types.

zst_kind(int kd, int n) {
  if (kd = 0) {
    zst_raw(n);
  } else {
    zst_kind2(kd, n);
  }
} return void;
given zst_init (0, 0):() then calls zst_raw:[1]
given zst_src_setup (1, 0):() then calls zst_kind2:[1]

zst_kind2(int kd, int n) {
  if (kd = 1) {
    zst_rle(n);
  } else if (kd = 2) {
    zst_comp(n);
  } else {
    lset((import zst_st), 6, 1);
  }
} return void;
given zst_src_setup (1, 0):() then calls zst_rle:[1]
given zst_init (3, 0):() then zst_err_check:(1)

// Raw: n bytes straight through, source to output.
zst_raw(int n) {
  int i = 0;
  while (i < n && (import zst_st)[6] = 0) {
    int zst_byte_v = zst_byte((import zst_st)[1] + i);
    zst_put(zst_byte_v);
    i = i + 1;
  }
  lset((import zst_st), 1, (import zst_st)[1] + n);
} return void;
given zst_init (0):()
given zst_src_setup (1):()
