// The three optional header fields.
//
// The window descriptor is read and discarded: it bounds how far back a match may
// reach, which an encoder needs to decide how much history to keep. This decoder
// keeps the entire output and is bounded by the caller's buffer instead, so the
// number tells it nothing it does not already enforce.

zst_win(int ss) {
  if (ss = 0) {
    zst_le(1);
  }
} return void;
given zst_src_setup (0):() then calls zst_le:[1]
given zst_src_setup (1):() then calls zst_le:[0]

zst_did(int f) {
  if (f > 0) {
    int zst_dsz_v = zst_dsz(f);
    zst_le(zst_dsz_v);
  }
} return void;
given zst_src_setup (1):() then calls zst_le:[1]
given zst_src_setup (0):() then calls zst_le:[0]

// Flag 1, 2, 3 -> 1, 2, 4 bytes. Flag 0 means absent.
zst_dsz(int f) {
  int n = 1;
  if (f = 3) { n = 4; }
  else if (f = 2) { n = 2; }
} return int n;
(1):(1)
(3):(4)
