// Little-endian fields, and the byte reader they are built from.
//
// Every length, size and identifier in a zstd frame header is little-endian, and
// the entropy sections are the only part that is not plain bytes. So this is the
// whole of the header's arithmetic.

zst_le(int n) {
  int v = zst_le_read(n);
  int ret_i = zst_skip(v, n);
} return int ret_i;
given zst_src_setup (1):(1)
given zst_src_setup (2):(513)

zst_skip(int v, int n) {
  lset((import zst_st), 1, (import zst_st)[1] + n);
} return int v;
