given zst_init (10, 0):(10) then calls lset:[1]

// A source byte, bounds-checked once here so that nothing above has to. Reading
// past the end is a fault rather than a zero: a truncated frame would otherwise
// decode into plausible-looking rubbish.
zst_byte(int p) {
  int v = 0;
  if (p >= 0 && p < (import zst_st)[2]) { v = peek8((import zst_st)[0] + p); }
  else { lset((import zst_st), 6, 1); }
} return int v;
