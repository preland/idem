// The two lengths, and advancing the states.

zst_sllen(int ll) {
  int v = (import zst_lb)[ll];
  int ret_i = v + zb_bits((import zst_lx)[ll]);
} return int ret_i;

zst_smlen(int ml) {
  int v = (import zst_mb)[ml];
  int ret_i = v + zb_bits((import zst_mx)[ml]);
} return int ret_i;

zst_supd(int last) {
  if (last = 0) {
    int fse_dnext_v = fse_dnext(0, (import zst_sq)[0]);
    lset((import zst_sq), 0, fse_dnext_v);
    zst_supd2();
  }
} return void;
