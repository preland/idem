// Helper for zst_sinit setup.

zst_sinit_st() {
  int fse_dstart_v = fse_dstart(0);
  lset((import zst_sq), 0, fse_dstart_v);
  zst_sinit_s1();
} return void;

zst_sinit_s1() {
  int fse_dstart_v2 = fse_dstart(1);
  lset((import zst_sq), 1, fse_dstart_v2);
  zst_sinit_s2();
} return void;

zst_sinit_s2() {
  int fse_dstart_v3 = fse_dstart(2);
  lset((import zst_sq), 2, fse_dstart_v3);
} return void;
