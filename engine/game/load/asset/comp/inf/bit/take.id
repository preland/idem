// Taking n bits off the bottom of the buffer, and the power of two a shift needs.
//
// The buffer holds at most 8 + 15 bits at once, so it stays inside an int with
// room to spare -- the reason the loop above adds one byte at a time rather than
// filling to 32.

inf_take(int n) {
  int v = (import inf_st)[2] % inf_pow2(n);
  int inf_st_v = (import inf_st)[2];
  int inf_pow2_v = inf_pow2(n);
  lset((import inf_st), 2, inf_st_v / inf_pow2_v);
  lset((import inf_st), 3, (import inf_st)[3] - n);
} return int v;

inf_pow2(int n) {
  int m = 1;
  while (n > 0) {
    m = m * 2;
    n = n - 1;
  }
} return int m;

// Discard whatever is left of the current byte -- what a stored block does before
// reading its length.
inf_align() {
  m4_pair((import inf_st), 2, 3, 0, 0);
} return void;
