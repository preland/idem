// Decoding one symbol.
//
//     code  = the bits read so far, most significant first
//     first = the smallest code of this length
//     index = where this length's symbols start in `sym`
//
// At each length, if `code - first` is inside that length's count, the symbol is
// `sym[index + code - first]`. Otherwise advance all three to the next length --
// codes lengthen by shifting left, and the next length's first code is the one
// after this length's last, shifted.
//
// Fifteen is DEFLATE's maximum code length; running past it means the stream does
// not decode, which is a fault rather than a wrong symbol.

inf_decode(int[] cnt, int[] sym) {
  int[] st = [0, 0, 0, 1];
  inf_dwalk(cnt, st);
} return int inf_dsym(sym, st);

inf_dwalk(int[] cnt, int[] st) {
  while (st[3] <= 15 && inf_dstep(cnt, st) = 0) {
    lset(st, 3, st[3] + 1);
  }
} return void;

// st: 0 code, 1 first, 2 index, 3 len. Answers 1 when the symbol is in range at
// this length, and leaves `code - first` in slot 0 for inf_dsym.
inf_dstep(int[] cnt, int[] st) {
  int ok = 0;
  lset(st, 0, st[0] * 2 + inf_bits(1));
  ok = st[0] - st[1] < cnt[st[3]];
} return int inf_dnext(cnt, st, ok);
