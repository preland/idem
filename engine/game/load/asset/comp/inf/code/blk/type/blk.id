// The three block types.
//
//     0  stored -- byte-aligned, a length and its complement, then raw bytes
//     1  fixed  -- the tables RFC 1951 defines; no header at all
//     2  dynamic -- the tables are sent, themselves Huffman-coded
//
// Anything else is a corrupt stream.

inf_block(int t) {
  if (t = 0) {
    inf_stored();
  } else {
    inf_block2(t);
  }
} return void;

inf_block2(int t) {
  if (t = 1) {
    inf_fixed();
  } else if (t = 2) {
    inf_dyn();
  } else {
    lset((import inf_st), 7, 1);
  }
} return void;

// A stored block starts on a byte boundary and carries its length twice, the
// second time inverted -- the one integrity check DEFLATE has, and worth making,
// because a mismatch here means the bit reader has lost sync and everything after
// it is noise.
inf_stored() {
  inf_align();
  inf_read_words();
} return void;
