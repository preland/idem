// Reading a component's arguments.
//
// `nd` is a `comp` whose `a` is an `args` node; the i'th argument is its i'th
// child. Absent answers 0, so every reader below has a sensible default without
// testing for one.

scn_arg(int nd, int i) {
  int v = 0;
  int ia_val = ast_ia(nd);
  if (ia_val != 0) {
    int[] ks_val = ast_ks(ia_val);
    if (i < len(ks_val)) {
      v = ks_val[i];
    }
  }
} return int v;

scn_num(int nd, int i) {
  int scn_arg_v = scn_arg(nd, i);
  int ret_i = ast_ia(scn_arg_v);
} return int ret_i;

scn_txt(int nd, int i) {
  int scn_arg_v = scn_arg(nd, i);
  string ret_s = ast_tx(scn_arg_v);
} return string ret_s;
