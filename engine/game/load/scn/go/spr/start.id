// The first scene declared. `start NAME` should select it; until the name lookup
// exists, first-declared is the honest approximation and is what a one-scene game
// means anyway.
scn_pick(int doc, int i) {
  int[] ks = ast_ks(doc);
  while (i < len(ks) && (import scn_st)[5] = 0) {
    scn_take(ks[i]);
    i = i + 1;
  }
} return void;
