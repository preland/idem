// Walking the document's top-level declarations.

scn_walk(int doc, int i) {
  int[] ks = ast_ks(doc);
  while (i < len(ks)) {
    scn_one(ks[i]);
    i = i + 1;
  }
} return void;

scn_one(int nd) {
  if (ast_kd(nd) = ast_k_game()) {
    scn_game(nd, 0);
  } else {
    scn_one2(nd);
  }
} return void;

// The manifest's components, each a `comp` node whose args are literals.
scn_game(int nd, int i) {
  int[] ks = ast_ks(nd);
  while (i < len(ks)) {
    scn_prop(ks[i]);
    i = i + 1;
  }
} return void;
