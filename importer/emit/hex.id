// A colour, spelled the way idml spells one: six uppercase hex digits.
//
// Six concatenations of one character each, per colour. That is the shape the
// engine forbids in a *loop over pixels* and is entirely fine here -- a palette
// has at most 62 colours and a model at most a few thousand faces, and the cost
// of a fixed six-character build is not the quadratic one. Where it would have
// mattered (the sprite rows) the flat store is used instead.

imp_hex6(int c) {
  string s = "";
  int i = 5;
  while (i >= 0) {
    s = s + chr(imp_hexd(c / imp_pow16(i) % 16));
    i = i - 1;
  }
} return string s;

// 48 is '0', 65 is 'A'. Upper case because that is how every colour in
// IDML_GAME.md and in the hand-written games is written.
imp_hexd(int n) {
  int c = 48 + n;
  if (n > 9) {
    c = 55 + n;
  }
} return int c;

imp_pow16(int n) {
  int m = 1;
  while (n > 0) {
    m = m * 16;
    n = n - 1;
  }
} return int m;
