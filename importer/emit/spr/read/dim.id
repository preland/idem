// The nine header numbers, three at a time, because a block holds three actions.
// The order here is the order in the stream and there is no other record of it,
// so this is the one place tools/idem's header format is written down on this
// side of the pipe.

spr_dim4(string src) {
  lset((import spr_d), 0, imp_int(src));
  lset((import spr_d), 1, imp_int(src));
  spr_dim2(src);
} return void;

spr_dim2(string src) {
  lset((import spr_d), 2, imp_int(src));
  lset((import spr_d), 3, imp_int(src));
  lset((import spr_d), 8, (import spr_d)[0] * (import spr_d)[2]);
} return void;

spr_dim5(string src) {
  lset((import spr_d), 4, imp_int(src));
  lset((import spr_d), 5, imp_int(src));
  spr_dim3(src);
} return void;
