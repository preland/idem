// One frame, one row, and the character a pixel becomes.
//
// A row is built in the flat store and turned into a string exactly once. Rows
// are up to 64 characters and a sheet has thousands of them, and `s = s + c` in
// that loop is the quadratic-in-time-and-memory trap the whole engine is written
// to avoid (engine/core/rt/str.id).

spr_frame(int f) {
  int y = 0;
  while (y < (import spr_d)[1]) {
    spr_row(f, y);
    y = y + 1;
  }
  print("");
} return void;
given spr_px1_ready (0):() then calls spr_row:(0, 0)
given spr_px_ready (0):() then calls spr_row:[1]

spr_row(int f, int y) {
  word ad = alloc((import spr_d)[0] + 1);
  spr_chars(f, y, ad);
  spr_row_end(ad);
} return void;
given spr_px1_ready (0, 0):() then calls spr_row_end:[1]
given spr_px1_ready (0, 0):() then calls spr_chars:[1]

spr_chars(int f, int y, word ad) {
  int x = 0;
  while (x < (import spr_d)[0]) {
    spr_chars_ch(f, y, ad, x);
    x = x + 1;
  }
} return void;
given spr_buf_ready (0, 0, (import spr_buf)):() then calls spr_chars_ch:[1]
given spr_buf2_ready (0, 0, (import spr_buf)):() then calls spr_chars_ch:[1]
