// emit -- the idml itself.
//
// What comes out is what a person would have typed: a `palette` block naming one
// character per colour, then a `sprite` block of quoted rows. Nothing here is a
// serialisation format -- it is source, and the test of it is that a human can
// open it, change a pixel, and pack the game.

spr_emit() {
  spr_pal_open();
  spr_pal_body();
  spr_spr();
} return void;
given spr_px1_ready ():() then calls spr_pal_open:[1]
given spr_px1_ready ():() then calls spr_spr:[1]

spr_pal_open() {
  print("# Generated by `idem import`. Editing this by hand is expected -- it is");
  print("# ordinary idml, and re-importing overwrites it.");
  print("palette " + (import spr_nm)[0] + "-pal {");
} return void;
given spr_hdr_ready ():() then prints:("# Generated by `idem import`. Editing this by hand is expected -- it is\n# ordinary idml, and re-importing overwrites it.\npalette s-pal {\n")
given spr_hdr2_ready ():() then prints:("# Generated by `idem import`. Editing this by hand is expected -- it is\n# ordinary idml, and re-importing overwrites it.\npalette t-pal {\n")

spr_pal_body() {
  print("  . clear");
  spr_pal_rows(1);
  print("}");
} return void;
given spr_lists_ready ():() then calls spr_pal_rows:(1)
given spr_pal_ready ():() then calls spr_pal_rows:(1)
