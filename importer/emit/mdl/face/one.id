// One face: three vertex indices and a packed colour.

mdl_face(string src) {
  int a = imp_int(src);
  int b = imp_int(src);
  mdl_f3(src, a, b);
} return void;

mdl_f3(string src, int a, int b) {
  int c = imp_int(src);
  int v = imp_int(src);
  mdl_f3_b(a, b, c, v);
} return void;

mdl_f3_b(int a, int b, int c, int v) {
  string h = imp_hex6(v);
  print("    (" + a + ", " + b + ", " + c + ", 0x" + h + ")");
} return void;
