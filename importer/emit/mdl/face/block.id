// The third coordinate, and the faces.
//
// Each field is read into its own local before the line is printed. Two
// side-effecting calls in one expression may evaluate in either order in this
// language, so a `print(imp_int(src) + " " + imp_int(src))` would transpose a
// mesh's coordinates on some builds and not others -- the worst kind of bug to
// go looking for.

mdl_v3(string src, int x, int y) {
  int imp_int_v = imp_int(src);
  print("    (" + x + ", " + y + ", " + imp_int_v + ")");
} return void;
given imp_init ("300", 1, 2):() then prints:("    (1, 2, 300)\n")
given imp_init ("5", 0, 0):() then prints:("    (0, 0, 5)\n")

mdl_faces(string src) {
  print("  faces {");
  mdl_face_all(src);
  print("  }");
} return void;
given mdl_hdr_ready ("0"):() then calls mdl_face_all:("0")
given mdl_hdr2_ready ("1 2 3 255"):() then calls mdl_face_all:("1 2 3 255")

mdl_face_all(string src) {
  int i = 0;
  while (i < (import mdl_n)[1]) {
    mdl_face(src);
    i = i + 1;
  }
  print("}");
} return void;
given mdl_hdr_ready ("x"):() then calls mdl_face:[0]
given mdl_hdr3_ready ("0 1 2 255 0 1 2 255"):() then calls mdl_face:[2]
