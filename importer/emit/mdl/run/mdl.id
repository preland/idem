// mdl -- a mesh, turned into a `model` block.
//
// The hard parts happened before this program ran: Blender evaluated the
// modifiers, applied the world transforms, triangulated, decimated to a budget
// and resolved each material to one flat colour, because all of that means
// knowing what a .blend is and `id` has no file I/O to find out with. What
// arrives here is integers in the engine's own units and axes, and what leaves is
// idml.
//
// The output is deliberately the same `model` block IDML_GAME.md §3 documents by
// hand, so an imported showroom and a hand-typed crate are the same kind of
// thing to every stage after this one.

mdl_go(string src) {
  export string[] mdl_nm = [imp_tok(src)];
  export int[] mdl_n = [imp_int(src), 0];
  mdl_go2(src);
} return void;
given imp_init ("cube 0 0"):() then calls mdl_go2:("cube 0 0")
given imp_init ("box 2 1"):() then calls mdl_go2:("box 2 1")

mdl_go2(string src) {
  int v = imp_int(src);
  lset((import mdl_n), 1, v);
  mdl_go3(src);
} return void;
given mdl_hdr_ready ("0"):() then calls mdl_go3:("0")
given mdl_hdr_ready ("3"):() then calls mdl_go3:("3")

mdl_head() {
  print("# Generated by `idem import`. Ordinary idml: edit it, or re-import.");
  print("model " + (import mdl_nm)[0] + " {");
  print("  verts {");
} return void;
given mdl_hdr_ready ():() then prints:("# Generated by `idem import`. Ordinary idml: edit it, or re-import.\nmodel cube {\n  verts {\n")
given mdl_hdr_ready ():() then eprints:("")
