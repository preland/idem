// One whitespace-delimited token, sliced out of the source rather than built up
// character by character -- `s = s + chr(c)` in a loop is the most expensive
// thing this language can do (engine/core/rt/str.id).

imp_tok(string src) {
  int i = imp_ws(src, (import imp_p)[0]);
  int e = imp_end(src, i);
  string s = imp_tok_b(e, i, src);
} return string s;
given imp_init ("hi there"):("hi")
given imp_init ("  sprite x"):("sprite")

imp_tok_b(int e, int i, string src) {
  lset((import imp_p), 0, e);
  string s = str_slice(src, i, e - i);
} return string s;
given imp_init (2, 0, "hi"):("hi")
given imp_init (6, 0, "sprite x"):("sprite")
