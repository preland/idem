// mkfont reads the font through idc/tools/lib/file, the one whole-file read
// the id repositories carry, and spells a file's magic through
// idc/tools/lib/hex. Both are imported by path, the way engine/conf.id reaches
// idc's backends. The header itself is idstd's pcsf_head.
import "../../../idc/tools/lib/file"
import "../../../idc/tools/lib/hex"

// The code points the compiled-in table covers: printable ASCII and no more. A
// byte over 126 is a UTF-8 continuation and this engine has no notion of one,
// and 95 glyphs of 16 rows is already 1520 literals. A game that wants the
// other glyphs of a code page loads the .psf at runtime.
int mkf_first = 32;
int mkf_last = 126;

// The face the engine ships, relative to the repository root.
string mkf_src = "test_assets/vga8x16.psf";

// The fixed text of glyphs.gen.id, in the pieces the font's own numbers go
// between: mkf_head1 and mkf_head2 around the font's path, mkf_left before the
// first code point, mkf_head3 before txt_st's values, and mkf_tail after the
// last glyph.
string mkf_head1 = "// glyphs.gen.id -- GENERATED by tools/mkfont.sh from ";
string mkf_head2 = ".\n// Do not edit by hand; re-run the generator against another font instead.\n//\n// The engine's default face: the IBM VGA ";
string mkf_left = "// leftmost column, bit 1 = rightmost; txt_px_sc walks those bits against\n// txt_bit(). A glyph's first row is at (key - ";
string mkf_head3 = "// txt_glyph_at computes.\n//\n// txt_st is emitted beside the table because the two must agree: it is\n// [cell width, cell height, bits per row, glyph count], and it is what\n// psf_load overwrites when a game loads a face of its own. Both are one\n// statement each, so a table of any size is legal inside the 3-action rule.\n\ntxt_glyph_data() {\n  export int[] txt_st = [";
string mkf_tail = "  ];\n} return void;\n";
