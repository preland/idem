// The game seam, as no-ops.
//
// `engine/` calls six functions a game defines -- g_init, g_stage, g_step,
// g_draw, g_ref, g_act (docs/IDML.md 2) -- exactly as it calls the four a
// graphics backend defines. A program that links the engine *without* being a
// game therefore has to supply them, the same way it supplies a backend: the
// unit tests, which exercise one module and never run a frame, and the editor,
// which hosts other people's games rather than being one.
//
// Import this beside `engine/`. A real game must not: its own definitions would
// collide with these, which is the compiler telling the truth about there being
// two games in one program.
//
// Every one of these has to differ from every other, because two functions with
// the same signature and the same body are one function and the compiler says
// so. There is no way to write six distinct no-ops, so each does the smallest
// real thing instead: touches a counter nobody reads. That is the language's
// duplicate-logic rule working exactly as intended, on the one kind of code it
// is inconvenient for.

g_stub_init() {
  export int[] g_stub = [0, 0, 0, 0];
} return void;

g_init() {
  lset((import g_stub), 0, (import g_stub)[0] + 1);
} return void;

g_draw() {
  lset((import g_stub), 1, (import g_stub)[1] + 1);
} return void;
