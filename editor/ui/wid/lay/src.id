// The document.
//
// Names are semantic -- `Hierarchy`, `SceneView`, `Inspector` -- rather than
// `Col` or `Row`, because a name is how the code above asks for a rect. An
// unknown name is a transparent container that hands its whole rect to its
// children, which is exactly what a named region wants to be.

ed_src() {
} return string "Col()[100, 100, top-left] {" + ed_src2() + ed_src3() + "}";

ed_src2() {
} return string "MenuBar()[5.25, 100, top-left] { Fill(0x323232)[100, 100, top-left]{} } Col()[89.5, 100, top-left] { ToolBar()[5.72, 100, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } Col()[94.28, 100, top-left] { Row()[87.43, 100, top-left] { Hierarchy()[100, 20, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } SceneView()[100, 56.25, top-left] { Fill(0x393939)[100, 100, top-left]{} } Inspector()[100, 23.75, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } } Project()[12.57, 100, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } } }";

ed_src3() {
} return string "StatusBar()[5.25, 100, top-left] { Fill(0x323232)[100, 100, top-left]{} }";
