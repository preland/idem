// The editor's layout, written in idml.
//
// This is the whole point of the exercise: the editor's chrome is a layout
// document, in the language the engine already speaks, and the code below reads
// where things ended up rather than deciding it. Move a pane here and the rows,
// buttons and the 3D viewport follow, with nothing else changed.
//
// idml has no notion of a pixel in a dimension: every number is a percentage of
// the parent, in centipercent. So the editor is resolution independent for free --
// at 640x400 the hierarchy is 128 pixels wide because 20% of 640 is 128, and at
// any other size it is still a fifth of the window.
//
// The percentages are the pixel design divided through: a 13px menu bar of 400 is
// 3.25, a 17px toolbar of the 375 left under it is 4.53, and so on. Each level
// sums to exactly 100 -- idml's exact-fill invariant, and the reason there is no
// implicit empty space anywhere in the document.
//
// `id` has no file I/O, so the document is a literal. That is not a workaround:
// it is the same thing the packer does to a game's sources, and it is why a
// packed editor needs nothing beside it.

ed_lay_init() {
  export int[] ed_ui = [0];
  ui_vinit();
  ed_parse();
} return void;

// lex_init before lex_run, because the token store is an exported list and an
// export is NULL until its declaring function has run. The game's own sources are
// lexed afterwards, over the top of these tokens -- which is safe precisely
// because the document has already become arena nodes by then.
ed_parse() {
  lex_init();
  ed_parse2();
} return void;

// Recomputed every frame from the surface, because the window manager owns the
// window: the rects follow a resize with no layout code involved at all.
ed_lay() {
  ui_rclear();
  int txt_ui_v = txt_ui();
  lset((import ui_ts), 0, txt_ui_v * 1000);
  ui_draw((import ed_ui)[0], 0, 0, (import sf_gw), (import sf_gh));
} return void;
