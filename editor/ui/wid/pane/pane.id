// The three things every pane is made of: a filled rect, a titled header, and a
// hit test.
//
// Immediate mode, in the sense that matters here: there is no widget tree and no
// retained state. Each frame every pane is drawn from the model and every widget
// answers whether the pointer is in it *now*. A list row does not remember that
// it is selected -- ed_st does, and the row asks. That is the shape that suits a
// language with no structs, no closures and no function pointers, and it is also
// the shape that cannot go stale.

// The pane's fill is the idml document's business (ui/wid/lay/src.id); what is
// left is the header strip and the border, which are chrome around a rect rather
// than the rect itself.
ed_pane(int x, int y, int w, int h, string title) {
  int ed_col_v = ed_col(3);
  d2_frame(x, y, w, h, ed_col_v);
  ed_bar(x, y, w, title);
} return void;

// The header strip, and the title in it. Drawn even when the title is empty,
// because the strip is what separates one pane from the next when they abut.
//
// Every measurement here is in *design pixels multiplied by txt_ui()*. The text
// scales with the window (engine/gfx/d2/text/font/cell/ui.id), so anything that
// has to sit beside it or contain it must scale by exactly the same step, or the
// chrome and the type drift apart the first time the window is resized.
ed_bar(int x, int y, int w, string title) {
  int ed_hdr_v = ed_hdr();
  int ed_col_v = ed_col(2);
  sf_rect(x + 1, y + 1, w - 2, ed_hdr_v - 2, ed_col_v);
  int ed_hdr_v2 = ed_hdr();
  int ed_col_v2 = ed_col(3);
  d2_hline(x + 1, y + ed_hdr_v2 - 1, w - 2, ed_col_v2);
  int txt_ui_v = txt_ui();
  int txt_ui_v2 = txt_ui();
  int ed_col_v3 = ed_col(4);
  txt_draw(title, x + 5 * txt_ui_v, y + 2 * txt_ui_v2, ed_col_v3);
} return void;

// Is the pointer inside this rect? Every button, row and drag target is this
// question and the pointer's state, which inp_ sampled once at the top of the
// frame -- so nothing in a frame can see the mouse in two places.
ed_in(int x, int y, int w, int h) {
  int ok = 0;
  if (inp_mx() >= x && inp_mx() < x + w && inp_my() >= y && inp_my() < y + h) { ok = 1; }
} return int ok;
