ed_btn_text(int x, int y, int w, int h, string s) {
  int tw = txt_width(s);
  int th = txt_cellh();
  ed_btn_text_draw(x, y, w, h, s, tw, th);
} return void;
given ed_t_boot stdin "" (1, 2, 3, 4, "ok"):() then calls ed_btn_text_draw:(1, 2, 3, 4, "ok", 16, 16)
given ed_t_boot stdin "" (5, 6, 7, 8, "abcd"):() then calls ed_btn_text_draw:(5, 6, 7, 8, "abcd", 32, 16)

ed_btn_text_draw(int x, int y, int w, int h, string s, int tw, int th) {
  int tu = txt_ui();
  int col = ed_col(4);
  txt_draw(s, x + (w - tw) / 2, y + (h - th * tu) / 2, col);
} return void;
given ed_t_boot stdin "" (0, 0, 20, 20, "ok", 16, 16):() then calls txt_draw:("ok", 2, 2, 0xCFCFCF)
given ed_t_boot stdin "" (10, 5, 40, 30, "hi", 10, 8):() then calls txt_draw:("hi", 25, 16, 0xCFCFCF)
