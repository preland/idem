// The rest of the init chain, and the frame loop.

ed_boot3() {
  d2_spr_init();
  d3_init();
  ed_boot4();
} return void;
given fx_trig_init given ed_t_boot2 stdin "" ():() then calls d2_spr_init:[1] then calls d3_init:[1]
given fx_trig_init given ed_t_boot2 stdin "" ():() then calls d3_init:[1] then calls ed_boot4:[1]

ed_boot4() {
  inp_init();
  err_init();
  ed_boot5();
} return void;
given fx_trig_init given ed_t_boot2 stdin "" ():() then calls inp_init:[1] then calls err_init:[1]
given fx_trig_init given ed_t_boot2 stdin "" ():() then calls err_init:[1] then calls ed_boot5:[1]

ed_run(int argc, string[] argv) {
  if (argc > 1) {
    int shot_n_v = shot_n(argc, argv);
    int fx_max_v = fx_max(shot_n_v, 1);
    ed_shot(fx_max_v);
  } else {
    ed_loop(1);
  }
  gfx_close();
} return void;
given ed_t_boot stdin "" (2, ["idem", "3"]):() then calls ed_shot:(3)
given ed_t_boot given sys_quit stdin "" (1, ["idem"]):() then calls ed_loop:(1)
