// Adding five colours at a time, and reading one back.
//
// Five per call because a block holds three actions but a call takes as many
// arguments as it likes -- the asymmetry most of this engine's shapes come from.

ed_col_add(int a, int b, int c, int d, int e) {
  push((import ed_pal), a);
  push((import ed_pal), b);
  ed_col3(c, d, e);
} return void;
given ed_t_boot stdin "" (1, 2, 3, 4, 5):() then calls ed_col3:(3, 4, 5) then ed_pal_len:(19)
given ed_t_boot stdin "" (100, 200, 7, 8, 9):() then calls ed_col3:(7, 8, 9) then ed_pal_last:(9)

ed_col3(int c, int d, int e) {
  push((import ed_pal), c);
  push((import ed_pal), d);
  push((import ed_pal), e);
} return void;
