given ed_t_boot stdin "" (44, 55, 66):() then ed_pal_len:(17) then ed_pal_last:(66)

// Clamped rather than trusted: a colour index is written by hand at every call
// site, and an out-of-range list read aborts the process.
ed_col(int i) {
  int len_v = len((import ed_pal));
  int ret_i = (import ed_pal)[fx_clamp(i, 0, len_v - 1)];
} return int ret_i;
