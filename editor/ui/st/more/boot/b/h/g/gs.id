// 0 width, 1 height, 2 scale, 3 fps -- from the document the editor has open.

ed_gstage(int k) {
  int v = (import scn_st)[2];
  if (k = 0) { v = (import scn_st)[0]; }
  else { v = ed_gstage2(k); }
} return int v;

ed_gstage2(int k) {
  int v = (import scn_st)[2];
  if (k = 1) { v = (import scn_st)[1]; }
  else if (k = 2) { v = (import scn_st)[3]; }
} return int v;
