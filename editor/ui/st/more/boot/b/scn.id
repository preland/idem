// The scene tables, and the diagnostics the editor does not print.
//
// err_mute is unconditional here and that is the point: a diagnostic printed by
// an editor goes to a stream nobody is reading, and in `--shot` mode it goes into
// the middle of a PPM. The count is what the status bar shows, which is the form
// a diagnostic is useful in when the program's whole output is pixels.

ed_boot9() {
  scn_init();
  scn_dir_init();
  ed_boot10();
} return void;

ed_boot10() {
  err_mute(1);
  ed_io_init();
  ed_boot11();
} return void;

// eng_seam last, and unconditional, so it has run before ed_run (main.id) can
// call the first frame -- the editor's own g_ref (host.id) is what ui_val calls
// while previewing a game, and nothing reachable from here runs before this.
ed_boot11() {
  ed_init(read_all());
  eng_seam(g_init, g_stage, g_step, g_draw, g_ref, g_act);
} return void;
