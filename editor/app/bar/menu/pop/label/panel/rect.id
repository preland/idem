ed_pop_at3(int k, int mx, int ui, int hdr, int w) {
  int mn = ed_mn(k);
  int rowh = ed_rowh();
  ed_pop_at4(k, mx, ui, hdr, w, mn, rowh);
} return void;
given ed_t_boot stdin "" (0, 100, 2, 21, 80):() then calls ed_pop_at4:(0, 100, 2, 21, 80, 5, 18)
