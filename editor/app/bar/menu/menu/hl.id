ed_menu_hl(int x, string s, int ok) {
  if (ok >= 1) {
    ed_menu_hl_draw(x, s);
  }
} return void;

ed_menu_hl_draw(int x, string s) {
  int txt_ui_v = txt_ui();
  int txt_width_v = txt_width(s);
  ed_menu_hl_draw2(x, s, txt_ui_v, txt_width_v);
} return void;

ed_menu_hl_draw2(int x, string s, int txt_ui_v, int txt_width_v) {
  int ed_hdr_v = ed_hdr();
  int ed_col_v = ed_col(7);
  sf_rect(x - 4 * txt_ui_v, 0, txt_width_v + 8 * txt_ui_v, ed_hdr_v - 1, ed_col_v);
} return void;
