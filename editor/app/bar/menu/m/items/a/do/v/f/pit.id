// The pitch of each standard view.
//
// Top is 88 degrees rather than 90: at exactly straight down the orbit's
// horizontal component vanishes and yaw stops meaning anything, which is the same
// clamp the drag has.

ed_vpit(int i) {
  int v = 0 - 9000;
  if (i = 1) { v = 0 - 88000; }
  else if (i = 2) { v = 0; }
} return int v;
