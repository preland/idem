// What each menu item does.
//
// Seven items are not built -- New, Open, Save, Undo, Redo, Import, Reload -- and
// ed_mon dims them, so nothing here has to test for them: a dim item never
// reaches this. Everything else on the bar works.

ed_mdo(int k, int i) {
  if (k = 0) {
    ed_mfile_do(i);
  } else {
    ed_mdo2(k, i);
  }
} return void;
given ed_t_boot stdin "" (0, 5):() then calls ed_mfile_do:(5)
given ed_t_boot stdin "" (1, 5):() then calls ed_mdo2:(1, 5)

ed_mdo2(int k, int i) {
  if (k = 1) {
    ed_sel_all(0, i = 2);
  } else {
    ed_mdo3(k, i);
  }
} return void;
given ed_t_boot stdin "" (1, 2):() then calls ed_sel_all:(0, 1)
given ed_t_boot stdin "" (2, 5):() then calls ed_mdo3:(2, 5)

ed_mdo3(int k, int i) {
  if (k = 2) {
    ed_fit_mesh(1);
  } else if (k = 3) {
    ed_mview_do(i);
  } else {
    lset((import ed_st), 17, i + 1);
  }
} return void;
given ed_t_boot stdin "" (2, 5):() then calls ed_fit_mesh:(1)
given ed_t_boot stdin "" (3, 5):() then calls ed_mview_do:(5)
given ed_t_boot stdin "" (9, 5):() then calls lset:((import ed_st), 17, 6)
