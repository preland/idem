ed_mitem(int k, int i) {
  string s = ed_mitem2(k, i);
  if (k = 0) { s = ed_mfile(i); }
} return string s;

ed_mitem2(int k, int i) {
  string s = ed_mitem3(k, i);
  if (k = 1) { s = ed_medit(i); }
} return string s;

// The last of the dispatch, and the File menu.

ed_mitem3(int k, int i) {
  string s = ed_mhelp(i);
  if (k = 2) { s = ed_masset(i); }
  else if (k = 3) { s = ed_mview(i); }
} return string s;
