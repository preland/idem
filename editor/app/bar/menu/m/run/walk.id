// Walking the five menus, where each title sits, and the toggle.

ed_menu_run(int k) {
  while (k < 5) {
    ed_menu_run_one(k);
    k = k + 1;
  }
} return void;
given ed_t_boot stdin "" (0):() then calls ed_menu_run_one:[5]
given ed_t_boot stdin "" (3):() then calls ed_menu_run_one:[2]

ed_menu_run_one(int k) {
  int ed_mx_v = ed_mx(k);
  string ed_mname_v = ed_mname(k);
  ed_menu_one(ed_mx_v, k, ed_mname_v);
} return void;
given ed_t_boot stdin "" (0):() then calls ed_menu_one:(6, 0, "File")
given ed_t_boot stdin "" (1):() then calls ed_menu_one:(48, 1, "Edit")
