// Cumulative, so a longer label pushes the rest along instead of overlapping
// them -- and so the bar reflows when the text scale changes with the window.
ed_mx(int k) {
  int x = 6 * txt_ui();
  int i = 0;
  x = ed_mxr(x, i, k);
} return int x;

ed_mxr(int x, int i, int k) {
  while (i < k) {
    string ed_mname_v = ed_mname(i);
    x = x + txt_width(ed_mname_v) + 10 * txt_ui();
    i = i + 1;
  }
} return int x;
