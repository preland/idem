// The menu titles, and opening one.
//
// A menu is a popup: it is drawn after everything else so it covers the panes,
// and which one is open lives in ed_st slot 15 rather than in the title -- the
// title is redrawn from nothing every frame, and a popup has to outlive the
// thing that opened it.
//
// Clicking an open title closes it, clicking a closed one opens it, and
// *hovering* a different title while one is open switches to that one. The last
// is what makes a menu bar feel like a menu bar rather than five buttons: once
// you are in the bar, you are browsing it.

ed_menu_one(int x, int k, string s) {
  int txt_ui_v = txt_ui();
  int txt_width_v = txt_width(s);
  int txt_ui_v2 = txt_ui();
  int ed_hdr_v = ed_hdr();
  int ed_in_v = ed_in(x - 4 * txt_ui_v, 0, txt_width_v + 8 * txt_ui_v2, ed_hdr_v - 1);
  ed_menu_hl(x, s, ed_in_v + ((import ed_st)[15] = k));
  ed_menu_ttl(x, k, s);
} return void;

ed_menu_hl(int x, string s, int ok) {
  if (ok >= 1) {
    int txt_ui_v = txt_ui();
    int txt_width_v = txt_width(s);
    int txt_ui_v2 = txt_ui();
    int ed_hdr_v = ed_hdr();
    int ed_col_v = ed_col(7);
    sf_rect(x - 4 * txt_ui_v, 0, txt_width_v + 8 * txt_ui_v2, ed_hdr_v - 1, ed_col_v);
  }
} return void;

ed_menu_ttl(int x, int k, string s) {
  ed_menu_click(x, k, s);
  int txt_ui_v = txt_ui();
  int ed_col_v = ed_col(4);
  txt_draw(s, x, 2 * txt_ui_v, ed_col_v);
} return void;
