// The menu bar, the toolbar and the status bar.
//
// The open menu's panel is drawn last of everything in the editor, because it is
// a popup and popups cover things. That is the whole popup layer: one rectangle
// deep, dismissed by any click that is not on an item.

ed_bars() {
  ed_menu();
  ed_tools();
  ed_bars2();
} return void;

ed_bars2() {
  ed_status();
  ed_menu_pop();
} return void;

ed_menu() {
  int ed_rq_v = ed_rq(0, 0);
  int ed_rq_v2 = ed_rq(0, 1);
  int ed_rq_v3 = ed_rq(0, 3);
  int ed_rq_v4 = ed_rq(0, 2);
  int ed_col_v = ed_col(3);
  d2_hline(ed_rq_v, ed_rq_v2 + ed_rq_v3 - 1, ed_rq_v4, ed_col_v);
  ed_menu_items();
} return void;
