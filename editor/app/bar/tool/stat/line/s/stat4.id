// The stage and the frame counter.

ed_status_wh(int x, int y) {
  int sys_sw_v = sys_sw();
  x = ed_snum(x, y, "stage", sys_sw_v);
  int sys_sh_v = sys_sh();
  x = ed_snum(x, y, "x", sys_sh_v);
  ed_status_f(x, y);
} return void;

// `ents` and `errs` are here because they are the two numbers that turn "it is
// behaving oddly" into a fact. An entity count that is twice what the document
// declares is the double-spawn bug this pane would have caught in a second; a
// non-zero error count says the document did not fully parse, which is otherwise
// invisible in a program whose only output is pixels.
ed_status_f(int x, int y) {
  x = ed_snum(x, y, "at", (import sys_vp)[0]);
  ed_status_e(x, y);
} return void;

ed_status_e(int x, int y) {
  int ent_n_v = ent_n();
  x = ed_snum(x, y, "ents", ent_n_v);
  int err_count_v = err_count();
  x = ed_snum(x, y, "errs", err_count_v);
  ed_snum(x, y, "frame", (import ed_st)[8]);
} return void;
