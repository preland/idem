// One field of the status line, and the guard that drops it off the edge.

ed_slab(int x, int y, string s) {
  int ed_col_v = ed_col(5);
  ed_sdraw(x, y, s, ed_col_v);
  int ret_i = x + txt_width(s) + 8 * txt_ui();
} return int ret_i;

ed_sdraw(int x, int y, string s, int c) {
  if (x < (import sf_gw)) {
    txt_draw(s, x, y, c);
  }
} return void;
