// One tool button, the play controls, and the status bar.

ed_tool(int x, int k, string s) {
  int w = txt_width(s) + 10 * txt_ui();
  ed_tool_bg(x, w, k);
  ed_tool_hit(x, w, k, s);
} return void;
given ed_t_boot stdin "" (6, 0, "pan"):() then calls ed_tool_bg:(6, 34, 0)
given ed_t_boot stdin "" (44, 1, "move"):() then calls ed_tool_hit:(44, 42, 1, "move")

ed_tool_bg(int x, int w, int k) {
  if ((import ed_st)[9] = k) {
    int h = ed_hdr();
    int col = ed_col(6);
    sf_rect(x, h + 2, w, h, col);
  }
} return void;
