// The toolbar, and the status line.
//
// The four tools are the ones every scene editor has, and the selected one is
// held in ed_st slot 9 rather than in the button, because the button is redrawn
// from nothing every frame. Clicking one selects it; what a tool *does* is the
// gizmo work that comes with a scene model to manipulate.

ed_tools() {
  int r0 = ed_rq(1, 0);
  int y = ed_rq(1, 1) + ed_rq(1, 3) - 1;
  ed_tools_line(r0, y);
} return void;
given ed_t_boot given ed_t_lay stdin "" ():() then calls ed_tools_line:(0, 40)
given ed_t_boot given ed_t_lay stdin "" ():() then calls ed_rq:[4]

ed_tools_line(int r0, int y) {
  int r2 = ed_rq(1, 2);
  ed_tools_line2(r0, y, r2);
} return void;
given ed_t_boot given ed_t_lay stdin "" (0, 40):() then calls ed_tools_line2:(0, 40, 640)
given ed_t_boot given ed_t_lay stdin "" (5, 10):() then calls ed_tools_line2:(5, 10, 640)

ed_tools_line2(int r0, int y, int r2) {
  int col = ed_col(3);
  d2_hline(r0, y, r2, col);
  ed_tool_row();
} return void;
given ed_t_boot stdin "" (0, 40, 640):() then calls d2_hline:(0, 40, 640, 0x1C1C1C)
given ed_t_boot stdin "" (0, 40, 640):() then calls ed_tool_row:[1]
