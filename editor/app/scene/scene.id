// The scene view: a real 3D viewport, drawn by the engine's software rasteriser
// into the panel's rect and nothing else.
//
// This is what d3_viewport exists for. The projection centres on the panel, the
// span clip stops at its edges and the focal length follows its width, so the
// scene view is a camera into the world rather than a window-sized render with
// panes drawn over it. Nothing here touches a pixel outside its rect.
//
// The camera orbits the point the geometry was framed on: right-drag to turn,
// middle-drag to pan, wheel to zoom, left-drag to select. Those are the bindings
// every 3D tool has settled on, and the reason left is *not* the camera is that
// the button a person reaches for first should pick things.

ed_scene(int x, int y, int w, int h) {
  sf_rect(x, y, w, h, ed_col(8));
  d3_viewport(x, y, w, h);
  ed_scene2(x, y, w, h);
} return void;

ed_scene2(int x, int y, int w, int h) {
  d3_zclear();
  ed_cam();
  ed_scene3(x, y, w, h);
} return void;

// A 2D game shows its own view; a project with no `ui` block gets the 3D scene.
// The two are the same pipeline pointed at different geometry -- a 2D game is the
// camera looking straight at a plane that fills its vision -- so this is a choice
// about what to put in front of the camera, not about which renderer to run.
ed_scene3(int x, int y, int w, int h) {
  ed_content();
  ed_band_draw();
  d2_frame(x, y, w, h, ed_col(3));
} return void;
