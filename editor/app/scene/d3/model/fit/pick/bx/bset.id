// The upper bound, and turning the box into an orbit.

ed_bmax(int[] bb, int i) {
  int fx_max_v = fx_max(bb[3 + i % 3], (import bl_v)[i]);
  lset(bb, 3 + i % 3, fx_max_v);
} return void;
