// X coordinate calculation for camera eye position.

ed_cam_coord_x(int d, int deg, int pit) {
  int cos_p = fx_cos(pit);
  int m = fx_mul(d, cos_p, 1000);
  int v = ed_cam_x_with_m(m, deg);
} return int v;

ed_cam_x_with_m(int m, int deg) {
  int sin_d = fx_sin(deg);
  int cx = (import ed_st)[10];
  int v = cx + fx_mul(m, sin_d, 1000);
} return int v;
