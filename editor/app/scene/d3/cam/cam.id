// The orbit camera.
//
// The eye is placed by walking `dist` backwards along the direction the camera
// faces, which is the one line of trigonometry an orbit needs: d3_cam_aim already
// defines forward as (-sin(yaw)cos(pitch), sin(pitch), -cos(yaw)cos(pitch)), so
// eye = -dist * forward puts the origin exactly in the middle of the view at
// every angle, with no second convention to keep in step.

ed_cam() {
  d3_cam_aim((import ed_st)[2], (import ed_st)[3]);
  ed_cam_eye((import ed_st)[4], (import ed_st)[2], (import ed_st)[3]);
  d3_view_matrix();
} return void;

// eye = centre - dist * forward. The centre is where the geometry is; orbiting
// the origin shows the inside of a wall for any scene an artist did not happen to
// model around it.
ed_cam_eye(int d, int deg, int pit) {
  int fx_cos_v = fx_cos(pit);
  int m = fx_mul(d, fx_cos_v, 1000);
  int ed_st_v = (import ed_st)[10];
  int fx_sin_v = fx_sin(deg);
  int fx_mul_v = fx_mul(m, fx_sin_v, 1000);
  int ed_st_v2 = (import ed_st)[11];
  int fx_sin_v2 = fx_sin(pit);
  int fx_mul_v2 = fx_mul(d, fx_sin_v2, 1000);
  int ed_st_v3 = (import ed_st)[12];
  int fx_cos_v2 = fx_cos(deg);
  int fx_mul_v3 = fx_mul(m, fx_cos_v2, 1000);
  d3_cam_set(ed_st_v + fx_mul_v, ed_st_v2 - fx_mul_v2, ed_st_v3 + fx_mul_v3);
} return void;

// The ground plane, as lines of thin quads rather than as 2D lines, so that the
// depth buffer decides what is in front of what: a grid drawn with d2_line would
// sit on top of every model, and a grid a model stands *on* is the entire point
// of drawing one.
ed_grid() {
  ed_grid_run(0 - 5);
  ed_axis();
} return void;
