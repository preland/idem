// The three components of a pan, in the camera's basis.
//
// dy is negated relative to dx because screen y counts downward and the camera's
// up vector counts upward: dragging down has to move the centre up.

ed_pcx(int dx, int dy) {
  int fx_cos_v = fx_cos((import ed_st)[2]);
  int fx_mul_v = fx_mul(dx, fx_cos_v, 1000);
  int fx_sin_v = fx_sin((import ed_st)[2]);
  int ret_i = fx_mul_v - ed_pup(dy, fx_sin_v);
} return int ret_i;

ed_pcy(int dy) {
  int fx_cos_v = fx_cos((import ed_st)[3]);
  int ret_i = 0 - fx_mul(dy, fx_cos_v, 1000);
} return int ret_i;

ed_pcz(int dx, int dy) {
  int fx_sin_v = fx_sin((import ed_st)[2]);
  int fx_mul_v = fx_mul(dx, fx_sin_v, 1000);
  int fx_cos_v = fx_cos((import ed_st)[2]);
  int ret_i = 0 - fx_mul_v - ed_pup(dy, fx_cos_v);
} return int ret_i;
