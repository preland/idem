// The horizontal part of the camera's up vector, times a drag.
//
// `up` leans by the pitch: looking straight ahead it is (0, 1, 0) and nothing
// horizontal happens, and looking steeply down it acquires a component along the
// view direction, so dragging down slides the centre away from the camera rather
// than under the floor.

ed_pup(int dy, int sv) {
  int fx_sin_v = fx_sin((import ed_st)[3]);
  int fx_mul_v = fx_mul(dy, fx_sin_v, 1000);
  int ret_i = 0 - fx_mul(fx_mul_v, sv, 1000);
} return int ret_i;
