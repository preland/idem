// An entity's position in surface pixels, and a point-in-rect test.
//
// The stage is the plane rect the world is drawn into, and ed_pset put its scale
// and origin into sys_vp for the length of that draw -- so this recomputes them
// from the same panel rather than reading state that has since been handed back.

ed_epx(int e, int k) {
} return int ed_pl0() + ent_at(e, 0) * ed_psc() / 1000000;

ed_epy(int e) {
} return int ed_pt0() + ent_at(e, 1) * ed_psc() / 1000000;

ed_in2(int x, int y, int x0, int y0, int x1, int y1) {
} return int x >= x0 && x <= x1 && y >= y0 && y <= y1;
