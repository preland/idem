// An entity's position in surface pixels, and a point-in-rect test.
//
// The stage is the plane rect the world is drawn into, and ed_pset put its scale
// and origin into sys_vp for the length of that draw -- so this recomputes them
// from the same panel rather than reading state that has since been handed back.

ed_epx(int e, int k) {
  int ret_i = ed_pl0() + ent_at(e, 0) * ed_psc() / 1000000;
} return int ret_i;
given ed_t_boot given ed_t_lay given ed_t_ent stdin "" (0, 0):(225)
given ed_t_boot given ed_t_lay given ed_t_boot_proj given ed_t_ent stdin "" (0, 0):(139)

ed_epy(int e) {
  int ret_i = ed_pt0() + ent_at(e, 1) * ed_psc() / 1000000;
} return int ret_i;
given ed_t_boot given ed_t_lay given ed_t_ent stdin "" (0):(41)
given ed_t_boot given ed_t_lay given ed_t_boot_proj given ed_t_ent stdin "" (0):(86)

ed_in2(int x, int y, int x0, int y0, int x1, int y1) {
  int ret_i = x >= x0 && x <= x1 && y >= y0 && y <= y1;
} return int ret_i;
(5, 5, 0, 0, 10, 10):(1)
(15, 5, 0, 0, 10, 10):(0)
(10, 10, 0, 0, 10, 10):(1)
