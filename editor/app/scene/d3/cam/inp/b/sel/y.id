// The band's vertical bounds.

ed_by0() {
  int ed_st_v = (import ed_st)[14];
  int inp_my_v = inp_my();
  int ret_i = fx_min(ed_st_v, inp_my_v);
} return int ret_i;

ed_by1() {
  int ed_st_v = (import ed_st)[14];
  int inp_my_v = inp_my();
  int ret_i = fx_max(ed_st_v, inp_my_v);
} return int ret_i;

// Drawn while the drag is live: a filled wash so the covered area reads at a
// glance, and a frame so its edges are exact. Only for the selection drag -- an
// orbit and a pan have their own feedback in the scene moving.
ed_band_draw() {
  if ((import ed_st)[5] = 3) {
    int ed_bx0_v = ed_bx0();
    int ed_by0_v = ed_by0();
    int ed_bx1_v = ed_bx1();
    int ed_bx0_v2 = ed_bx0();
    int ed_by1_v = ed_by1();
    int ed_by0_v2 = ed_by0();
    int ed_col_v = ed_col(13);
    d2_frame(ed_bx0_v, ed_by0_v, ed_bx1_v - ed_bx0_v2 + 1, ed_by1_v - ed_by0_v2 + 1, ed_col_v);
  }
} return void;
