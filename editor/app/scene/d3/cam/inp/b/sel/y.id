// Drawn while the drag is live: a filled wash so the covered area reads at a
// glance, and a frame so its edges are exact. Only for the selection drag -- an
// orbit and a pan have their own feedback in the scene moving.
ed_band_draw() {
  if ((import ed_st)[5] = 3) {
    d2_frame(ed_bx0(), ed_by0(), ed_bx1() - ed_bx0() + 1, ed_by1() - ed_by0() + 1, ed_col(13));
  }
} return void;
