// Choosing the entities inside the band.
//
// Every entity is cleared first and then re-tested, so a band is a fresh
// selection rather than an addition -- which is what a drag with no modifier
// means everywhere else.

ed_pick(int e, int x, int y, int n) {
  while (e < ent_n()) {
    n = n + ed_pick1(e, x, y);
    e = e + 1;
  }
  lset((import ed_st), 0, 0 - 1);
} return void;

ed_pick1(int e, int x, int y) {
  ent_put(e, 23, 0);
  int ed_inband_v = ed_inband(e);
  ent_put(e, 23, ed_inband_v);
  int ret_i = ent_at(e, 23);
} return int ret_i;

// The entity's centre, in surface pixels, against the band. Its centre and not
// its rect: a sprite stretched twelve screens wide would otherwise be selected by
// a band anywhere on the row, and what a person means by dragging over a thing is
// the thing they can see the middle of.
ed_inband(int e) {
  int ed_epx_v = ed_epx(e, 0);
  int ed_epy_v = ed_epy(e);
  int ed_bx0_v = ed_bx0();
  int ed_by0_v = ed_by0();
  int ed_bx1_v = ed_bx1();
  int ed_by1_v = ed_by1();
  int ret_i = ed_in2(ed_epx_v, ed_epy_v, ed_bx0_v, ed_by0_v, ed_bx1_v, ed_by1_v);
} return int ret_i;
