// Choosing the entities inside the band.
//
// Every entity is cleared first and then re-tested, so a band is a fresh
// selection rather than an addition -- which is what a drag with no modifier
// means everywhere else.

ed_pick(int e, int x, int y, int n) {
  while (e < ent_n()) {
    n = n + ed_pick1(e, x, y);
    e = e + 1;
  }
  lset((import ed_st), 0, 0 - 1);
} return void;

ed_pick1(int e, int x, int y) {
  ent_put(e, 23, 0);
  int ret_i = ed_inband(e);
  ent_put(e, 23, ret_i);
} return int ret_i;
