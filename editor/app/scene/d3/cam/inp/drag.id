// Starting, continuing and ending a scene-view drag.
//
// Three buttons, three gestures, and they are the ones every 3D tool has settled
// on -- which is the whole argument for them:
//
//     left    a selection band
//     middle  pan, the view sliding under the pointer
//     right   orbit
//
// Left used to orbit, and it was wrong for the same reason it is wrong in Blender
// and in Unity: the button you reach for first should pick things, not move the
// camera. A drag that starts on empty space and a drag that starts on an object
// then mean the same thing, which is what makes selection safe to attempt.
//
// A drag continues until its button comes up, even if the pointer has left the
// panel -- that is what makes a fast spin work instead of stopping at the
// inspector's edge, and it is only expressible because the seam reports releases.

ed_drag_st() {
  ed_drag_on(1, 3);
  ed_drag_on(2, 2);
  ed_drag_on(4, 1);
} return void;

// The button that started the drag owns it until it is released: a second button
// pressed mid-drag changes nothing, which is what stops a stray middle-click from
// turning an orbit into a pan halfway through.
ed_drag_on(int b, int k) {
  if (inp_mhit(b) * ed_in(ed_rq(3, 0), ed_rq(3, 1), ed_rq(3, 2), ed_rq(3, 3)) = 1 && (import ed_st)[5] = 0) {
    ed_drag_beg(k);
  }
  ed_drag_end(b, k);
} return void;

ed_drag_end(int b, int k) {
  if (inp_mdown(b) = 0 && (import ed_st)[5] = k) {
    ed_drag_fin(k);
  }
} return void;
