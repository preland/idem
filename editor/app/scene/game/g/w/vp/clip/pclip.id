ed_pclip2(int x, int y, int w, int x0, int y0) {
  int x_max = fx_max(x, x0);
  int y_max = fx_max(y, y0);
  ed_pclip3(x_max, y_max, x, w, x0, y);
} return void;

ed_pclip3(int x_max, int y_max, int x, int w, int x0, int y) {
  int w_rq = ed_rq(3, 2);
  int x_min = fx_min(x + w - 1, x0 + w_rq - 1);
  ed_pclip4(x_max, y_max, x_min, y);
} return void;

ed_pclip4(int x_max, int y_max, int x_min, int y) {
  int y_max_b = ed_pclip_b(y);
  sf_clip(x_max, y_max, x_min, y_max_b);
} return void;
