ed_cross2(int x, int y, int u, int col) {
  d2_hline(x - 4 * u, y, 9 * u, col);
  d2_vline(x, y - 4 * u, 9 * u, col);
} return void;
given ed_t_boot stdin "" (10, 20, 1, 100):(10, 20, 1, 100) then calls d2_hline:(6, 20, 9, 100)
given ed_t_boot stdin "" (10, 20, 1, 100):(10, 20, 1, 100) then calls d2_vline:(10, 16, 9, 100)
