// The chrome's scale put back. ui_ts belongs to whoever is about to draw a UI,
// and the editor draws two of them a frame -- the game's, inside the plane, and
// its own layout, over the whole window.
ed_plane5(int x, int y, int w, int h) {
  int txt_ui_v = txt_ui();
  lset((import ui_ts), 0, txt_ui_v * 1000);
  int ed_col_v = ed_col(3);
  d2_frame(x - 1, y - 1, w + 2, h + 2, ed_col_v);
} return void;

// The game's entities, drawn into the plane.
//
// ent_blit places an entity through sys_vp -- the stage the runtime maps a game's
// declared units onto -- so the plane borrows the stage for the length of one
// call and hands it back. The alternative is a second blit path that takes a
// rect, and a second path is a second thing to keep correct: the whole reason
// this panel is trustworthy is that the pixels in it come from the engine.
//
// The stage is restored to the editor's own, which is the whole surface at the
// scale sys_sync computed -- origin (0, 0), because the editor's surface *is* its
// window and there is no letterbox around it.

// The world is clipped to the plane, and the panel clip is put back afterwards --
// sf_clip is one rectangle and not a stack, so a nested clip has to restore its
// parent rather than unclip.
ed_pworld(int x, int y, int w) {
  ed_pclip(x, y, w);
  int ed_gw_v = ed_gw();
  int fx_max_v = fx_max(ed_gw_v, 1);
  ed_pdraw(x, y, w * 1000 / fx_max_v, (import sys_vp)[0]);
  ed_clip_pane();
} return void;

ed_pdraw(int x, int y, int sc, int was) {
  ed_pset(x, y, sc);
  ent_draw(0);
  ed_pdone(was);
} return void;
