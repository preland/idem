ed_proj_tile_rect(int x, int y, int i, int ok) {
  int ui = txt_ui();
  int col = ed_col(7 - 6 * (ok = 0 && (import ed_st)[1] != i));
  ed_proj_tile_rect_do(x, y, ui, ui, col);
} return void;
given ed_t_boot stdin "" (0, 10, 0, 1):() then calls ed_proj_tile_rect_do:(0, 10, 1, 1, 0x4A4A4A)
given ed_t_boot stdin "" (0, 10, 5, 0):() then calls ed_proj_tile_rect_do:(0, 10, 1, 1, 0x3C3C3C)

ed_proj_tile_frame(int x, int y) {
  int ui = txt_ui();
  int col = ed_col(3);
  ed_proj_tile_frame_do(x, y, ui, ui, col);
} return void;
given ed_t_boot stdin "" (0, 10):() then calls ed_proj_tile_frame_do:(0, 10, 1, 1, 0x1C1C1C)
given ed_t_boot stdin "" (5, 20):() then calls ed_proj_tile_frame_do:(5, 20, 1, 1, 0x1C1C1C)

ed_proj_tile(int x, int y, int i, int ok) {
  ed_proj_tile_rect(x, y, i, ok);
  ed_proj_tile_frame(x, y);
  ed_proj_txt(x, y, i, ok);
} return void;
given ed_t_boot stdin "" (0, 10, 0, 1):() then calls ed_proj_tile_rect:(0, 10, 0, 1)
given ed_t_boot stdin "" (0, 10, 0, 1):() then calls ed_proj_txt:(0, 10, 0, 1)
