// Removes whatever ed_save_mkdir/ed_save's own cases left in the scratch
// directory ed_t_mkdir_setup made: the target file (if ed_save wrote one),
// the "sub" directory ed_save_mkdir's real `mkdir -p` created, and the
// fs_mktemp parent itself -- so a suite run leaves nothing behind.
ed_t_mkdir_check() {
  string file = (import ed_path)[0];
  int r0 = fs_remove(file);
  string sub = (import ed_t_mkdir_parent) + "/sub";
} chain () {
  int existed = fs_exists(sub);
  int r1 = fs_remove(sub);
  int r2 = fs_remove((import ed_t_mkdir_parent));
} return int existed;
