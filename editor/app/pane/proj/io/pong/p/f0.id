// The document, four lines at a time.

ed_pg0() {
  string ret_s = ed_pong_ln("# pong -- created by the idem editor's File > New.") + ed_pong_ln("#") + ed_pong_ln("# Two paddles, a ball, and no art: every visible thing is a `shape box`.") + ed_pong_ln("# w/s move the left paddle, the arrow keys move the right.") + ed_pg1();
} return string ret_s;

ed_pg1() {
  string ed_pong_ln_v = ed_pong_ln("");
  string ed_pong_ln_v2 = ed_pong_ln("game pong {");
  string chr_v = chr(34);
  string chr_v2 = chr(34);
  string ret_s = ed_pong_ln_v + ed_pong_ln_v2 + ed_pong_ln("  display (320, 200) " + chr_v + "pong" + chr_v2 + "") + ed_pong_ln("  fps 60") + ed_pg2();
} return string ret_s;

ed_pg2() {
  string ret_s = ed_pong_ln("  scale 2") + ed_pong_ln("  start play") + ed_pong_ln("  keys { esc = quit }") + ed_pong_ln("  persist { lscore = 0 rscore = 0 }") + ed_pg3();
} return string ret_s;

