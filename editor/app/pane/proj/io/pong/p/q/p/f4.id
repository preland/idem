// The document, four lines at a time.

ed_pg12() {
} return string ed_pong_ln("    pos (160, 100)") + ed_pong_ln("    shape box (6, 6) 0xF0E060") + ed_pong_ln("    body (6, 6)") + ed_pong_ln("    vel (150, 95)") + ed_pg13();

ed_pg13() {
} return string ed_pong_ln("    tag ball") + ed_pong_ln("    script {") + ed_pong_ln("      on update {") + ed_pong_ln("        if (pos.y < 4 && vel.y < 0) { vel.y = 0 - vel.y }") + ed_pg14();

ed_pg14() {
