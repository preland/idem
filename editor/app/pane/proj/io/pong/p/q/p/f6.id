// The scoreboard, as a define -- two numbers each taking half the width.

ed_pg18() {
  string ret_s = ed_pong_ln("define Scores() {") + ed_pong_ln("  Row()[100, 100, top-center] {") + ed_pong_ln("    Text(@game.lscore)[100, 50, top-center]{}") + ed_pg19();
} return string ret_s;

ed_pg19() {
  string ret_s = ed_pong_ln("    Text(@game.rscore)[100, 50, top-center]{}") + ed_pong_ln("  }") + ed_pong_ln("}");
} return string ret_s;
