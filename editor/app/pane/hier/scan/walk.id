given ed_t_boot given ed_t_boot_proj stdin "" (1):() then calls ed_item:[0]

ed_item(int i) {
  push((import ed_kd), (import lex_text)[i]);
  push((import ed_nm), (import lex_text)[i + 1]);
  ed_item2(i);
} return void;
