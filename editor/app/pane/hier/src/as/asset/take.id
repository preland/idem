// One line, kept only if it is an asset marker.

ed_as_take(string src, int i, int e) {
  if (str_eqat(src, i, "#asset ") = 1) {
    string str_slice_v = str_slice(src, i + 7, e - i - 7);
    push((import ed_as), str_slice_v);
  }
} return void;
given ed_t_boot stdin "" ("#asset a.png", 0, 12):() then calls str_slice:("#asset a.png", 7, 5)
given ed_t_boot stdin "" ("hello world", 0, 11):() then calls str_slice:[0]

// The first .blend in the project, loaded at boot so the scene view has something
// real in it.
//
// bl_scene: every mesh *object*, each placed through its own world matrix. A room
// is fifty placed objects over a couple of dozen meshes -- the ceiling lights are
// one mesh put in twenty places -- so loading meshes rather than objects shows the
// room with its furniture stacked at the origin.
ed_load_as(int i) {
  while (i < len((import ed_as)) && bl_ntri() = 0) {
    ed_try_as((import ed_as)[i]);
    i = i + 1;
  }
} return void;
given ed_t_boot stdin "" (0):() then calls ed_try_as:[0]
given ed_t_boot given ed_t_asset stdin "" (0):() then calls ed_try_as:("x.png")

// 6 characters back from the end is where ".blend" starts.
ed_try_as(string path) {
  int len_v = len(path);
  if (str_eqat(path, len_v - 6, ".blend") = 1) {
    int bl_scene_v = bl_scene(path);
    ed_fit_mesh(bl_scene_v);
  }
} return void;
given ed_t_boot stdin "" ("x.png"):() then calls bl_scene:[0]
given ed_t_boot stdin "" ("m.blend"):() then calls bl_scene:("m.blend")
