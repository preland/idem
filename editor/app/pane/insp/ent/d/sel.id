// Counting the selection, finding its first member, and one tag's name.

ed_nsel(int e, int n) {
  while (e < ent_n()) {
    n = n + (ent_at(e, 23) & 1);
    e = e + 1;
  }
} return int n;
given ed_t_boot stdin "" (0, 0):(0)
given ed_t_boot given ed_t_ent_sel stdin "" (0, 0):(1)

// The lowest selected id. A band picks many and the inspector shows one, which is
// what every editor does; the count beside it says how many more there are.
ed_first(int e) {
  int at = 0 - 1;
  while (e < ent_n()) {
    int ent_at_v = ent_at(e, 23);
    at = lst_pick(at, e, ent_at_v & 1);
    e = e + 1;
  }
} return int at;
given ed_t_boot given ed_t_ent stdin "" (0):(-1)
given ed_t_boot given ed_t_ent_sel stdin "" (0):(0)

ed_tag1(int e, int i) {
  string s = "";
  if (ent_at(e, 20) / fx_pow(2, i) % 2 = 1) { s = (import scr_tn)[i] + " "; }
} return string s;
given ed_t_boot given ed_t_ent stdin "" (0, 0):("")
given ed_t_boot given ed_t_ent_tag0 stdin "" (0, 0):("alpha ")
