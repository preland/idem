// The note at the foot of the inspector, and the project browser.
//
// The note says what the inspector cannot show yet and why, in the pane itself
// rather than only in a document. An editor that silently lacks a feature reads
// as broken; one that says which stage is missing reads as unfinished, which is
// what it is.

ed_insp_note(int x, int y, int w) {
  d2_hline(x + 4 * txt_ui(), y, w - 8 * txt_ui(), ed_col(3));
  txt_draw("components need the", x + 6 * txt_ui(), y + 6 * txt_ui(), ed_col(5));
  txt_draw("declaration parser", x + 6 * txt_ui(), y + ed_rowh() + 6 * txt_ui(), ed_col(5));
} return void;

ed_proj(int x, int y, int w, int h) {
  ed_pane(x, y, w, h, "Project");
  ed_proj_rows(x, y + ed_hdr() + 3, w, h);
} return void;

// The files the `#file` markers named, one per column of the browser -- the same
// left-to-right strip of items every project browser has, without the icons the
// engine has no art for.
ed_proj_rows(int x, int y, int w, int h) {
  int i = 0;
  while (i < len((import ed_dir)) && i < 8) {
    ed_proj_one(x + (6 + i * 78) * txt_ui(), y, i);
    i = i + 1;
  }
} return void;
