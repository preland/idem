ed_insp_note_line(int x, int y, int w) {
  int ui = txt_ui();
  int col = ed_col(3);
  d2_hline(x + 4 * ui, y, w - 8 * ui, col);
} return void;
given ed_t_boot stdin "" (0, 10, 100):() then calls d2_hline:(4, 10, 92, 0x1C1C1C)
given ed_t_boot stdin "" (5, 20, 50):() then calls d2_hline:(9, 20, 42, 0x1C1C1C)
