ed_insp_note_text1(int x, int y) {
  int ui = txt_ui();
  int col = ed_col(5);
  txt_draw("components need the", x + 6 * ui, y + 6 * ui, col);
} return void;
given ed_t_boot stdin "" (0, 10):() then calls txt_draw:("components need the", 6, 16, 0x8A8A8A)
given ed_t_boot stdin "" (5, 20):() then calls txt_draw:("components need the", 11, 26, 0x8A8A8A)

ed_insp_note_text2(int x, int y, int h) {
  int ui = txt_ui();
  int col = ed_col(5);
  txt_draw("declaration parser", x + 6 * ui, y + h + 6 * ui, col);
} return void;
given ed_t_boot stdin "" (0, 10, 18):() then calls txt_draw:("declaration parser", 6, 34, 0x8A8A8A)
given ed_t_boot stdin "" (5, 20, 20):() then calls txt_draw:("declaration parser", 11, 46, 0x8A8A8A)

ed_insp_note_texts(int x, int y) {
  ed_insp_note_text1(x, y);
  int h = ed_rowh();
  ed_insp_note_text2(x, y, h);
} return void;
given ed_t_boot stdin "" (0, 10):() then calls ed_insp_note_text1:(0, 10)
given ed_t_boot stdin "" (0, 10):() then calls ed_insp_note_text2:(0, 10, 18)
