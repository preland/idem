ed_insp_ent_rows_sel(int x, int y, int h) {
  int nsel = ed_nsel(0, 0);
  ed_kvn(x, y + h + 2, "selected", nsel);
} return void;
given ed_t_boot stdin "" (0, 10, 20):() then calls ed_kvn:(0, 32, "selected", 0)
given ed_t_boot given ed_t_ent_sel stdin "" (0, 10, 20):() then calls ed_kvn:(0, 32, "selected", 1)

ed_insp_ent_rows(int x, int y, int w, int e) {
  ed_kvn(x, y, "entity", e);
  int h = ed_rowh();
  ed_insp_ent_rows_sel(x, y, h);
} return void;
given ed_t_boot stdin "" (0, 10, 100, 0):() then calls ed_kvn:(0, 10, "entity", 0)
given ed_t_boot stdin "" (0, 10, 100, 0):() then calls ed_insp_ent_rows_sel:(0, 10, 18)

ed_insp_ent(int x, int y, int w, int e) {
  ed_insp_ent_rows(x, y, w, e);
  int h = ed_rowh();
  ed_insp_pos(x, y + 2 * (h + 2), w, e);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0):() then calls ed_insp_ent_rows:(0, 10, 100, 0)
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0):() then calls ed_insp_pos:(0, 50, 100, 0)
