ed_insp_tag_draw(int x, int y, int w) {
  int h = ed_rowh();
  int ui = txt_ui();
  ed_insp_tag_draw_line(x, y, w, h, ui);
} return void;
given ed_t_boot stdin "" (0, 10, 100):() then calls ed_insp_tag_draw_line:(0, 10, 100, 18, 1)
given ed_t_boot stdin "" (5, 20, 50):() then calls ed_insp_tag_draw_line:(5, 20, 50, 18, 1)

ed_insp_tag(int x, int y, int w, int e) {
  int ent_at_v = ent_at(e, 8);
  ed_kvn(x, y, "layer", ent_at_v);
  ed_insp_tag_rows(x, y, w, e);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0):() then calls ed_kvn:(0, 10, "layer", 0)
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0):() then calls ed_insp_tag_rows:(0, 10, 100, 0)
