// The tag names an entity's bitset actually stands for, joined. The registry is
// the interpreter's, so this is the same list `on hit deadly` matches against --
// not a second copy that could disagree with it.
ed_tags(int e, int i, string s) {
  while (i < len((import scr_tn))) {
    s = s + ed_tag1(e, i);
    i = i + 1;
  }
} return string s;
given ed_t_boot given ed_t_ent stdin "" (0, 0, ""):("")
given ed_t_boot given ed_t_ent_tag0 stdin "" (0, 0, ""):("alpha ")
given ed_t_boot given ed_t_ent_sel2tags stdin "" (0, 0, ""):("alpha beta ")

// One entity with tag bits 0, 1 AND 2 set (component 20 = 7) over two scr_tn
// names -- bit 2 has no name to match (len(scr_tn) = 2), so a loop that ran one
// iteration too many would read scr_tn[2] out of bounds and trap; and since e
// stays 0 while i climbs to 1, a swapped ed_tag1(i, e) call reads entity 1,
// which does not exist, and traps too. Either mutation is now observable.
ed_t_ent_sel2tags() {
  ent_add();
  ent_put(0, 20, 7);
  push((import scr_tn), "alpha");
} chain () {
  push((import scr_tn), "beta");
} return void;
