// The rest of an entity's record: what it draws as and what it is tagged.

ed_insp_art(int x, int y, int w, int e) {
  int ent_at_v = ent_at(e, 6);
  ed_kvn(x, y, "sprite", ent_at_v);
  int ed_rowh_v = ed_rowh();
  int ent_at_v2 = ent_at(e, 7);
  ed_kvn(x, y + ed_rowh_v + 2, "frame", ent_at_v2);
  int ed_rowh_v2 = ed_rowh();
  ed_insp_tag(x, y + 2 * (ed_rowh_v2 + 2), w, e);
} return void;

ed_insp_tag(int x, int y, int w, int e) {
  int ent_at_v = ent_at(e, 8);
  ed_kvn(x, y, "layer", ent_at_v);
  int ed_rowh_v = ed_rowh();
  string ed_tags_v = ed_tags(e, 0, "");
  ed_kv(x, y + ed_rowh_v + 2, "tags", ed_tags_v);
  int txt_ui_v = txt_ui();
  int ed_rowh_v2 = ed_rowh();
  int txt_ui_v2 = txt_ui();
  int ed_col_v = ed_col(3);
  d2_hline(x + 4 * txt_ui_v, y + 2 * (ed_rowh_v2 + 2), w - 8 * txt_ui_v2, ed_col_v);
} return void;

// The tag names an entity's bitset actually stands for, joined. The registry is
// the interpreter's, so this is the same list `on hit deadly` matches against --
// not a second copy that could disagree with it.
ed_tags(int e, int i, string s) {
  while (i < len((import scr_tn))) {
    s = s + ed_tag1(e, i);
    i = i + 1;
  }
} return string s;
