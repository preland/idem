// What the pane shows when the document parsed.

ed_insp_sel(int x, int y, int w) {
  if (ed_nsel(0, 0) > 0) {
    ed_insp_ent(x, y, w, ed_first(0));
  } else {
    ed_insp_decl(x, y, w);
  }
} return void;

ed_insp_rows(int x, int y, int w, int i) {
  ed_kv(x, y, "name", (import ed_nm)[i]);
  ed_kv(x, y + ed_rowh() + 2, "kind", (import ed_kd)[i]);
  ed_insp_more(x, y + 2 * (ed_rowh() + 2), w, i);
} return void;
