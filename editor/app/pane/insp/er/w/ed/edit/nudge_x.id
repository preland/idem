ed_kve_nudge_neg(int x, int y, int w, int e, int k) {
  int hdr = ed_hdr();
  int ui = txt_ui();
  ed_nudge(x + w - 2 * hdr - 6 * ui, y, e, k, 0 - 1000);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0, 0):() then calls ed_nudge:(52, 10, 0, 0, -1000)
given ed_t_boot given ed_t_ent stdin "" (5, 20, 50, 0, 1):() then calls ed_nudge:(7, 20, 0, 1, -1000)

ed_kve_nudge_pos(int x, int y, int w, int e, int k) {
  int hdr = ed_hdr();
  int ui = txt_ui();
  ed_nudge(x + w - hdr - 3 * ui, y, e, k, 1000);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0, 0):() then calls ed_nudge:(76, 10, 0, 0, 1000)
given ed_t_boot given ed_t_ent stdin "" (5, 20, 50, 0, 1):() then calls ed_nudge:(31, 20, 0, 1, 1000)
