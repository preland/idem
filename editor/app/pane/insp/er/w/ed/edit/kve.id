ed_kve_nudge(int x, int y, int w, int e, int k) {
  ed_kve_nudge_neg(x, y, w, e, k);
  ed_kve_nudge_pos(x, y, w, e, k);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0, 0):() then calls ed_kve_nudge_neg:(0, 10, 100, 0, 0)
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, 0, 0):() then calls ed_kve_nudge_pos:(0, 10, 100, 0, 0)

ed_kve(int x, int y, int w, string s, int e, int k) {
  int ent_at_v = ent_at(e, k);
  ed_kvn(x, y, s, ent_at_v / 1000);
  ed_kve_nudge(x, y, w, e, k);
} return void;
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, "pos x", 0, 0):() then calls ed_kvn:(0, 10, "pos x", 0)
given ed_t_boot given ed_t_ent stdin "" (0, 10, 100, "pos x", 0, 0):() then calls ed_kve_nudge:(0, 10, 100, 0, 0)
