// Selecting the file in the project browser is the whole action. There is no
// code pane to jump into yet -- that is phase 2 of docs/EDITOR_PLAN.md -- and
// when there is, this is where the line number it scrolls to comes from.
ed_err_hit(int x, int y, int w, int i, int ok) {
  if (ok * inp_mhit(1) = 1) {
    int ed_dirfind_v = ed_dirfind((import err_fs)[i], 0);
    lset((import ed_st), 1, ed_dirfind_v);
  }
  ed_err_bg(x, y, w, ok);
} return void;
given ed_t_boot given idstd_err_t_one stdin "" (0, 10, 100, 0, 1):() then calls ed_err_bg:(0, 10, 100, 1)
given ed_t_boot given idstd_err_t_one given inp_t_state stdin "" (0, 10, 100, 0, 1):() then calls ed_dirfind:("t.id", 0)

ed_err_bg(int x, int y, int w, int ok) {
  if (ok = 1) {
    int ed_rowh_v = ed_rowh();
    int ed_col_v = ed_col(7);
    sf_rect(x, y, w, ed_rowh_v * 2, ed_col_v);
  }
} return void;
given ed_t_boot stdin "" (0, 10, 100, 1):() then calls sf_rect:(0, 10, 100, 36, 0x4A4A4A)
given ed_t_boot stdin "" (0, 10, 100, 0):() then calls sf_rect:[0]
