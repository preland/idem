ed_insp_err_header_draw(int x, int y, int nmsg, int ui) {
  int col = ed_col(10);
  txt_draw(nmsg + " diagnostics", x + 6 * ui, y, col);
} return void;
given ed_t_boot stdin "" (0, 10, 0, 1):() then calls txt_draw:("0 diagnostics", 6, 10, 0x9B4A4A)
given ed_t_boot stdin "" (5, 20, 3, 2):() then calls txt_draw:("3 diagnostics", 17, 20, 0x9B4A4A)

ed_insp_err_header(int x, int y) {
  int nmsg = err_nmsg();
  int ui = txt_ui();
  ed_insp_err_header_draw(x, y, nmsg, ui);
} return void;
given ed_t_boot stdin "" (0, 10):() then calls ed_insp_err_header_draw:(0, 10, 0, 1)
given ed_t_boot given idstd_err_t_one stdin "" (0, 10):() then calls ed_insp_err_header_draw:(0, 10, 1, 1)

ed_insp_err(int x, int y, int w, int i) {
  ed_insp_err_header(x, y);
  int h = ed_rowh();
  ed_err_rows(x, y + h + 2, w, i);
} return void;
given ed_t_boot stdin "" (0, 10, 100, 0):() then calls ed_insp_err_header:(0, 10)
given ed_t_boot stdin "" (0, 10, 100, 0):() then calls ed_err_rows:(0, 30, 100, 0)
