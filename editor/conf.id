// The editor is a program that uses the engine, exactly the way a game does: the
// whole engine as source, and idstd's native window/input seam. Nothing here is
// privileged -- the editor draws with the same rasteriser, reads input through
// the same key state, and lexes idml with the same lexer a packed game does.
//
// That is the point. An editor built on a private code path is an editor that
// shows you something the game will not do.
import "../engine"

// The editor's own layout, as idml source (ui/wid/lay/src.id joins the parts):
// the menu bar and everything under it, then the status bar.
string ed_src2 = "MenuBar()[5.25, 100, top-left] { Fill(0x323232)[100, 100, top-left]{} } Col()[89.5, 100, top-left] { ToolBar()[5.72, 100, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } Col()[94.28, 100, top-left] { Row()[87.43, 100, top-left] { Hierarchy()[100, 20, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } SceneView()[100, 56.25, top-left] { Fill(0x393939)[100, 100, top-left]{} } Inspector()[100, 23.75, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } } Project()[12.57, 100, top-left] { Fill(0x3C3C3C)[100, 100, top-left]{} } } }";
string ed_src3 = "StatusBar()[5.25, 100, top-left] { Fill(0x323232)[100, 100, top-left]{} }";

// The File > New pong document, one element per line (newline excluded);
// ed_pong (app/pane/proj/io/pong/template.id) joins them.
string[] ed_pong_lines = [  "",   "# pong -- created by the idem editor's File > New.",   "#",   "# Two paddles, a ball, and no art: every visible thing is a `shape box`.",   "# w/s move the left paddle, the arrow keys move the right.",   "",   "game pong {",   "  display (320, 200) \"pong\"",   "  fps 60",   "  scale 2",   "  start play",   "  keys { esc = quit }",   "  persist { lscore = 0 rscore = 0 }",   "}",   "",   "scene play {",   "  clear 0x101820",   "",   "  entity left {",   "    pos (14, 100)",   "    shape box (6, 40) 0xF0F0F0",   "    body (6, 40)",   "    solid",   "    tag paddle",   "    script {",   "      on update {",   "        vel.y = 0",   "        if (key(119) = 1 && pos.y > 22) { vel.y = 0 - 260 }",   "        if (key(115) = 1 && pos.y < 178) { vel.y = 260 }",   "      }",   "    }",   "  }",   "",   "  entity right {",   "    pos (306, 100)",   "    shape box (6, 40) 0xF0F0F0",   "    body (6, 40)",   "    solid",   "    tag paddle",   "    script {",   "      on update {",   "        vel.y = 0",   "        if (key(258) = 1 && pos.y > 22) { vel.y = 0 - 260 }",   "        if (key(259) = 1 && pos.y < 178) { vel.y = 260 }",   "      }",   "    }",   "  }",   "",   "  entity ball {",   "    pos (160, 100)",   "    shape box (6, 6) 0xF0E060",   "    body (6, 6)",   "    vel (150, 95)",   "    tag ball",   "    script {",   "      on update {",   "        if (pos.y < 4 && vel.y < 0) { vel.y = 0 - vel.y }",   "        if (pos.y > 196 && vel.y > 0) { vel.y = 0 - vel.y }",   "        if (pos.x < 2) { game.rscore = game.rscore + 1  pos.x = 160  pos.y = 100 }",   "        if (pos.x > 318) { game.lscore = game.lscore + 1  pos.x = 160  pos.y = 100 }",   "      }",   "      on hit paddle { if ((pos.x < 160) = (vel.x < 0)) { vel.x = 0 - vel.x } }",   "    }",   "  }",   "",   "  ui {",   "    Col()[100, 100, top-center] {",   "      Scores()[12, 100, top-center]{}",   "      Spacer()[88, 100, center]{}",   "    }",   "  }",   "}",   "",   "define Scores() {",   "  Row()[100, 100, top-center] {",   "    Text(@game.lscore)[100, 50, top-center]{}",   "    Text(@game.rscore)[100, 50, top-center]{}",   "  }",   "}"];
